---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import ExpertiseGallery from '@/components/ExpertiseGallery.astro';
import BridgeDivider from '@/components/BridgeDivider.astro';
import BeforeAfterSlider from '@/components/BeforeAfterSlider.astro';
import ConversionStrip from '@/components/ConversionStrip.astro';
import FAQ from '@/components/FAQ.astro';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';
import { getPublicResponsiveImage } from '@/lib/publicImages';
import { pickGalleryItems } from '@/data/gallery';

// Homepage hero images
const heroItems = pickGalleryItems('home-hero', 2);
const heroPrimary = heroItems[0];
const heroSecondary = heroItems[1] ?? heroPrimary;

const heroImage = heroPrimary
  ? getPublicResponsiveImage(heroPrimary.src, import.meta.env.BASE_URL, { sizes: '100vw' })
  : { src: '', srcSet: undefined, sizes: '100vw' };

const heroImageMobile = heroSecondary
  ? getPublicResponsiveImage(heroSecondary.src, import.meta.env.BASE_URL, { sizes: '100vw' })
  : heroImage;

const faqs = await getCollection('faqs');

const siteUrl = Astro.site?.toString() ?? 'https://officeprovisionz.com';
---

<BaseLayout>
  <Header slot="header" transparent={true} />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Office Provisionz',
        url: siteUrl,
        logo: new URL('/brand/logo.png', siteUrl).toString(),
        contactPoint: {
          '@type': 'ContactPoint',
          telephone: '+1-510-913-2197',
          contactType: 'Customer Service',
          email: 'officeprovisionz@gmail.com',
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.data.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: f.data.answer,
          },
        })),
      },
    ])}
  />
  <Hero
    imageSrc={heroImage.src}
    imageSrcSet={heroImage.srcSet}
    imageSizes={heroImage.sizes}
    imageSrcMobile={heroImageMobile.src}
    imageSrcSetMobile={heroImageMobile.srcSet}
    imageSizesMobile={heroImageMobile.sizes}
    imagePosition="50% 45%"
  />

  <BridgeDivider />

  <ExpertiseGallery />

  <section class="section section-creative" id="before-after">
    <div class="container-page">
      <div class="mb-10 text-center">
        <p class="eyebrow">Before / After</p>
        <h2 class="heading-2">See the difference good process makes</h2>
        <p class="lede mx-auto">
          Drag the divider to compare. Swap in true before/after pairs anytime—this component is
          ready.
        </p>
      </div>

      <div class="mx-auto max-w-4xl">
        <BeforeAfterSlider
          beforeSrc={heroPrimary?.src ?? heroSecondary?.src ?? 'gallery/01.jpg'}
          afterSrc={heroPrimary?.src ?? heroSecondary?.src ?? 'gallery/01.jpg'}
          alt="Commercial workspace cleaned and client-ready"
          beforeLabel="Before"
          afterLabel="After"
          initial={56}
          autoPlay={true}
        />
      </div>
    </div>
  </section>

  <ConversionStrip
    tone="surface"
    eyebrow="Next step"
    heading="Request a quote"
    description="Send your space basics and priorities. We'll confirm scope + access details and reply with a clear, written quote."
    showChecklist={true}
    showEmail={false}
  />

  <FAQ />

  <Footer slot="footer" />
</BaseLayout>
