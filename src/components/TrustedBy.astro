---
const logos = [
  'SoMa Tech Suites',
  'Bayview Dental',
  'Mission Realty',
  'North Beach Studios',
  'Financial District Law',
  'Embarcadero Labs',
];
---

<section class="trusted-section section-muted">
  <div class="container-page">
    <p class="trusted-section__label">Trusted by local teams across San Francisco</p>
  </div>

  <div class="trusted-strip">
    <div class="trusted-strip__fade trusted-strip__fade--left" aria-hidden="true"></div>
    <div class="trusted-strip__fade trusted-strip__fade--right" aria-hidden="true"></div>
    <div class="trusted-strip__track" aria-hidden="true">
      {logos.concat(logos).map((logo) => <span class="trusted-strip__logo">{logo}</span>)}
    </div>
  </div>
</section>

<style>
  .trusted-section {
    padding-block: 2rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .trusted-section {
      padding-block: 2.5rem;
    }
  }

  .trusted-section__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-text-muted) / 0.7);
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .trusted-strip {
    position: relative;
    overflow: hidden;
  }

  /* Edge fade masks */
  .trusted-strip__fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(3rem, 10vw, 7rem);
    z-index: 2;
    pointer-events: none;
  }

  .trusted-strip__fade--left {
    left: 0;
    background: linear-gradient(to right, rgb(var(--color-surface-muted)), transparent);
  }

  .trusted-strip__fade--right {
    right: 0;
    background: linear-gradient(to left, rgb(var(--color-surface-muted)), transparent);
  }

  .trusted-strip__track {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    width: max-content;
    padding-block: 0.5rem;
    animation: trustedMarquee 28s linear infinite;
    will-change: transform;
  }

  .trusted-strip__logo {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.125rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--color-border) / 0.6);
    background: rgb(var(--color-surface) / 0.8);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgb(var(--color-text-muted));
    white-space: nowrap;
    letter-spacing: 0.01em;
    backdrop-filter: blur(4px);
    box-shadow:
      0 1px 3px rgb(0 0 0 / 0.06),
      0 0 0 1px rgb(255 255 255 / 0.05) inset;
    transition:
      border-color 200ms,
      color 200ms;
  }

  @keyframes trustedMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trusted-strip__track {
      animation: none;
    }
  }
</style>
