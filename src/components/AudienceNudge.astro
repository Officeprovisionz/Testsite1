---
/**
 * AudienceNudge
 * Non-AI personalization: lets visitors self-select what they manage.
 * Stored in localStorage + reflected on <html data-audience="...">.
 * Hidden under WebDriver (visual regression stability).
 */

type Audience = 'office' | 'medical' | 'retail';

type Props = {
  class?: string;
};

const { class: className } = Astro.props as Props;

const options: { id: Audience; label: string; hint: string }[] = [
  { id: 'office', label: 'Office', hint: 'Teams, meeting rooms, restrooms' },
  { id: 'medical', label: 'Medical', hint: 'Suites, compliance, high-touch' },
  { id: 'retail', label: 'Retail', hint: 'Front-of-house polish, traffic' },
];
---

<div class:list={['audience-nudge', className]} data-audience-nudge>
  <p class="audience-nudge__label">I manage:</p>

  <div class="audience-nudge__chips" role="group" aria-label="Select your space type">
    {
      options.map((o) => (
        <button
          type="button"
          class="audience-chip"
          data-audience-chip
          data-audience={o.id}
          data-haptic="true"
        >
          <span class="audience-chip__title">{o.label}</span>
          <span class="audience-chip__hint">{o.hint}</span>
        </button>
      ))
    }
  </div>

  <p class="audience-nudge__micro" data-audience-micro>
    Pick one and we’ll tailor the language (no forms, no tracking creep).
  </p>
</div>

<script is:inline>
  (function initAudienceNudge() {
    const doc = document.documentElement;
    const isWebDriver = doc?.dataset?.webdriver === 'true';
    const root = document.querySelector('[data-audience-nudge]');
    if (!root) return;

    // Keep visual tests deterministic.
    if (isWebDriver) {
      root.setAttribute('hidden', '');
      return;
    }

    const KEY = 'damra_audience';
    const chips = Array.from(root.querySelectorAll('[data-audience-chip]'));

    const setActive = (audience) => {
      chips.forEach((btn) => {
        const a = btn.getAttribute('data-audience');
        const on = a === audience;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (audience) doc.dataset.audience = audience;
      else delete doc.dataset.audience;
    };

    const saved = (() => {
      try {
        return window.localStorage.getItem(KEY) || '';
      } catch {
        return '';
      }
    })();

    if (saved) setActive(saved);

    chips.forEach((btn) => {
      btn.addEventListener('click', () => {
        const audience = btn.getAttribute('data-audience') || '';
        try {
          window.localStorage.setItem(KEY, audience);
        } catch {
          // ignore
        }
        setActive(audience);
      });
    });
  })();
</script>

<style>
  .audience-nudge {
    margin-top: 1.25rem;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }

  .audience-nudge__label {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .audience-nudge__chips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    width: min(100%, 38rem);
  }

  .audience-chip {
    text-align: left;
    padding: 0.75rem 0.85rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.06));
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.94);
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 220ms cubic-bezier(0.4, 0, 0.2, 1),
      background 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .audience-chip__title {
    display: block;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .audience-chip__hint {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.78);
  }

  @media (hover: hover) and (pointer: fine) {
    .audience-chip:hover {
      transform: translateY(-3px);
      border-color: rgba(255, 255, 255, 0.22);
    }
  }

  .audience-chip.is-active {
    border-color: rgb(var(--color-accent) / 0.5);
    background: linear-gradient(135deg, rgb(var(--color-accent) / 0.18), rgba(255, 255, 255, 0.08));
  }

  .audience-nudge__micro {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.72);
    text-align: center;
    max-width: 38rem;
  }

  @media (max-width: 640px) {
    .audience-nudge__chips {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .audience-chip {
      transition: none;
    }
  }

  :global(html[data-webdriver='true']) .audience-nudge {
    display: none !important;
  }
</style>
