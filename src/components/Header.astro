---
import { siteConfig } from '@/data/siteConfig';
import { makeHref, makeIsActive } from '@/lib/nav';
import { makeTelHref } from '@/lib/links';

type Props = {
  transparent?: boolean;
};

const { transparent = false } = Astro.props as Props;

const telHref = makeTelHref(siteConfig.contact.phoneE164);

const base = import.meta.env.BASE_URL;
const href = makeHref(base);
const isActive = makeIsActive(Astro.url.pathname, base);
const logoOrbSrc = `${base}brand/logo-orb.svg`;

const navItems = [
  { label: 'Services', href: href('services/') },
  { label: 'About', href: href('about/') },
  { label: 'Contact', href: href('contact/') },
];
---

<header
  class:list={[
    'app-bar border-app sticky top-0 z-40 border-b transition-all duration-300',
    transparent ? 'header-transparent' : '',
  ]}
  data-site-header
>
  <div class="header-inner container-page flex items-center justify-between gap-4">
    <!-- Logo -->
    <a
      data-track="cta_click"
      data-location="header"
      data-action="home"
      data-label="header_logo"
      href={href('')}
      data-astro-prefetch="tap"
      class="group flex shrink-0 items-center gap-2.5 focus-visible:outline-none"
      aria-label={`Go to ${siteConfig.brand.name} homepage`}
    >
      <img
        src={logoOrbSrc}
        alt=""
        width="28"
        height="28"
        loading="eager"
        decoding="async"
        class="brand-mark h-7 w-7 transition-transform duration-300 group-hover:scale-105"
      />
      <span
        class:list={[
          'hidden text-[0.9375rem] font-bold tracking-[-0.02em] sm:inline',
          transparent ? 'text-white drop-shadow-sm' : 'text-strong',
        ]}
      >
        {siteConfig.brand.name}
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden flex-1 items-center justify-center gap-0.5 md:flex" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-astro-prefetch
            class:list={[
              'nav-link relative rounded-lg px-3.5 py-2 text-[0.875rem] font-medium transition-all duration-200 focus-visible:ring-2 focus-visible:ring-[rgb(var(--color-brand))] focus-visible:ring-offset-2 focus-visible:outline-none',
              transparent
                ? 'text-white/85 hover:bg-white/10 hover:text-white'
                : [
                    'hover:text-brand hover:bg-[rgb(var(--color-brand)/0.06)]',
                    isActive(item.href)
                      ? 'text-brand bg-[rgb(var(--color-brand)/0.06)]'
                      : 'text-muted',
                  ],
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
            {!transparent && isActive(item.href) && (
              <span
                aria-hidden="true"
                class="bg-brand absolute inset-x-3 -bottom-px h-px rounded-full opacity-70"
              />
            )}
          </a>
        ))
      }
    </nav>

    <!-- Right actions -->
    <div class="flex shrink-0 items-center gap-2">
      <a
        class="btn-primary px-3 text-xs sm:px-5 sm:text-sm"
        href={telHref}
        aria-label={`Call ${siteConfig.contact.phoneDisplay}`}
        data-track="cta_click"
        data-location="header"
        data-action="call"
        data-label="header_call"
      >
        <svg
          class="h-3.5 w-3.5 shrink-0 opacity-70 sm:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 8.81 19.79 19.79 0 01.11 2.18 2 2 0 012.11 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
          ></path>
        </svg>
        <span class="sm:hidden">Call</span>
        <span class="hidden sm:inline">Call {siteConfig.contact.phoneDisplay}</span>
      </a>

      <a
        class:list={[
          'btn-secondary hidden text-sm sm:inline-flex',
          transparent
            ? 'border-white/20 bg-white/8 text-white hover:border-white/30 hover:bg-white/14 hover:text-white'
            : '',
        ]}
        href={href('contact/')}
        data-track="cta_click"
        data-location="header"
        data-action="quote"
        data-label="header_quote"
      >
        Get a quote
      </a>

      <!-- Mobile hamburger -->
      <details class="relative md:hidden" data-mobile-menu>
        <summary
          class:list={[
            'icon-btn cursor-pointer list-none',
            transparent ? 'border-white/20 text-white hover:bg-white/10' : '',
          ]}
          aria-label="Open menu"
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
          data-menu-summary
        >
          <span class="sr-only">Open menu</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            class="h-[1.1rem] w-[1.1rem]"
            aria-hidden="true"
          >
            <path d="M4 7h16"></path>
            <path d="M4 12h12"></path>
            <path d="M4 17h8"></path>
          </svg>
        </summary>

        <button type="button" class="mobile-menu-overlay" aria-label="Close menu" data-menu-close
        ></button>

        <div
          class="mobile-menu-panel border-l border-white/10"
          id="mobile-menu-panel"
          role="dialog"
          aria-label="Menu"
          aria-modal="true"
        >
          <!-- Panel header -->
          <div
            class="flex items-center justify-between gap-3 border-b border-[rgb(var(--color-border)/0.5)] px-4 py-3.5"
          >
            <div class="flex items-center gap-2.5">
              <img src={logoOrbSrc} alt="" width="22" height="22" class="h-5.5 w-5.5 opacity-85" />
              <p class="text-strong text-[0.8125rem] font-semibold tracking-tight">
                {siteConfig.brand.name}
              </p>
            </div>
            <button
              type="button"
              class="icon-btn h-8 min-h-0 w-8 min-w-0 rounded-lg"
              aria-label="Close menu"
              data-menu-close
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path d="M18 6L6 18"></path>
                <path d="M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Nav links -->
          <nav class="grid gap-0.5 p-3" aria-label="Mobile">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  data-astro-prefetch="tap"
                  class:list={[
                    'tap-target flex items-center justify-between rounded-xl px-3.5 py-3 text-[0.9375rem] font-medium transition-colors duration-200',
                    isActive(item.href)
                      ? 'bg-brand/8 text-brand'
                      : 'text-muted hover:text-strong hover:bg-[rgb(var(--color-surface-muted))]',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  data-haptic="true"
                >
                  {item.label}
                  {isActive(item.href) && (
                    <span aria-hidden="true" class="bg-brand h-1.5 w-1.5 rounded-full opacity-70" />
                  )}
                </a>
              ))
            }
          </nav>

          <!-- CTA row -->
          <div class="border-t border-[rgb(var(--color-border)/0.5)] p-3">
            <a
              href={telHref}
              class="btn-primary w-full"
              data-track="cta_click"
              data-location="mobile_menu"
              data-action="call"
            >
              Call {siteConfig.contact.phoneDisplay}
            </a>
            <a
              href={href('contact/')}
              class="btn-secondary mt-2 w-full"
              data-track="cta_click"
              data-location="mobile_menu"
              data-action="quote"
            >
              Request a quote
            </a>
          </div>

          <!-- Footer row: theme / mode toggles -->
          <div
            class="grid grid-cols-2 gap-2 border-t border-[rgb(var(--color-border)/0.4)] p-3 pb-4"
          >
            <button
              type="button"
              class="tap-target text-subtle flex items-center justify-center gap-2 rounded-xl bg-[rgb(var(--color-surface-muted)/0.6)] px-3 py-2.5 text-xs font-medium transition-colors hover:bg-[rgb(var(--color-surface-muted))]"
              data-theme-toggle
              aria-label="Change theme"
              data-haptic="true"
            >
              Theme
            </button>
            <button
              type="button"
              class="tap-target text-subtle flex items-center justify-center gap-2 rounded-xl bg-[rgb(var(--color-surface-muted)/0.6)] px-3 py-2.5 text-xs font-medium transition-colors hover:bg-[rgb(var(--color-surface-muted))]"
              data-mode-toggle
              aria-label="Change color mode"
              data-haptic="true"
            >
              Mode
            </button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  (() => {
    const menu = document.querySelector('details[data-mobile-menu]') as HTMLDetailsElement | null;
    if (!menu) return;
    if (menu.dataset.menuInit === 'true') return;
    menu.dataset.menuInit = 'true';

    const summary = menu.querySelector('[data-menu-summary]') as HTMLElement | null;
    const panel = menu.querySelector('#mobile-menu-panel') as HTMLElement | null;
    const overlayBtn = menu.querySelector(
      'button.mobile-menu-overlay[data-menu-close]'
    ) as HTMLButtonElement | null;
    const closeBtns = Array.from(
      menu.querySelectorAll<HTMLButtonElement>('button[data-menu-close]')
    );

    let lastFocused: HTMLElement | null = null;
    let locked = false;
    let scrollY = 0;
    const prevBodyStyle = {
      position: document.body.style.position,
      top: document.body.style.top,
      width: document.body.style.width,
    };

    const setExpanded = (open: boolean) => {
      summary?.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    const focusableSelector =
      'a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';

    const togglePanelTabbables = (enable: boolean) => {
      if (!panel) return;
      const nodes = Array.from(panel.querySelectorAll<HTMLElement>(focusableSelector));
      const sentinel = '__unset__';

      nodes.forEach((el) => {
        if (enable) {
          const prev = el.dataset.prevTabindex;
          if (prev === undefined) return;
          if (prev === sentinel) {
            el.removeAttribute('tabindex');
          } else {
            el.setAttribute('tabindex', prev);
          }
          delete el.dataset.prevTabindex;
          return;
        }
        if (el.dataset.prevTabindex !== undefined) return;
        el.dataset.prevTabindex = el.getAttribute('tabindex') ?? sentinel;
        el.setAttribute('tabindex', '-1');
      });
    };

    const setDialogA11y = (open: boolean) => {
      if (!panel) return;
      if (open) {
        panel.removeAttribute('aria-hidden');
        panel.removeAttribute('inert');
        togglePanelTabbables(true);
        return;
      }
      panel.setAttribute('aria-hidden', 'true');
      panel.setAttribute('inert', '');
      togglePanelTabbables(false);
    };

    const resetPanelInlineStyles = () => {
      if (!panel) return;
      panel.style.transition = '';
      panel.style.transform = '';
      panel.style.opacity = '';
    };

    const lockScroll = () => {
      if (locked) return;
      locked = true;
      scrollY = window.scrollY || 0;
      document.documentElement.dataset.scrollLock = 'true';
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
    };

    const unlockScroll = () => {
      if (!locked) return;
      locked = false;
      document.documentElement.dataset.scrollLock = '';
      if (document.documentElement.dataset.scrollLock === '') {
        delete document.documentElement.dataset.scrollLock;
      }
      document.body.style.position = prevBodyStyle.position;
      document.body.style.top = prevBodyStyle.top;
      document.body.style.width = prevBodyStyle.width;
      window.scrollTo(0, scrollY);
    };

    const getFocusables = () => {
      if (!panel) return [] as HTMLElement[];
      const nodes = Array.from(panel.querySelectorAll<HTMLElement>(focusableSelector));
      return nodes.filter((el) => el.offsetParent !== null || el.getClientRects().length > 0);
    };

    const close = () => {
      menu.open = false;
    };
    overlayBtn?.addEventListener('click', close);
    closeBtns.forEach((b) => b.addEventListener('click', close));

    const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a[href]'));
    links.forEach((a) => a.addEventListener('click', close));

    menu.addEventListener('toggle', () => {
      setExpanded(menu.open);
      setDialogA11y(menu.open);

      if (menu.open) {
        lastFocused = (document.activeElement as HTMLElement | null) ?? summary;
        lockScroll();
        const focusables = getFocusables();
        (focusables[0] ?? overlayBtn ?? summary)?.focus();
      } else {
        resetPanelInlineStyles();
        unlockScroll();
        (lastFocused ?? summary)?.focus?.();
        lastFocused = null;
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!menu.open) return;
      if (e.key === 'Escape') close();

      if (e.key === 'Tab') {
        const focusables = getFocusables();
        if (!focusables.length) return;

        const first = focusables[0]!;
        const last = focusables[focusables.length - 1]!;
        const active = document.activeElement as HTMLElement | null;

        if (e.shiftKey) {
          if (!active || active === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (active === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });

    const mq = window.matchMedia('(min-width: 768px)');
    const handleMQ = () => {
      if (mq.matches && menu.open) close();
    };
    if ('addEventListener' in mq) {
      mq.addEventListener('change', handleMQ);
    } else {
      const legacy = mq as unknown as {
        addListener?: (callback: (this: MediaQueryList, ev: MediaQueryListEvent) => void) => void;
      };
      legacy.addListener?.(handleMQ);
    }

    setExpanded(menu.open);
    setDialogA11y(menu.open);

    if (panel && typeof window !== 'undefined') {
      let startX = 0;
      let startY = 0;
      let dragging = false;

      const onTouchStart = (e: TouchEvent) => {
        if (!menu.open) return;
        const t = e.touches[0];
        if (!t) return;
        startX = t.clientX;
        startY = t.clientY;
        dragging = false;
        resetPanelInlineStyles();
      };

      const onTouchMove = (e: TouchEvent) => {
        if (!menu.open) return;
        const t = e.touches[0];
        if (!t) return;

        const dx = t.clientX - startX;
        const dy = t.clientY - startY;

        if (dx <= 0) return;
        if (Math.abs(dx) < Math.abs(dy)) return;

        dragging = true;
        panel.style.transition = 'none';

        const w = Math.max(1, panel.getBoundingClientRect().width);
        const clamped = Math.min(dx, w);
        const progress = clamped / w;
        panel.style.transform = `translateX(${clamped}px)`;
        panel.style.opacity = String(Math.max(0.35, 1 - progress * 0.75));

        e.preventDefault();
      };

      const onTouchEnd = () => {
        if (!menu.open) return;
        if (!dragging) return;

        const w = Math.max(1, panel.getBoundingClientRect().width);
        const current = panel.style.transform;
        const m = /translateX\(([-\d.]+)px\)/.exec(current);
        const dx = m ? Number(m[1]) : 0;

        if (dx > Math.min(140, w * 0.35)) {
          panel.style.transition =
            'transform 140ms cubic-bezier(0.4, 0, 0.2, 1), opacity 140ms cubic-bezier(0.4, 0, 0.2, 1)';
          panel.style.transform = `translateX(${w}px)`;
          panel.style.opacity = '0';
          window.setTimeout(() => close(), 120);
        } else {
          panel.style.transition =
            'transform 160ms cubic-bezier(0.4, 0, 0.2, 1), opacity 160ms cubic-bezier(0.4, 0, 0.2, 1)';
          panel.style.transform = 'translateX(0px)';
          panel.style.opacity = '1';
          window.setTimeout(() => resetPanelInlineStyles(), 170);
        }
      };

      panel.addEventListener('touchstart', onTouchStart, { passive: true });
      panel.addEventListener('touchmove', onTouchMove, { passive: false });
      panel.addEventListener('touchend', onTouchEnd, { passive: true });
      panel.addEventListener('touchcancel', onTouchEnd, { passive: true });
    }
  })();
</script>

<script>
  (() => {
    const root = document.documentElement;
    if (root.dataset.headerScrollInit === 'true') return;
    root.dataset.headerScrollInit = 'true';

    const getHeader = () =>
      document.querySelector('header[data-site-header]') as HTMLElement | null;

    let raf = 0;
    let lastY = window.scrollY || 0;
    let lastDir: 'up' | 'down' = 'up';
    let lastCompact: boolean | null = null;

    const COMPACT_AFTER_PX = 96;
    const DIR_DEADBAND_PX = 6;

    const update = () => {
      raf = 0;
      const header = getHeader();
      if (!header) return;

      const y = window.scrollY || 0;
      header.classList.toggle('is-scrolled', y > 8);

      const dy = y - lastY;
      if (Math.abs(dy) > DIR_DEADBAND_PX) {
        lastDir = dy > 0 ? 'down' : 'up';
        lastY = y;
      }

      const allowCompact = !header.matches(':focus-within');
      const shouldCompact = allowCompact && y > COMPACT_AFTER_PX && lastDir === 'down';
      header.classList.toggle('is-compact', shouldCompact);

      if (lastCompact !== shouldCompact) {
        lastCompact = shouldCompact;
        window.requestAnimationFrame(() => {
          const h = Math.ceil(header.getBoundingClientRect().height);
          document.documentElement.style.setProperty('--header-sticky', `${h}px`);
        });
      }
    };

    const onUpdateRequest = () => {
      if (raf) return;
      raf = window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onUpdateRequest, { passive: true });
    window.addEventListener('resize', onUpdateRequest);
    document.addEventListener('astro:page-load', onUpdateRequest);
  })();
</script>

<script>
  (() => {
    const root = document.documentElement;
    if (root.dataset.headerGlassInit === 'true') return;
    root.dataset.headerGlassInit = 'true';

    const prefersReducedMotion = (() => {
      try {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch {
        return false;
      }
    })();

    if (prefersReducedMotion) return;

    const getHeader = () =>
      document.querySelector('header[data-site-header]') as HTMLElement | null;

    const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));

    let raf = 0;
    let targetX = 0.5;
    let targetY = 0.5;

    const apply = () => {
      raf = 0;
      const header = getHeader();
      if (!header) return;

      const isGlass =
        header.classList.contains('app-bar') && !header.classList.contains('header-transparent');
      if (!isGlass) return;

      header.style.setProperty('--glass-tilt-x', String(targetX));
      header.style.setProperty('--glass-tilt-y', String(targetY));
    };

    const schedule = () => {
      if (raf) return;
      raf = window.requestAnimationFrame(apply);
    };

    const onPointerMove = (e: PointerEvent) => {
      const w = window.innerWidth || 1;
      const h = window.innerHeight || 1;
      targetX = clamp(e.clientX / w, 0, 1);
      targetY = clamp(e.clientY / h, 0, 1);
      schedule();
    };

    let lastOriTs = 0;
    const ORI_THROTTLE_MS = 40;

    const onOrientation = (ev: DeviceOrientationEvent) => {
      const now = performance.now();
      if (now - lastOriTs < ORI_THROTTLE_MS) return;
      lastOriTs = now;

      const g = typeof ev.gamma === 'number' ? ev.gamma : 0;
      const b = typeof ev.beta === 'number' ? ev.beta : 0;

      targetX = clamp(g, -30, 30) / 60 + 0.5;
      targetY = clamp(b, -30, 30) / 60 + 0.5;
      schedule();
    };

    const enableOrientation = async () => {
      try {
        const anyDO = DeviceOrientationEvent as unknown as {
          requestPermission?: () => Promise<'granted' | 'denied'>;
        };

        if (typeof anyDO?.requestPermission === 'function') {
          const res = await anyDO.requestPermission();
          if (res !== 'granted') return;
        }

        window.addEventListener('deviceorientation', onOrientation, { passive: true });
      } catch {
        // ignore
      }
    };

    const bind = () => {
      const header = getHeader();
      if (!header) return;

      const finePointer =
        window.matchMedia?.('(hover: hover) and (pointer: fine)')?.matches ?? false;
      if (finePointer && header.dataset.glassPointerInit !== 'true') {
        header.dataset.glassPointerInit = 'true';
        window.addEventListener('pointermove', onPointerMove, { passive: true });
      }

      if (header.dataset.glassOriGestureInit !== 'true') {
        header.dataset.glassOriGestureInit = 'true';

        const onFirstGesture = () => {
          enableOrientation();
          header.removeEventListener('pointerdown', onFirstGesture);
          header.removeEventListener('touchstart', onFirstGesture);
        };

        header.addEventListener('pointerdown', onFirstGesture, { passive: true });
        header.addEventListener('touchstart', onFirstGesture, { passive: true });
      }

      targetX = 0.5;
      targetY = 0.5;
      schedule();
    };

    bind();
    document.addEventListener('astro:page-load', bind);
  })();
</script>

<script>
  (() => {
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mode-toggle]'));
    if (!btns.length) return;

    const modes = ['auto', 'light', 'dark'];

    const getCurrent = () => {
      const current = document.documentElement.dataset.mode;
      return current && modes.includes(current) ? current : 'auto';
    };

    const setMode = (m: string) => {
      document.documentElement.dataset.mode = m;
      try {
        localStorage.setItem('mode', m);
      } catch {
        // ignore
      }

      try {
        window.dispatchEvent(new Event('damra:mode-change'));
      } catch {
        // ignore
      }

      const label = m === 'auto' ? 'Mode: Auto' : `Mode: ${m}`;
      btns.forEach((b) => {
        const isIcon = b.classList.contains('icon-btn');
        if (!isIcon) b.textContent = label;
        b.setAttribute('aria-label', label);
        b.setAttribute('title', label);
      });
    };

    const cycle = () => {
      const current = getCurrent();
      const nextIndex = (modes.indexOf(current) + 1) % modes.length;
      const next = modes[nextIndex] ?? 'auto';
      setMode(next);
    };

    setMode(getCurrent());
    btns.forEach((b) => {
      if (b.dataset.modeToggleInit === 'true') return;
      b.dataset.modeToggleInit = 'true';
      b.addEventListener('click', cycle);
    });
  })();
</script>

<script>
  (() => {
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));
    if (!btns.length) return;

    const themes = ['teal', 'navy', 'emerald', 'slate'];

    const getCurrent = () => {
      const current = document.documentElement.dataset.theme;
      return current && themes.includes(current) ? current : 'teal';
    };

    const prettyName = (t: string) => {
      if (t === 'teal') return 'Theme: Glacier';
      if (t === 'navy') return 'Theme: Midnight';
      if (t === 'emerald') return 'Theme: Verdant';
      if (t === 'slate') return 'Theme: Graphite';
      return `Theme: ${t}`;
    };

    const setTheme = (t: string) => {
      document.documentElement.dataset.theme = t;
      try {
        localStorage.setItem('theme', t);
      } catch {
        // ignore
      }
      const label = prettyName(t);
      btns.forEach((b) => {
        const isIcon = b.classList.contains('icon-btn');
        if (!isIcon) b.textContent = label;
        b.setAttribute('aria-label', label);
        b.setAttribute('title', label);
      });
    };

    const cycle = () => {
      const current = getCurrent();
      const nextIndex = (themes.indexOf(current) + 1) % themes.length;
      const next = themes[nextIndex] ?? 'navy';
      setTheme(next);
    };

    setTheme(getCurrent());
    btns.forEach((b) => {
      if (b.dataset.themeToggleInit === 'true') return;
      b.dataset.themeToggleInit = 'true';
      b.addEventListener('click', cycle);
    });
  })();
</script>

