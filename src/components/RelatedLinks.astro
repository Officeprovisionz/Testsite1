---
import { Icon } from 'astro-icon/components';

type LinkItem = {
  title: string;
  description: string;
  href: string;
};

type Props = {
  heading: string;
  items: LinkItem[];
};

const { heading, items } = Astro.props;
---

<section class="section section-creative border-app border-t">
  <div class="container-page">
    <h2 class="heading-2 mb-8">{heading}</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="card card-hover group relative flex flex-col p-6 transition-all"
          >
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 rounded-[inherit] bg-gradient-to-br from-[rgb(var(--color-brand)/0.14)] via-transparent to-[rgb(var(--color-accent)/0.16)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            />
            <div class="flex items-center justify-between">
              <h3 class="text-strong relative z-10 font-serif text-xl font-semibold transition-colors">
                {item.title}
              </h3>
              <Icon
                name="lucide:arrow-right"
                class="relative z-10 h-5 w-5 text-muted transition-transform group-hover:translate-x-1"
              />
            </div>
            <p class="relative z-10 mt-3 text-sm leading-relaxed text-muted">{item.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
