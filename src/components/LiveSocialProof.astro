---
/**
 * LiveSocialProof
 * Lightweight (non-AI) rotating activity pill to add momentum + reassurance.
 * - Disabled under WebDriver (visual regression stability)
 * - Respects prefers-reduced-motion
 */

type Activity = {
  type: 'quote' | 'walkthrough' | 'review';
  location: string;
  timeAgo: string;
  service?: string;
};

type Props = {
  /** Optional override list (kept small on purpose). */
  activities?: Activity[];
};

const { activities = [] } = Astro.props as Props;

const fallback: Activity[] = [
  {
    type: 'quote',
    location: 'San Francisco',
    timeAgo: 'just now',
    service: 'Office cleaning',
  },
  {
    type: 'walkthrough',
    location: 'SoMa',
    timeAgo: 'today',
    service: 'First-visit walkthrough',
  },
  { type: 'review', location: 'Berkeley', timeAgo: 'this week' },
];

const items = (activities.length ? activities : fallback).slice(0, 6);

const iconFor = (t: Activity['type']) => {
  switch (t) {
    case 'quote':
      return '🗒';
    case 'walkthrough':
      return '👟';
    case 'review':
      return '⭐';
  }
};

const labelFor = (a: Activity) => {
  if (a.type === 'quote') return 'Quote requested';
  // Avoid appointment/scheduling language.
  if (a.type === 'walkthrough') return 'Walkthrough requested';
  return 'New review posted';
};

const detailFor = (a: Activity) => {
  const parts = [a.location, a.service].filter(Boolean);
  return parts.join(' · ');
};
---

<div class="live-proof" data-live-proof aria-live="polite" aria-atomic="true">
  <div class="live-proof__icon" aria-hidden="true"></div>
  <div class="min-w-0">
    <div class="live-proof__title" data-live-proof-title></div>
    <div class="live-proof__meta" data-live-proof-meta></div>
  </div>
  <div class="live-proof__time" data-live-proof-time></div>
</div>

<script is:inline define:vars={{ items, iconFor, labelFor, detailFor }}>
  (function initLiveProof() {
    const root = document.querySelector('[data-live-proof]');
    if (!root) return;

    const doc = document.documentElement;
    const isWebDriver = doc.dataset.webdriver === 'true';

    const reduceMotion = (() => {
      try {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch {
        return false;
      }
    })();

    // Keep visual regression deterministic.
    if (isWebDriver) {
      root.setAttribute('hidden', '');
      return;
    }

    const iconEl = root.querySelector('[data-live-proof] .live-proof__icon');
    const titleEl = root.querySelector('[data-live-proof-title]');
    const metaEl = root.querySelector('[data-live-proof-meta]');
    const timeEl = root.querySelector('[data-live-proof-time]');

    if (!iconEl || !titleEl || !metaEl || !timeEl) return;

    const safeItems = Array.isArray(items) ? items : [];
    if (!safeItems.length) {
      root.setAttribute('hidden', '');
      return;
    }

    let i = 0;

    const render = (idx) => {
      const a = safeItems[idx % safeItems.length];
      iconEl.textContent = iconFor(a.type);
      titleEl.textContent = labelFor(a);
      metaEl.textContent = detailFor(a);
      timeEl.textContent = a.timeAgo;
    };

    render(0);

    if (reduceMotion) return;

    // Gentle rotation (with cleanup so we don't accumulate intervals across navigations).
    /** @type {number | undefined} */
    let intervalId;

    const tick = () => {
      i += 1;
      root.animate(
        [
          { opacity: 0, transform: 'translate3d(0, 8px, 0)' },
          { opacity: 1, transform: 'translate3d(0, 0, 0)' },
        ],
        { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
      );
      render(i);
    };

    const start = () => {
      if (typeof intervalId === 'number') return;
      intervalId = window.setInterval(tick, 5200);
    };

    const stop = () => {
      if (typeof intervalId === 'number') window.clearInterval(intervalId);
      intervalId = undefined;
    };

    const onVisibility = () => {
      if (document.hidden) stop();
      else start();
    };

    const cleanup = () => {
      stop();
      document.removeEventListener('visibilitychange', onVisibility);
    };

    // Use a variable to ensure we hit the generic `addEventListener(type: string, ...)` overload.
    const ASTRO_BEFORE_SWAP = 'astro:before-swap';

    document.addEventListener('visibilitychange', onVisibility);
    document.addEventListener(ASTRO_BEFORE_SWAP, cleanup, { once: true });
    window.addEventListener('pagehide', cleanup, { passive: true, once: true });

    start();
  })();
</script>

<style>
  .live-proof {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: calc(env(safe-area-inset-bottom) + var(--bottom-tab-bar-height, 0px) + 1.1rem);
    z-index: 45;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;

    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
    padding: 0.95rem 1rem;

    border-radius: 1rem;
    border: 1px solid rgb(var(--color-border) / 0.75);
    background:
      var(--asset-noise),
      linear-gradient(180deg, rgb(var(--color-surface)) 0%, rgb(var(--color-accent-50) / 0.8) 100%);
    background-blend-mode: soft-light, normal;

    box-shadow:
      0 18px 48px -30px rgb(0 0 0 / 0.65),
      0 1px 0 0 rgb(255 255 255 / 0.6) inset;
  }

  .live-proof__icon {
    width: 2.05rem;
    height: 2.05rem;
    border-radius: 0.75rem;
    display: grid;
    place-items: center;
    flex: none;
    background: rgb(var(--color-accent-100));
    border: 1px dashed rgb(var(--color-border) / 0.9);
    color: rgb(var(--color-text));
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    box-shadow: 0 10px 24px -18px rgb(0 0 0 / 0.35);
  }

  .live-proof__title {
    font-size: 0.9rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    color: rgb(var(--color-text));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .live-proof__meta {
    margin-top: 0.1rem;
    font-size: 0.82rem;
    color: rgb(var(--color-text-muted));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .live-proof__time {
    margin-left: 0.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: rgb(var(--color-text-subtle));
    flex: none;
  }

  @media (max-width: 640px) {
    .live-proof {
      position: static;
      max-width: none;
      margin: 1.25rem auto 0;
      width: 100%;
      padding: 0.9rem 1rem;
      box-shadow: 0 16px 38px -28px rgb(0 0 0 / 0.7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-proof {
      transition: none;
    }
  }
</style>
