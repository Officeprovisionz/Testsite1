---
import { siteConfig } from '@/data/siteConfig';

type Props = {
  type?: 'LocalBusiness' | 'Organization';
  includeBreadcrumbs?: boolean;
};

const { type = 'LocalBusiness', includeBreadcrumbs = true } = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site;

// LocalBusiness / Organization Schema
const [localityRaw, regionRaw] = siteConfig.brand.city.split(',').map((s) => s.trim());
const addressLocality = localityRaw || undefined;
const addressRegion = regionRaw || undefined;
const url = site ? new URL(base, site).toString() : undefined;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': type,
  name: siteConfig.brand.name,
  description: siteConfig.seo.description,
  url,
  image: url ? `${url}og-image.png` : undefined,
  telephone: siteConfig.contact.phoneE164,
  email: siteConfig.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality,
    addressRegion,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 37.7749, // Should ideally be in siteConfig
    longitude: -122.4194, // Should ideally be in siteConfig
  },
  openingHoursSpecification: siteConfig.hours.structured.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.day,
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: Object.values(siteConfig.social),
  priceRange: '$$',
  areaServed: siteConfig.areasServed.items.map((item) => ({
    '@type': 'City',
    name: item,
  })),
};

// BreadcrumbList Schema
let breadcrumbSchema = null;
if (includeBreadcrumbs) {
  const pathname = Astro.url.pathname;
  const relative = pathname.startsWith(base)
    ? pathname.slice(base.length)
    : pathname.replace(/^\/+/, '');
  const segments = relative.split('/').filter(Boolean);

  const labelMap: Record<string, string> = {
    about: 'About',
    services: 'Services',
    industries: 'Industries',
    resources: 'Resources',
    pricing: 'Scope & Pricing',
    checklist: 'Checklist',
    results: 'Results',
    contact: 'Contact',
    thanks: 'Thanks',
  };

  const defaultLabel = (seg: string) => {
    try {
      const decoded = decodeURIComponent(seg);
      return decoded
        .replace(/[-_]+/g, ' ')
        .replace(/\b\w/g, (m) => m.toUpperCase())
        .slice(0, 80);
    } catch {
      return seg.slice(0, 80);
    }
  };

  const crumbs = [
    { name: 'Home', path: '' },
    ...segments.map((seg, idx) => ({
      name: labelMap[seg] ?? defaultLabel(seg),
      path: `${segments.slice(0, idx + 1).join('/')}/`,
    })),
  ];

  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, idx) => {
      const rel = `${base}${c.path}`;
      const item = site ? new URL(rel, site).toString() : rel;
      return {
        '@type': 'ListItem',
        position: idx + 1,
        name: c.name,
        item,
      };
    }),
  };
}

const safeJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={safeJson(businessSchema)} />
{
  breadcrumbSchema && (
    <script is:inline type="application/ld+json" set:html={safeJson(breadcrumbSchema)} />
  )
}
