---
import { siteConfig } from '@/data/siteConfig';
import Spotlight from './ui/Spotlight.astro';
import { getImagePositionClass } from '@/lib/utils';
import { makeTelHref } from '@/lib/links';

type Props = {
  /** Optional fully-qualified (BASE_URL-prefixed) hero image URL. */
  imageSrc?: string;
  /** Optional srcset string for the hero image (URLs should already include BASE_URL). */
  imageSrcSet?: string | undefined;
  /** Optional sizes attribute when using srcset. */
  imageSizes?: string | undefined;

  /** Optional mobile-only hero image URL (BASE_URL-prefixed). Enables art-direction via <picture>. */
  imageSrcMobile?: string;
  /** Optional mobile-only srcset string (URLs should already include BASE_URL). */
  imageSrcSetMobile?: string | undefined;
  /** Optional mobile-only sizes attribute when using the mobile srcset. */
  imageSizesMobile?: string | undefined;

  /** CSS `object-position` value for the hero image, e.g. "50% 30%". */
  imagePosition?: string;
};

const {
  imageSrc,
  imageSrcSet,
  imageSizes,
  imageSrcMobile,
  imageSrcSetMobile,
  imageSizesMobile,
  imagePosition = '50% 50%',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const telHref = makeTelHref(siteConfig.contact.phoneE164);
// Opt-in only: avoids 404 network requests when the optional hero videos are not present.
const heroVideoOptIn =
  String(import.meta.env.PUBLIC_ENABLE_HERO_VIDEO ?? '').toLowerCase() === 'true';
const heroFallback = imageSrc ?? imageSrcMobile ?? '';
const heroImg = imageSrc ?? imageSrcMobile ?? heroFallback;

const imagePositionClass = getImagePositionClass(imagePosition);

const heroVideoWebm = `${base}media/hero-cleaning.webm`;
const heroVideoMp4 = `${base}media/hero-cleaning.mp4`;
---

<section
  class="hero-splash hero-photo relative w-full overflow-hidden antialiased"
  data-hero-section
>
  {/* Top-down gradient overlay for header readability */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 z-10 h-32 bg-gradient-to-b from-black/40 to-transparent opacity-60"
  >
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    {/* Always render a lightweight image base (also acts as the video poster / fallback). */}
    {
      imageSrcMobile || imageSrcSetMobile ? (
        <picture>
          <source
            media="(max-width: 639px)"
            srcset={imageSrcSetMobile ?? imageSrcMobile}
            sizes={imageSrcSetMobile ? imageSizesMobile : undefined}
          />
          <img
            src={heroImg}
            alt="Office cleaning team sanitizing commercial workspace in San Francisco"
            srcset={imageSrcSet}
            sizes={imageSrcSet ? imageSizes : undefined}
            class:list={[
              'h-full w-full object-cover opacity-[0.62] sm:opacity-[0.72]',
              imagePositionClass,
            ]}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            onerror={`if (this.src !== '${heroFallback}') this.src = '${heroFallback}'`}
          />
        </picture>
      ) : (
        <img
          src={heroImg}
          alt="Office cleaning team sanitizing commercial workspace in San Francisco"
          srcset={imageSrcSet}
          sizes={imageSrcSet ? imageSizes : undefined}
          class:list={[
            'h-full w-full object-cover opacity-[0.62] sm:opacity-[0.72]',
            imagePositionClass,
          ]}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          onerror={`if (this.src !== '${heroFallback}') this.src = '${heroFallback}'`}
        />
      )
    }

    {/* Optional background video (muted + playsInline + loop). */}
    {
      heroVideoOptIn && (
        <video
          class="absolute inset-0 hidden h-full w-full object-cover opacity-[0.14]"
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroImg}
          disablepictureinpicture
          data-hero-video
        >
          <source src={heroVideoWebm} type="video/webm" />
          <source src={heroVideoMp4} type="video/mp4" />
        </video>
      )
    }

    {/* Mobile-first readability veil with brand-tinted overlay (token-based for consistency). */}
    <div
      class="absolute inset-0 bg-gradient-to-b from-[rgb(var(--color-text))/0.6] via-[rgb(var(--color-text))/0.32] to-[rgb(var(--color-brand))/0.1] dark:from-[rgb(var(--color-text))/0.72] dark:via-[rgb(var(--color-text-subtle))/0.36] sm:from-[rgb(var(--color-text))/0.45] sm:via-[rgb(var(--color-text))/0.2]"
    >
    </div>
  </div>

  {/* Match the inner-page hero corner accent (used on Services) for visual consistency. */}
  <Spotlight class="-top-40 left-0 md:-top-20 md:left-60" fill="white" />

  <div
    class="container-page relative z-10 pb-20 pt-24 sm:pb-24 sm:pt-28 lg:pb-36 lg:pt-44 xl:pb-40 xl:pt-48"
  >
    <div class="mx-auto max-w-4xl text-center lg:max-w-5xl">
      <h1
        class="heading-1 animate-slide-up text-balance font-serif text-white drop-shadow-md lg:text-5xl xl:text-6xl"
        data-hero-headline
      >
        <span class="hero-shine">Precision cleaning for spaces that lead.</span>
      </h1>
      <p
        class="mx-auto mt-6 max-w-2xl animate-slide-up text-balance text-lg font-medium leading-relaxed text-white/90 drop-shadow-sm [animation-delay:200ms] md:text-xl lg:mt-8 lg:max-w-3xl lg:text-2xl"
        data-hero-subhead
      >
        Discreet, checklist-driven commercial cleaning for{' '}
        <span class="font-bold text-white">{siteConfig.brand.city}</span>'s most demanding
        workplaces.
      </p>
      <div
        class="mt-10 flex animate-slide-up flex-col items-center justify-center gap-4 [animation-delay:400ms] sm:flex-row lg:mt-12 lg:gap-5"
      >
        <a
          href={telHref}
          class="btn-primary btn-premium shadow-accent-900/30 w-full min-w-[180px] shadow-lg sm:w-auto lg:min-w-[200px] lg:px-8 lg:py-4 lg:text-base"
          data-haptic="true"
        >
          Call now
        </a>
        <a
          href={`${base}contact/`}
          class="btn-secondary btn-premium w-full min-w-[180px] sm:w-auto lg:min-w-[200px] lg:px-8 lg:py-4 lg:text-base"
          data-haptic="true"
        >
          Request a quote
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Progressive video enhancement
  const initVideo = () => {
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!video) return;

    const shouldEnable = () => {
      // Respect reduced motion
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (motion.matches) return false;

      // Respect data saver
      const nav = navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      };
      if (nav.connection?.saveData) return false;

      const type = (nav.connection?.effectiveType ?? '').toLowerCase();
      if (type.includes('2g')) return false;

      return true;
    };

    if (shouldEnable()) {
      video.classList.remove('hidden');
      video.play().catch(() => {
        // Autoplay failed or blocked
        video.classList.add('hidden');
      });

      // Track play once
      const onPlay = () => {
        if (window.damraTrack) {
          window.damraTrack('video_play', { video: 'hero' });
        }
        video.removeEventListener('play', onPlay);
      };
      video.addEventListener('play', onPlay);

      // If error, hide it
      video.addEventListener('error', () => {
        video.classList.add('hidden');
      });
    }
  };

  const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));

  const initHeroMotion = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero-section]');
    if (!hero) return;

    const isWebDriver = (navigator as Navigator & { webdriver?: boolean }).webdriver === true;
    const reduceMotion =
      (window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false) || isWebDriver;
    const headline = hero.querySelector<HTMLElement>('[data-hero-headline]');
    const subhead = hero.querySelector<HTMLElement>('[data-hero-subhead]');

    // Parallax text overlay (subtle, mobile-first). Disabled for reduced motion.
    if (!reduceMotion && headline && subhead) {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          ticking = false;
          const rect = hero.getBoundingClientRect();
          const progress = clamp(-rect.top / Math.max(1, rect.height), 0, 1);
          // Headline moves slightly slower than scroll.
          const hY = progress * -18;
          const pY = progress * -12;
          headline.style.transform = `translate3d(0, ${hY}px, 0)`;
          subhead.style.transform = `translate3d(0, ${pY}px, 0)`;
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    }
  };

  // Run on load
  initVideo();
  initHeroMotion();
  // Also run on view transitions if enabled later
  document.addEventListener('astro:page-load', initVideo);
  document.addEventListener('astro:page-load', initHeroMotion);
</script>
