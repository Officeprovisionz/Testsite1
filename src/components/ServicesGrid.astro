---
import { siteConfig } from '@/data/siteConfig';
import { Sparkles, Building, Coffee, Wrench } from 'lucide-react';

const icons = {
  'Office Cleaning': Sparkles,
  'Professional Janitorial': Building,
  'Coffee, Snacks & Restocking': Coffee,
  'Facilities Support': Wrench,
};
---

<section class="section section-creative" id="services">
  <div class="container-page">
    {/* Bento Grid Layout - Hand-rolled to remove React dependency */}
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 md:auto-rows-[16.5rem] md:grid-cols-2">
      {
        siteConfig.serviceFamilies.map((family) => {
          const Icon = icons[family.title as keyof typeof icons] || Sparkles;

          return (
            <div class="group/bento card card-hover relative row-span-1 flex flex-col justify-between overflow-hidden p-5 sm:p-6">
              <div class="flex h-full flex-col">
                <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg border border-[rgb(var(--color-accent)/0.3)] bg-[rgb(var(--color-accent)/0.16)]">
                  <Icon className="h-6 w-6 text-[rgb(var(--color-accent-500))]" />
                </div>

                <div class="mt-auto transition-all duration-300 group-hover/bento:translate-x-1">
                  <h3 class="text-strong mb-2 text-lg font-semibold leading-tight tracking-tight">
                    {family.title}
                  </h3>
                  <div class="line-clamp-3 text-[0.98rem] leading-relaxed text-muted">
                    {family.description}
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
