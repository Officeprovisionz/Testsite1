---
type Props = {
  class?: string;
};

const { class: className } = Astro.props;

// Stylized Golden Gate Bridge divider (lightweight SVG)
const deckY = 62;
const anchorY = 22;
const towerTopY = 10;
const leftTowerX = 300;
const rightTowerX = 700;

const cableY = (x: number, offset = 0) => {
  // Piecewise curve: side spans (anchors -> towers) + main span (tower -> tower).
  const o = offset;
  if (x <= leftTowerX) {
    const t = Math.min(1, Math.max(0, x / leftTowerX));
    // Start lower at the anchor, rise to tower top with a gentle belly.
    const line = (anchorY + o) * (1 - t) + (towerTopY + o) * t;
    return line + 6 * t * (1 - t);
  }

  if (x >= rightTowerX) {
    const t = Math.min(1, Math.max(0, (1000 - x) / (1000 - rightTowerX)));
    const line = (anchorY + o) * (1 - t) + (towerTopY + o) * t;
    return line + 6 * t * (1 - t);
  }

  const mid = (leftTowerX + rightTowerX) / 2;
  const half = (rightTowerX - leftTowerX) / 2;
  const sag = 32;
  const n = (x - mid) / half;
  // Parabola: lowest point at mid span.
  return towerTopY + o + sag * (1 - n * n);
};

const cablePath = (offset = 0) => {
  const o = offset;
  // Smooth cubic approximation through key points.
  const p0 = `M 0 ${anchorY + o}`;
  const p1 = `C 110 ${anchorY + o - 2}, 210 ${towerTopY + o + 10}, ${leftTowerX} ${towerTopY + o}`;
  const p2 = `C 380 ${towerTopY + o + 8}, 440 ${towerTopY + o + 34}, 500 ${towerTopY + o + 32}`;
  const p3 = `C 560 ${towerTopY + o + 34}, 620 ${towerTopY + o + 8}, ${rightTowerX} ${towerTopY + o}`;
  const p4 = `C 790 ${towerTopY + o + 10}, 890 ${anchorY + o - 2}, 1000 ${anchorY + o}`;
  return `${p0} ${p1} ${p2} ${p3} ${p4}`;
};
---

<div class:list={['pointer-events-none py-8 md:py-10 lg:py-12', className]} aria-hidden="true">
  <div class="container-page">
    <div class="text-brand/40 dark:text-brand/30">
      <svg
        width="100%"
        height="70"
        viewBox="0 0 1000 70"
        preserveAspectRatio="none"
        role="presentation"
        class="opacity-95"
      >
        <!-- Main suspension cable -->
        <path
          d={cablePath(0)}
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          class="text-brand/60"></path>

        <!-- Secondary cable (depth) -->
        <path
          d={cablePath(5)}
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          class="text-brand/35"></path>

        <!-- Towers (iconic silhouette) -->
        <g stroke="currentColor" fill="none" stroke-linecap="round" class="text-brand/45">
          <!-- Left tower -->
          <g stroke-width="2">
            <line x1={leftTowerX - 18} y1={towerTopY + 2} x2={leftTowerX - 18} y2={deckY}></line>
            <line x1={leftTowerX + 18} y1={towerTopY + 2} x2={leftTowerX + 18} y2={deckY}></line>
            <line x1={leftTowerX - 20} y1={towerTopY + 2} x2={leftTowerX + 20} y2={towerTopY + 2}
            ></line>
            <line x1={leftTowerX - 16} y1={towerTopY + 18} x2={leftTowerX + 16} y2={towerTopY + 18}
            ></line>
            <line x1={leftTowerX - 16} y1={towerTopY + 32} x2={leftTowerX + 16} y2={towerTopY + 32}
            ></line>
            <line x1={leftTowerX - 14} y1={towerTopY + 18} x2={leftTowerX - 14} y2={deckY}></line>
            <line x1={leftTowerX + 14} y1={towerTopY + 18} x2={leftTowerX + 14} y2={deckY}></line>
          </g>

          <!-- Right tower -->
          <g stroke-width="2">
            <line x1={rightTowerX - 18} y1={towerTopY + 2} x2={rightTowerX - 18} y2={deckY}></line>
            <line x1={rightTowerX + 18} y1={towerTopY + 2} x2={rightTowerX + 18} y2={deckY}></line>
            <line x1={rightTowerX - 20} y1={towerTopY + 2} x2={rightTowerX + 20} y2={towerTopY + 2}
            ></line>
            <line
              x1={rightTowerX - 16}
              y1={towerTopY + 18}
              x2={rightTowerX + 16}
              y2={towerTopY + 18}></line>
            <line
              x1={rightTowerX - 16}
              y1={towerTopY + 32}
              x2={rightTowerX + 16}
              y2={towerTopY + 32}></line>
            <line x1={rightTowerX - 14} y1={towerTopY + 18} x2={rightTowerX - 14} y2={deckY}></line>
            <line x1={rightTowerX + 14} y1={towerTopY + 18} x2={rightTowerX + 14} y2={deckY}></line>
          </g>
        </g>

        <!-- Vertical hangers (skip tower bays) -->
        <g stroke="currentColor" stroke-width="0.7" class="text-brand/25">
          {
            Array.from({ length: 60 }).map((_, i) => {
              const x = 30 + i * 16;
              // Avoid drawing hangers through the tower legs.
              const nearLeftTower = Math.abs(x - leftTowerX) < 24;
              const nearRightTower = Math.abs(x - rightTowerX) < 24;
              if (nearLeftTower || nearRightTower) return null;
              const y = cableY(x, 0);
              // Only draw if above deck (sanity guard).
              if (y >= deckY - 1) return null;
              // Slight variation helps it feel less "computer-perfect".
              const jitter = (i % 3) * 0.25;
              return <line x1={x} y1={y + jitter} x2={x} y2={deckY - 1} />;
            })
          }
        </g>

        <!-- Road deck + subtle truss -->
        <g stroke="currentColor" fill="none" class="text-brand/20">
          <line x1="0" y1={deckY} x2="1000" y2={deckY} stroke-width="2.6"></line>
          <line x1="0" y1={deckY + 3} x2="1000" y2={deckY + 3} stroke-width="1.2" opacity="0.7"
          ></line>
          <path
            d={`M 0 ${deckY + 3} L 60 ${deckY + 1} L 120 ${deckY + 3} L 180 ${deckY + 1} L 240 ${deckY + 3} L 300 ${deckY + 1} L 360 ${deckY + 3} L 420 ${deckY + 1} L 480 ${deckY + 3} L 540 ${deckY + 1} L 600 ${deckY + 3} L 660 ${deckY + 1} L 720 ${deckY + 3} L 780 ${deckY + 1} L 840 ${deckY + 3} L 900 ${deckY + 1} L 960 ${deckY + 3} L 1000 ${deckY + 1}`}
            stroke-width="0.9"
            opacity="0.55"></path>
        </g>
      </svg>
    </div>
  </div>
</div>
