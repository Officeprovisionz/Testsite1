---
const stats = [
  { value: '100+', label: 'Recurring offices served', accent: true },
  { value: '98%', label: 'Client retention rate' },
  { value: '24hr', label: 'Average response time' },
  { value: '15+', label: 'Years of experience' },
];
---

<section class="stats-belt section-muted">
  <div class="container-page">
    <dl class="stats-belt__grid">
      {
        stats.map((stat, i) => (
          <div class="stats-belt__item" style={`--i: ${i}`}>
            {i > 0 && <div class="stats-belt__divider" aria-hidden="true" />}
            <div class="stats-belt__inner">
              <dt
                class:list={['stats-belt__number', stat.accent ? 'stats-belt__number--accent' : '']}
                data-stat-value={stat.value}
                data-stat-animated="false"
              >
                {stat.value}
              </dt>
              <dd class="stats-belt__label">{stat.label}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const animateStats = () => {
    const stats = Array.from(document.querySelectorAll<HTMLElement>('[data-stat-value]'));
    if (!stats.length) return;

    const prefersReduced = (() => {
      try {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch {
        return false;
      }
    })();

    const parseValue = (raw: string) => {
      const match = raw.match(/([0-9.]+)/);
      const num = match ? Number(match[1]) : 0;
      const prefix = raw.trim().startsWith('+') ? '+' : '';
      const suffix = raw.replace(/^[+]?[0-9.]+/, '');
      return { num, prefix, suffix };
    };

    const animate = (el: HTMLElement) => {
      if (el.dataset.statAnimated === 'true') return;
      el.dataset.statAnimated = 'true';
      const { num, prefix, suffix } = parseValue(el.dataset.statValue ?? '');
      if (prefersReduced) {
        el.textContent = `${prefix}${num}${suffix}`;
        return;
      }

      const start = performance.now();
      const duration = 1400;

      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(num * eased);
        el.textContent = `${prefix}${current}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) animate(entry.target as HTMLElement);
        });
      },
      { threshold: 0.35 }
    );

    stats.forEach((el) => observer.observe(el));
  };

  document.addEventListener('astro:page-load', animateStats);
  animateStats();
</script>

<style>
  .stats-belt {
    padding-block: 3rem;
  }

  @media (min-width: 1024px) {
    .stats-belt {
      padding-block: 3.5rem;
    }
  }

  .stats-belt__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    max-width: 64rem;
    margin-inline: auto;
    border: 1px solid rgb(var(--color-border) / 0.5);
    border-radius: var(--radius-card);
    background: rgb(var(--color-surface) / 0.7);
    backdrop-filter: blur(8px);
    overflow: hidden;
    box-shadow:
      var(--shadow-xs),
      0 0 0 1px rgb(255 255 255 / 0.04) inset;
  }

  @media (min-width: 768px) {
    .stats-belt__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats-belt__item {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .stats-belt__divider {
    position: absolute;
    inset-inline-start: 0;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(var(--color-border) / 0.55) 30%,
      rgb(var(--color-border) / 0.55) 70%,
      transparent
    );
  }

  /* Row dividers on mobile (2-col grid) */
  @media (max-width: 767px) {
    .stats-belt__item:nth-child(n + 3) {
      border-top: 1px solid rgb(var(--color-border) / 0.45);
    }

    /* No left divider on first column */
    .stats-belt__item:nth-child(odd) .stats-belt__divider {
      display: none;
    }
  }

  .stats-belt__inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 1.75rem 1.25rem;
    text-align: center;
    transition: background-color 200ms ease;
  }

  .stats-belt__inner:hover {
    background-color: rgb(var(--color-surface-muted) / 0.5);
  }

  @media (min-width: 640px) {
    .stats-belt__inner {
      padding: 2rem 1.5rem;
    }
  }

  .stats-belt__number {
    font-size: clamp(1.875rem, 4vw, 2.625rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: rgb(var(--color-text-strong));
    font-variant-numeric: tabular-nums;
    transition: color 200ms;
  }

  .stats-belt__number--accent {
    background: linear-gradient(
      135deg,
      rgb(var(--color-accent-400)) 0%,
      rgb(var(--color-accent-500)) 55%,
      rgb(var(--color-brand-500)) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stats-belt__label {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgb(var(--color-text-muted));
    letter-spacing: 0.01em;
    line-height: 1.4;
    max-width: 10rem;
  }

  @media (min-width: 640px) {
    .stats-belt__label {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats-belt__number {
      transition: none;
    }
  }
</style>
