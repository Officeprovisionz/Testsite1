---
import { siteConfig } from '@/data/siteConfig';
import WaveDivider from '@/components/WaveDivider.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Eyebrow from './ui/Eyebrow.astro';

type Step = {
  title: string;
  description: string;
};

const {
  id,
  heading = 'How it works',
  description = 'A simple, repeatable process that keeps service consistent across visits.',
  showWave = true,
  waveTone = 'bg',
  steps = siteConfig.processSteps,
  qaEyebrow = 'Quality assurance',
  qaHeading = 'Checklist-based scope. Quick follow-through.',
  qaDescription = 'We keep scope clear and consistent with checklists—so you can delegate cleaning without babysitting it.',
  qaBullets = [
    'Clear inclusions + add-ons (no surprises)',
    'Single point of contact for requests',
    'Walkthrough notes + quick follow-up',
  ],
} = Astro.props as {
  id?: string;
  heading?: string;
  description?: string;
  showWave?: boolean;
  waveTone?: 'surface' | 'surface-muted' | 'bg';
  steps?: Step[];
  qaEyebrow?: string;
  qaHeading?: string;
  qaDescription?: string;
  qaBullets?: string[];
};

const safeWaveTone =
  waveTone === 'surface' || waveTone === 'surface-muted' || waveTone === 'bg' ? waveTone : 'bg';
---

<section id={id} class="section section-muted section-creative scroll-mt-20 pb-0">
  <div class="container-page relative lg:max-w-6xl">
    <SectionHeader heading={heading} description={description} />

    <ol class="mt-10 grid gap-6 lg:mt-14 lg:grid-cols-4 lg:gap-8">
      {
        (Array.isArray(steps) ? steps : []).map((s, idx) => (
          <li class="card card-hover relative overflow-hidden p-5 sm:p-6 lg:p-8">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.18)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
            />
            <div class="relative">
              <div class="flex items-center gap-3">
                <span
                  class="grid h-10 w-10 place-items-center rounded-[var(--radius-control)] border border-[rgb(var(--color-accent)/0.35)] bg-[rgb(var(--color-accent)/0.2)] text-sm font-semibold text-[rgb(12_14_18)] shadow-sm lg:h-12 lg:w-12 lg:text-base"
                  aria-hidden="true"
                >
                  {idx + 1}
                </span>
                <p class="text-strong text-sm font-semibold lg:text-base">{s.title}</p>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted lg:text-base lg:leading-relaxed">
                {s.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="card mt-10 overflow-hidden p-6 sm:p-8 lg:mt-14 lg:p-10">
      <div class="grid gap-6 md:grid-cols-2 md:items-center lg:gap-10">
        <div>
          <Eyebrow>{qaEyebrow}</Eyebrow>
          <p class="text-strong mt-2 text-lg font-bold lg:text-xl">
            {qaHeading}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-muted lg:text-base">
            {qaDescription}
          </p>
        </div>
        <ul class="check-list check-list--compact text-sm text-muted lg:text-base">
          {
            (Array.isArray(qaBullets) ? qaBullets : []).map((b) => (
              <li>
                <span class="check-icon check-icon--sm" aria-hidden="true">
                  ✓
                </span>
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  {
    showWave ? (
      <div class="relative -mb-px mt-12">
        <WaveDivider tone={safeWaveTone} class="absolute bottom-0 left-0 right-0" />
      </div>
    ) : null
  }
</section>
