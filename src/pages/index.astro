---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import LiveSocialProof from '@/components/LiveSocialProof.astro';
import ExpertiseGallery from '@/components/ExpertiseGallery.astro';
import BridgeDivider from '@/components/BridgeDivider.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Testimonials from '@/components/Testimonials.astro';
import FAQ from '@/components/FAQ.astro';
import Footer from '@/components/Footer.astro';
import { getPublicResponsiveImage } from '@/lib/publicImages';
import { pickGalleryItems } from '@/data/gallery';

// Homepage hero images
const heroItems = pickGalleryItems('home-hero', 2);
const heroPrimary = heroItems[0];
const heroSecondary = heroItems[1] ?? heroPrimary;

const heroImage = heroPrimary
  ? getPublicResponsiveImage(heroPrimary.src, import.meta.env.BASE_URL, { sizes: '100vw' })
  : { src: '', srcSet: undefined, sizes: '100vw' };

const heroImageMobile = heroSecondary
  ? getPublicResponsiveImage(heroSecondary.src, import.meta.env.BASE_URL, { sizes: '100vw' })
  : heroImage;

const siteUrl = Astro.site?.toString() ?? 'https://officeprovisionz.com';
---

<BaseLayout>
  <Header slot="header" transparent={true} />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Office Provisionz',
        url: siteUrl,
        logo: new URL('/brand/logo.png', siteUrl).toString(),
        contactPoint: {
          '@type': 'ContactPoint',
          telephone: '+1-510-913-2197',
          contactType: 'Customer Service',
          email: 'officeprovisionz@gmail.com',
        },
      },
    ])}
  />
  <Hero
    imageSrc={heroImage.src}
    imageSrcSet={heroImage.srcSet}
    imageSizes={heroImage.sizes}
    imageSrcMobile={heroImageMobile.src}
    imageSrcSetMobile={heroImageMobile.srcSet}
    imageSizesMobile={heroImageMobile.sizes}
    imagePosition="50% 45%"
  />

  <LiveSocialProof />

  <BridgeDivider />

  <ExpertiseGallery />

  <HowItWorks
    heading="How we keep your office consistent"
    description="A calm, repeatable process: walkthrough, checklist, the same crew, and responsive follow-through."
    showWave={false}
    steps={[
      {
        title: 'Walkthrough + priorities',
        description:
          'We learn what matters most, capture building requirements, and confirm the scope before we start.',
      },
      {
        title: 'Checklist + schedule',
        description:
          'We document inclusions and optional add-ons, then align timing so your team isn’t disrupted.',
      },
      {
        title: 'Repeatable visits',
        description:
          'Each visit follows the checklist—restrooms, common areas, floors—done the same way every time.',
      },
      {
        title: 'Owner follow‑up',
        description:
          'One point of contact for requests, adjustments, and close-the-loop follow‑through.',
      },
    ]}
    qaHeading="Checklist scope. Owner follow‑up."
    qaDescription="Clear scope, documented expectations, and a consistent routine so cleaning stays off your plate."
    qaBullets={[
      'Walkthrough notes captured once, reused every visit',
      'Photo updates available when needed',
      'If something’s off, we correct it and close the loop',
    ]}
  />

  <Testimonials />

  <FAQ />

  <Footer slot="footer" />
</BaseLayout>
