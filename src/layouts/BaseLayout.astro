---
import '@/styles/global.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/fraunces';
import spaceGroteskVariableUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import frauncesVariableUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import { siteConfig } from '@/data/siteConfig';
import { ClientRouter } from 'astro:transitions';
import { Toaster } from '@/components/Toaster';
import Schema from '@/components/Schema.astro';
import BottomTabBar from '@/components/BottomTabBar.astro';
import { PUBLIC_PLAUSIBLE_DOMAIN, PUBLIC_PLAUSIBLE_SRC, PUBLIC_SENTRY_DSN } from 'astro:env/client';

type Props = {
  title?: string;
  description?: string;
  /** Prevent search engines from indexing this page (useful for dev-only pages). */
  noIndex?: boolean;
};

const {
  title = siteConfig.seo.title,
  description = siteConfig.seo.description,
  noIndex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogPath = `${base}og-image.png`;
const ogUrl = Astro.site ? new URL(ogPath, Astro.site).toString() : ogPath;
const faviconHref = `${base}favicon.svg`;
const manifestHref = `${base}site.webmanifest`;

const assetNoise = `${base}noise.svg`;

const plausibleDomain = PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleSrc = PUBLIC_PLAUSIBLE_SRC;
const sentryDsn = PUBLIC_SENTRY_DSN;

const analyticsEnabled = siteConfig.analytics.enabled;

const sentryClientConfig = JSON.stringify({ dsn: sentryDsn || null, prod: import.meta.env.PROD })
  // Prevent accidental "</script>" injection via safe escaping.
  .replace(/</g, '\\u003c');
---

<!doctype html>
<html
  lang="en"
  data-theme="teal"
  data-mode="dark"
  style={`--asset-hero-bg: none; --asset-noise: url('${assetNoise}')`}
>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogUrl} />

    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href={manifestHref} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    {/* Resource hints for faster loading */}
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://formspree.io" crossorigin />

    {analyticsEnabled ? <link rel="dns-prefetch" href="https://plausible.io" /> : null}
    {analyticsEnabled ? <link rel="preconnect" href="https://plausible.io" crossorigin /> : null}

    {/* Preload critical fonts to reduce FOUT */}
    <link rel="preload" href={spaceGroteskVariableUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesVariableUrl} as="font" type="font/woff2" crossorigin />

    {
      /* Fonts are self-hosted via @fontsource imports (see frontmatter) to avoid third-party requests. */
    }
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={siteConfig.seo.themeColor}
    />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0d11" />
    <ClientRouter />

    {/* 2026 Speculation Rules - Instant pre-rendering for key conversion paths */}
    <script
      type="speculationrules"
      is:inline
      set:html={JSON.stringify({
        prerender: [
          {
            source: 'list',
            urls: ['/pricing', '/services', '/contact', '/about'],
          },
          {
            source: 'document',
            where: {
              and: [
                { href_matches: '/*' },
                { not: { href_matches: ['/dev/*', '#*', 'mailto:*', 'tel:*'] } },
              ],
            },
            eagerness: 'moderate',
          },
        ],
      })}
    />

    <script is:inline>
      (() => {
        // Vendor-neutral tracking hook.
        // - If Plausible is present, we forward events.
        // - If GTM dataLayer is present, we push events.
        // - Otherwise we no-op (and optionally log in dev).
        if (typeof window === 'undefined') return;

        window.damraTrack = (event, props) => {
          try {
            if (typeof window.plausible === 'function') {
              window.plausible(event, props ? { props } : undefined);
              return;
            }
            if (Array.isArray(window.dataLayer)) {
              window.dataLayer.push({ event, ...(props || {}) });
              return;
            }
          } catch {
            // ignore
          }
        };

        // Web Vitals tracking (handled in non-inline script below)
      })();
    </script>

    <script
      is:inline
      set:html={`(() => {
        const cfg = ${sentryClientConfig};
        const dsn = cfg && cfg.dsn ? String(cfg.dsn) : '';
        const prod = Boolean(cfg && cfg.prod);

        // Client-side error tracking (optional).
        // Only runs when PUBLIC_SENTRY_DSN is configured.
        if (typeof window === 'undefined') return;
        if (!prod) return;
        if (!dsn) return;

        const root = document.documentElement;
        if (root.dataset.sentryInit === 'true') return;
        root.dataset.sentryInit = 'true';

        import('@sentry/browser')
          .then((Sentry) => {
            Sentry.init({
              dsn: dsn,
              // Keep performance overhead low by default.
              tracesSampleRate: 0,
            });
          })
          .catch(() => {
            // ignore
          });
      })();`}
    />

    <script>
      import { onCLS, onLCP, onFCP, onTTFB, onINP, type Metric } from 'web-vitals';

      function sendToAnalytics(metric: Metric) {
        if (typeof window.damraTrack === 'function') {
          window.damraTrack('web_vitals', {
            name: metric.name,
            value: metric.value,
            id: metric.id,
            rating: metric.rating,
          });
        }
      }

      onCLS(sendToAnalytics);
      onLCP(sendToAnalytics);
      onFCP(sendToAnalytics);
      onTTFB(sendToAnalytics);
      onINP(sendToAnalytics);
    </script>

    <script is:inline>
      (() => {
        // Lightweight click tracking for core CTAs.
        // Opt-in via `data-track` on links/buttons.
        if (typeof window === 'undefined') return;

        const root = document.documentElement;
        if (root.dataset.trackInit === 'true') return;
        root.dataset.trackInit = 'true';

        /** @param {Element} el */
        const safeText = (el) => {
          try {
            const ds = /** @type {any} */ (el).dataset;
            return String(ds?.label ?? el.textContent ?? '')
              .trim()
              .slice(0, 120);
          } catch {
            return '';
          }
        };

        /** @param {Element} el */
        const safeHref = (el) => {
          try {
            const ds = /** @type {any} */ (el).dataset;
            const explicit = ds?.href;
            if (explicit) return explicit;

            if (el instanceof HTMLAnchorElement) {
              // Prefer attribute value for tel/mailto and relative links.
              return el.getAttribute('href') || el.href || '';
            }

            const a = el.querySelector('a[href]');
            if (a instanceof HTMLAnchorElement) {
              return a.getAttribute('href') || a.href || '';
            }
            return '';
          } catch {
            return '';
          }
        };

        document.addEventListener(
          'click',
          (e) => {
            const target = e.target instanceof Element ? e.target : null;
            if (!target) return;

            const el = target.closest('[data-track]');
            if (!el) return;

            const ds = /** @type {any} */ (el).dataset;

            const event = String(ds?.track ?? 'cta_click').trim() || 'cta_click';
            const props = {
              location: ds?.location || undefined,
              action: ds?.action || undefined,
              label: safeText(el) || undefined,
              href: safeHref(el) || undefined,
              page: (() => {
                try {
                  return window.location.pathname;
                } catch {
                  return undefined;
                }
              })(),
            };

            try {
              window.damraTrack?.(event, props);
            } catch {
              // ignore
            }
          },
          { capture: true }
        );
      })();
    </script>

    <script is:inline>
      (() => {
        // Scroll depth milestones (25/50/75/100) for engagement tracking.
        // Safe no-op if analytics isn't configured.
        if (typeof window === 'undefined') return;

        const root = document.documentElement;
        if (root.dataset.scrollDepthInit === 'true') return;
        root.dataset.scrollDepthInit = 'true';

        const thresholds = [25, 50, 75, 100];
        /** @type {Set<number>} */
        let hit = new Set();

        const resetForPage = () => {
          hit = new Set();
          // Fire the 0% marker for debugging/segmentation if desired (kept off by default).
        };

        const getPercent = () => {
          const doc = document.documentElement;
          const max = (doc.scrollHeight || 0) - window.innerHeight;
          if (max <= 0) return 100;
          return Math.max(0, Math.min(100, (window.scrollY / max) * 100));
        };

        let raf = 0;
        const onScroll = () => {
          if (raf) return;
          raf = window.requestAnimationFrame(() => {
            raf = 0;
            const pct = getPercent();
            thresholds.forEach((t) => {
              if (pct >= t && !hit.has(t)) {
                hit.add(t);
                try {
                  window.damraTrack?.('scroll_depth', {
                    depth: t,
                    page: window.location.pathname,
                  });
                } catch {
                  // ignore
                }
              }
            });
          });
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        document.addEventListener('astro:page-load', () => {
          resetForPage();
          onScroll();
        });

        resetForPage();
        onScroll();
      })();
    </script>

    <script is:inline>
      (() => {
        try {
          const savedMode = localStorage.getItem('mode');
          if (savedMode === 'light' || savedMode === 'dark' || savedMode === 'auto') {
            document.documentElement.dataset.mode = savedMode;
          }
          const saved = localStorage.getItem('theme');
          if (saved) document.documentElement.dataset.theme = saved;
        } catch {
          // ignore
        }
      })();
    </script>

    <script is:inline>
      (() => {
        // Keep Tailwind `dark:` variants and CSS variables aligned.
        // Problem this solves: when `data-mode="auto"` and the OS is dark, CSS media queries may flip
        // some tokens while Tailwind `dark:` styles and shadcn vars stay in light mode -> mixed theme.
        if (typeof window === 'undefined') return;

        const root = document.documentElement;
        if (root.dataset.modeSyncInit === 'true') return;
        root.dataset.modeSyncInit = 'true';

        const getMode = () => {
          const m = root.dataset.mode;
          return m === 'light' || m === 'dark' || m === 'auto' ? m : 'auto';
        };

        const getEffective = () => {
          const m = getMode();
          if (m === 'light' || m === 'dark') return m;
          try {
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          } catch {
            return 'light';
          }
        };

        const apply = () => {
          const eff = getEffective();
          root.dataset.modeEffective = eff;
          root.classList.toggle('dark', eff === 'dark');
        };

        apply();

        // React to system changes when in auto.
        try {
          const mq = window.matchMedia('(prefers-color-scheme: dark)');
          const onChange = () => {
            if (getMode() !== 'auto') return;
            apply();
          };
          if (typeof mq.addEventListener === 'function') {
            mq.addEventListener('change', onChange);
          } else {
            // Legacy fallback (e.g. older Safari) without using deprecated addListener.
            // `onchange` is widely supported and avoids deprecation warnings in typechecking.
            mq.onchange = onChange;
          }
        } catch {
          // ignore
        }

        // Allow other scripts (Header toggles, etc.) to request a re-sync.
        window.addEventListener('damra:mode-change', apply);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <link rel="icon" href={faviconHref} sizes="any" type="image/svg+xml" />
    <link rel="mask-icon" href={faviconHref} color={siteConfig.seo.themeColor} />
    <link rel="manifest" href={manifestHref} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.brand.name} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(siteConfig.seo.ogImage.width)} />
    <meta property="og:image:height" content={String(siteConfig.seo.ogImage.height)} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {/* Geographic meta tags for local business SEO */}
    <meta name="geo.region" content={siteConfig.seo.geo.region} />
    <meta name="geo.placename" content={siteConfig.seo.geo.placename} />
    <meta
      name="geo.position"
      content={`${siteConfig.seo.geo.latitude};${siteConfig.seo.geo.longitude}`}
    />
    <meta name="ICBM" content={`${siteConfig.seo.geo.latitude}, ${siteConfig.seo.geo.longitude}`} />

    <Schema />

    <script>
      const root = document.documentElement;

      const prefersReducedMotion = (() => {
        try {
          return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch {
          return false;
        }
      })();

      const isWebDriver = (() => {
        try {
          return (navigator as Navigator & { webdriver?: boolean }).webdriver === true;
        } catch {
          return false;
        }
      })();

      // Helpful for conditional styling in visual regression tests.
      if (isWebDriver) root.dataset.webdriver = 'true';

      const isTouchLike = (() => {
        try {
          return (
            window.matchMedia('(pointer: coarse)').matches ||
            window.matchMedia('(hover: none)').matches
          );
        } catch {
          return false;
        }
      })();

      if (prefersReducedMotion || isWebDriver || isTouchLike) {
        // Respect OS/user preference: avoid forced smooth scrolling.
      } else {
        if (root.dataset.lenisInit !== 'true') {
          root.dataset.lenisInit = 'true';
          // Only load Lenis when we intend to use it.
          import('lenis')
            .then((mod) => {
              const Lenis = (mod as { default: new () => { raf: (t: number) => void } }).default;
              const lenis = new Lenis();

              function raf(time: number) {
                lenis.raf(time);
                requestAnimationFrame(raf);
              }

              requestAnimationFrame(raf);
            })
            .catch(() => {
              // If Lenis fails to load for any reason, fall back to native scrolling.
            });
        }
      }

      // Track scroll progress for the progress bar
      let scrollRaf = 0;
      const updateScrollProgress = () => {
        scrollRaf = 0;
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        root.style.setProperty('--scroll-progress', `${progress}%`);
      };

      const requestScrollProgress = () => {
        if (scrollRaf) return;
        scrollRaf = window.requestAnimationFrame(updateScrollProgress);
      };

      if (root.dataset.scrollProgressInit !== 'true') {
        root.dataset.scrollProgressInit = 'true';
        window.addEventListener('scroll', requestScrollProgress, { passive: true });
        window.addEventListener('resize', requestScrollProgress);
        document.addEventListener('astro:page-load', requestScrollProgress);
      }

      requestScrollProgress();
    </script>

    <script is:inline>
      (() => {
        if (typeof window === 'undefined') return;

        const root = document.documentElement;
        if (root.dataset.routeProgressInit === 'true') return;
        root.dataset.routeProgressInit = 'true';

        const prefersReducedMotion =
          window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false;

        const getBar = () => document.querySelector('[data-route-progress]');
        const getStatus = () => document.querySelector('[data-route-status]');
        const getMain = () => document.querySelector('#main-content');
        let finishTimer = 0;
        let trickleTimer = 0;

        const setBusy = (busy) => {
          const main = getMain();
          if (!main || !(main instanceof HTMLElement)) return;
          if (busy) main.setAttribute('aria-busy', 'true');
          else main.removeAttribute('aria-busy');
        };

        const setSrStatus = (text) => {
          const el = getStatus();
          if (!el || !(el instanceof HTMLElement)) return;
          // Avoid spamming SR with duplicate messages.
          if (el.textContent === text) return;
          el.textContent = text;
        };

        const clearTimers = () => {
          if (finishTimer) window.clearTimeout(finishTimer);
          if (trickleTimer) window.clearTimeout(trickleTimer);
          finishTimer = 0;
          trickleTimer = 0;
        };

        const setScale = (el, value) => {
          /** @type {HTMLElement} */ (el).style.setProperty(
            '--route-progress-scale',
            String(value)
          );
        };

        const start = () => {
          const el = getBar();
          if (!el) return;
          clearTimers();

          setBusy(true);
          setSrStatus('Loading page...');

          /** @type {HTMLElement} */ (el).dataset.state = 'loading';
          setScale(el, 0.12);
          requestAnimationFrame(() => setScale(el, 0.35));

          const target = prefersReducedMotion ? 0.85 : 0.92;
          trickleTimer = window.setTimeout(
            () => setScale(el, target),
            prefersReducedMotion ? 60 : 260
          );
        };

        const done = () => {
          const el = getBar();
          if (!el) return;
          clearTimers();

          /** @type {HTMLElement} */ (el).dataset.state = 'finishing';
          setScale(el, 1);

          finishTimer = window.setTimeout(
            () => {
              const bar = getBar();
              if (!bar) return;
              /** @type {HTMLElement} */ (bar).dataset.state = 'idle';
              setScale(bar, 0);

              setBusy(false);
              setSrStatus('Page loaded.');
            },
            prefersReducedMotion ? 120 : 420
          );
        };

        // Astro View Transitions lifecycle.
        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:after-preparation', done);
        document.addEventListener('astro:page-load', done);
      })();
    </script>

    <script is:inline>
      (() => {
        // Prefetch high-intent internal navigations (CTAs) for snappier UX.
        // Astro recommends opt-in prefetching per-link (or by selector) rather than prefetching everything.
        // https://docs.astro.build/en/guides/prefetch/
        if (typeof window === 'undefined') return;

        const init = () => {
          const selector = 'a.btn-primary, a.btn-secondary, a.btn-accent, a.btn-invert';
          const anchors = Array.from(document.querySelectorAll(selector)).filter(
            (n) => n instanceof HTMLAnchorElement
          );

          anchors.forEach((a) => {
            if (a.hasAttribute('data-astro-prefetch')) return;
            if (a.dataset.ctaPrefetch === 'true') return;
            const href = a.getAttribute('href') || '';
            if (!href) return;

            // Skip non-page navigations.
            if (href.startsWith('#')) return;
            if (/^(tel:|mailto:|sms:)/i.test(href)) return;
            if (/^https?:\/\//i.test(href)) {
              try {
                const u = new URL(href);
                if (u.origin !== window.location.origin) return;
              } catch {
                return;
              }
            }

            // Prefer "tap" for CTAs (mobile-first), keeping bandwidth usage modest.
            a.setAttribute('data-astro-prefetch', 'tap');
            a.dataset.ctaPrefetch = 'true';
          });
        };

        document.addEventListener('astro:page-load', init);
        init();
      })();
    </script>

    <script is:inline define:vars={{ base, isDev: import.meta.env.DEV }}>
      (() => {
        // Register a lightweight service worker in production builds.
        // Keeps repeat visits fast and provides a basic offline shell.
        if (typeof window === 'undefined') return;
        const root = document.documentElement;
        if (root.dataset.swInit === 'true') return;
        root.dataset.swInit = 'true';
        if (isDev) return;
        if (!('serviceWorker' in navigator)) return;

        const swUrl = `${base}sw.js`;

        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(swUrl, { scope: base })
            .then((reg) => {
              // Listen for a new SW waiting to activate (common after deploy).
              const onStateChange = () => {
                if (reg.installing?.state === 'installed' && navigator.serviceWorker.controller) {
                  // A newer SW is ready; tell it to activate immediately.
                  reg.waiting?.postMessage({ type: 'SKIP_WAITING' });
                }
              };

              if (reg.installing) {
                reg.installing.addEventListener('statechange', onStateChange);
              }

              reg.addEventListener('updatefound', () => {
                reg.installing?.addEventListener('statechange', onStateChange);
              });

              // When the new SW takes over, reload to ensure fresh assets.
              let refreshing = false;
              navigator.serviceWorker.addEventListener('controllerchange', () => {
                if (refreshing) return;
                refreshing = true;
                window.location.reload();
              });
            })
            .catch(() => {
              // ignore
            });
        });
      })();
    </script>

    {/* Analytics provider script (Plausible) */}
    {
      analyticsEnabled ? (
        <script
          is:inline
          type="text/partytown"
          defer
          data-domain={plausibleDomain}
          src={plausibleSrc}
        />
      ) : null
    }
  </head>
  <body id="top">
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="route-progress" aria-hidden="true" data-route-progress data-state="idle"></div>

    <!-- Screen-reader friendly navigation status (matches the visual route progress bar). -->
    <p class="sr-only" data-route-status role="status" aria-live="polite" aria-atomic="true"></p>

    <a
      href="#main-content"
      class="border-app surface text-strong sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:px-4 focus:py-2 focus:shadow-soft"
    >
      Skip to content
    </a>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />

    <BottomTabBar />

    <!-- Toast Notification System -->
    <Toaster client:idle transition:persist />

    <script>
      import { initScrollTracking, captureUTMs } from '@/lib/tracking';
      import { hapticFeedback } from '@/lib/haptics';
      // Initialize analytics and tracking
      captureUTMs();
      initScrollTracking();

      // Micro-interactions: "haptic" press simulation.
      // We keep CSS `:active` scaling for responsiveness and add a tiny springy release.
      (() => {
        if (typeof window === 'undefined') return;
        const mq = window.matchMedia?.('(prefers-reduced-motion: reduce)');
        if (mq?.matches) return;

        const root = document.documentElement;
        if (root.dataset.hapticInit === 'true') return;
        root.dataset.hapticInit = 'true';

        const isHapticEl = (t: EventTarget | null) => {
          const target = t as Element | null;
          const el = target?.closest?.('[data-haptic="true"]') ?? null;
          return el && el instanceof HTMLElement ? el : null;
        };

        document.addEventListener(
          'pointerup',
          (e) => {
            const el = isHapticEl(e.target);
            if (!el) return;

            // Physical tactile feedback for 2026 mobile devices.
            hapticFeedback('tap', 'light');

            try {
              el.animate(
                [
                  { transform: 'scale(0.98)' },
                  { transform: 'scale(1.02)' },
                  { transform: 'scale(1)' },
                ],
                {
                  duration: 220,
                  easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                }
              );
            } catch {
              // ignore
            }
          },
          { passive: true }
        );
      })();
    </script>
