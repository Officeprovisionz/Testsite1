---
import { siteConfig } from '@/data/siteConfig';
import { getImagePositionClass } from '@/lib/utils';

type Props = {
  /** Optional fully-qualified (BASE_URL-prefixed) hero image URL. */
  imageSrc?: string;
  /** Optional srcset string for the hero image (URLs should already include BASE_URL). */
  imageSrcSet?: string | undefined;
  /** Optional sizes attribute when using srcset. */
  imageSizes?: string | undefined;

  /** Optional mobile-only hero image URL (BASE_URL-prefixed). Enables art-direction via <picture>. */
  imageSrcMobile?: string;
  /** Optional mobile-only srcset string (URLs should already include BASE_URL). */
  imageSrcSetMobile?: string | undefined;
  /** Optional mobile-only sizes attribute when using the mobile srcset. */
  imageSizesMobile?: string | undefined;

  /** CSS `object-position` value for the hero image, e.g. "50% 30%". */
  imagePosition?: string;
};

const {
  imageSrc,
  imageSrcSet,
  imageSizes,
  imageSrcMobile,
  imageSrcSetMobile,
  imageSizesMobile,
  imagePosition = '50% 50%',
} = Astro.props;

const base = import.meta.env.BASE_URL;
// Opt-in only: avoids 404 network requests when the optional hero videos are not present.
const heroVideoOptIn =
  String(import.meta.env.PUBLIC_ENABLE_HERO_VIDEO ?? '').toLowerCase() === 'true';
const heroFallback = imageSrc ?? imageSrcMobile ?? '';
const heroImg = imageSrc ?? imageSrcMobile ?? heroFallback;

const imagePositionClass = getImagePositionClass(imagePosition);

const heroVideoWebm = `${base}media/hero-cleaning.webm`;
const heroVideoMp4 = `${base}media/hero-cleaning.mp4`;
---

<section
  class="hero-splash hero-photo hero-split relative w-full overflow-hidden antialiased"
  data-hero-section
>
  {/* Top-down gradient overlay for header readability */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 z-10 h-32 bg-linear-to-b from-black/40 to-transparent opacity-60"
  >
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    {/* Always render a lightweight image base (also acts as the video poster / fallback). */}
    {
      imageSrcMobile || imageSrcSetMobile ? (
        <picture>
          <source
            media="(max-width: 639px)"
            srcset={imageSrcSetMobile ?? imageSrcMobile}
            sizes={imageSrcSetMobile ? imageSizesMobile : undefined}
          />
          <img
            src={heroImg}
            alt="Office cleaning team sanitizing commercial workspace in San Francisco"
            srcset={imageSrcSet}
            sizes={imageSrcSet ? imageSizes : undefined}
            class:list={[
              'h-full w-full object-cover opacity-[0.82] sm:opacity-[0.88]',
              imagePositionClass,
            ]}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            onerror={`if (this.src !== '${heroFallback}') this.src = '${heroFallback}'`}
          />
        </picture>
      ) : (
        <img
          src={heroImg}
          alt="Office cleaning team sanitizing commercial workspace in San Francisco"
          srcset={imageSrcSet}
          sizes={imageSrcSet ? imageSizes : undefined}
          class:list={[
            'h-full w-full object-cover opacity-[0.82] sm:opacity-[0.88]',
            imagePositionClass,
          ]}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          onerror={`if (this.src !== '${heroFallback}') this.src = '${heroFallback}'`}
        />
      )
    }

    {/* Optional background video (muted + playsInline + loop). */}
    {
      heroVideoOptIn && (
        <video
          class="absolute inset-0 hidden h-full w-full object-cover opacity-[0.14]"
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroImg}
          disablepictureinpicture
          data-hero-video
        >
          <source src={heroVideoWebm} type="video/webm" />
          <source src={heroVideoMp4} type="video/mp4" />
        </video>
      )
    }

    {/* Mobile-first readability veil with brand-tinted overlay (token-based for consistency). */}
    <div
      class="absolute inset-0 bg-linear-to-b from-[rgb(var(--color-text))/0.45] via-[rgb(var(--color-text))/0.22] to-[rgb(var(--color-brand))/0.08] sm:from-[rgb(var(--color-text))/0.38] sm:via-[rgb(var(--color-text))/0.18] dark:from-[rgb(var(--color-text))/0.6] dark:via-[rgb(var(--color-text-subtle))/0.3]"
    >
    </div>

    {/* Subtle vignette for edge contrast */}
    <div
      class="absolute inset-0 bg-[radial-gradient(80%_70%_at_50%_35%,transparent_0%,rgba(2,6,23,0.22)_65%,rgba(2,6,23,0.5)_100%)]"
    >
    </div>
  </div>

  <div
    class="container-page relative z-10 pt-20 pb-16 sm:pt-26 sm:pb-22 md:pt-30 md:pb-24 lg:pt-44 lg:pb-36 xl:pt-48 xl:pb-40"
  >
    <div class="hero-split__content mx-auto max-w-4xl text-center lg:max-w-5xl lg:text-left">
      <h1 class="display-hero text-hero-shadow animate-slide-up text-white" data-hero-headline>
        <span class="block">For spaces shaped by ambition</span>
        <span class="block">and expectation.</span>
      </h1>
      <p
        class="text-hero-shadow animate-slide-up mx-auto mt-4 max-w-xl text-base leading-relaxed font-normal text-balance text-white/85 [animation-delay:200ms] sm:mt-6 sm:max-w-2xl sm:text-lg md:text-xl lg:mt-8 lg:max-w-2xl lg:text-2xl"
        data-hero-subhead
      >
        Local, owner-led cleaning in <span class="font-bold text-white"
          >{siteConfig.brand.city}</span
        >. Same crew, photo updates, and a real person answering when you call.
      </p>

      {/* Trust stat bar */}
      <div
        class="animate-slide-up mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2.5 [animation-delay:380ms] lg:justify-start"
        aria-label="Quick facts"
      >
        <div class="hero-stat">
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
            class="shrink-0 opacity-80"
          >
            <circle cx="7" cy="7" r="6.5" stroke="currentColor" stroke-opacity="0.4"></circle>
            <path
              d="M4 7l2 2 4-4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>Owner-operated · SF locals</span>
        </div>
        <span class="hero-stat-sep" aria-hidden="true"></span>
        <div class="hero-stat">
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
            class="shrink-0"
          >
            <path
              d="M7 1l1.545 4.236H13.09l-3.636 2.618 1.382 4.237L7 9.472l-3.836 2.619 1.382-4.237L.91 5.236H5.455L7 1z"
              fill="currentColor"
              opacity="0.85"></path>
          </svg>
          <span>4.9 avg. rating</span>
        </div>
        <span class="hero-stat-sep" aria-hidden="true"></span>
        <div class="hero-stat">
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
            class="shrink-0 opacity-80"
          >
            <circle
              cx="7"
              cy="7"
              r="6"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-opacity="0.5"></circle>
            <path
              d="M7 4v3.25l2 1.25"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>Same-day response</span>
        </div>
      </div>
    </div>

    <div class="hero-split__spacer" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.78);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .hero-stat-sep {
    display: none;
    width: 1px;
    height: 0.875rem;
    background-color: rgba(255, 255, 255, 0.22);
    flex-shrink: 0;
  }

  @media (min-width: 480px) {
    .hero-stat-sep {
      display: block;
    }
  }
</style>

<script>
  // Progressive video enhancement
  const initVideo = () => {
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!video) return;

    const shouldEnable = () => {
      // Respect reduced motion
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (motion.matches) return false;

      // Respect data saver
      const nav = navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      };
      if (nav.connection?.saveData) return false;

      const type = (nav.connection?.effectiveType ?? '').toLowerCase();
      if (type.includes('2g')) return false;

      return true;
    };

    if (shouldEnable()) {
      video.classList.remove('hidden');
      video.play().catch(() => {
        // Autoplay failed or blocked
        video.classList.add('hidden');
      });

      // Track play once
      const onPlay = () => {
        if (window.damraTrack) {
          window.damraTrack('video_play', { video: 'hero' });
        }
        video.removeEventListener('play', onPlay);
      };
      video.addEventListener('play', onPlay);

      // If error, hide it
      video.addEventListener('error', () => {
        video.classList.add('hidden');
      });
    }
  };

  const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));

  const initHeroMotion = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero-section]');
    if (!hero) return;
    if (hero.dataset.heroMotionInit === 'true') return;
    hero.dataset.heroMotionInit = 'true';

    const isWebDriver = (navigator as Navigator & { webdriver?: boolean }).webdriver === true;
    const isTouchLike = (() => {
      try {
        return (
          window.matchMedia('(pointer: coarse)').matches ||
          window.matchMedia('(hover: none)').matches
        );
      } catch {
        return false;
      }
    })();

    const isSaveData = (() => {
      try {
        const nav = navigator as Navigator & { connection?: { saveData?: boolean } };
        return nav.connection?.saveData === true;
      } catch {
        return false;
      }
    })();

    const reduceMotion =
      (window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false) ||
      isWebDriver ||
      isTouchLike ||
      isSaveData;
    const headline = hero.querySelector<HTMLElement>('[data-hero-headline]');
    const subhead = hero.querySelector<HTMLElement>('[data-hero-subhead]');

    // Parallax text overlay (desktop-only). Kept off on touch/data-saver for smoothness.
    if (reduceMotion || !headline || !subhead) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = hero.getBoundingClientRect();
      const progress = clamp(-rect.top / Math.max(1, rect.height), 0, 1);
      // Headline moves slightly slower than scroll.
      const hY = progress * -18;
      const pY = progress * -12;
      headline.style.transform = `translate3d(0, ${hY}px, 0)`;
      subhead.style.transform = `translate3d(0, ${pY}px, 0)`;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    let listening = false;
    const start = () => {
      if (listening) return;
      listening = true;
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    };
    const stop = () => {
      if (!listening) return;
      listening = false;
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };

    // Only do work while hero is near the viewport.
    const io = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;
        if (entry.isIntersecting) start();
        else stop();
      },
      { root: null, threshold: 0, rootMargin: '150px 0px 150px 0px' }
    );
    io.observe(hero);

    const cleanup = () => {
      stop();
      try {
        io.disconnect();
      } catch {
        // ignore
      }
    };

    // Clean up for Astro view transitions.
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  };

  // Run on load
  initVideo();
  initHeroMotion();
  // Also run on view transitions if enabled later
  document.addEventListener('astro:page-load', initVideo);
  document.addEventListener('astro:page-load', initHeroMotion);
</script>
