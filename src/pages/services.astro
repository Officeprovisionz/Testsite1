---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
import ServicesGrid from '@/components/ServicesGrid.astro';
import ServicesSection from '@/components/Services.astro';
import IndustriesGrid from '@/components/IndustriesGrid.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import PricingGrid from '@/components/PricingGrid.astro';
import ScopeSection from '@/components/Scope.astro';
import AreasServed from '@/components/AreasServed.astro';
import FAQ from '@/components/FAQ.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { siteConfig } from '@/data/siteConfig';
import { getCollection } from 'astro:content';
import { getPublicResponsiveImage } from '@/lib/publicImages';
import { pickGalleryItems } from '@/data/gallery';
import { makeHref } from '@/lib/nav';

const title = `Services | ${siteConfig.brand.name}`;
const description =
  'Office cleaning, janitorial services, supplies/restocking, and facilities support—built for busy teams in San Francisco.';

const hrefNav = makeHref(import.meta.env.BASE_URL);

const checklistCore = siteConfig.whatIncluded;
const checklistAddOns = [
  'Glass and interior partitions (as scoped)',
  'High-touch deep focus (as needed)',
  'Floor detailing / spot treatment',
  'Kitchenette detail pass (microwave exterior, counters, sink)',
  'Supply restocking checklist (paper goods, soap)',
  'Walkthrough notes + follow-up items',
];

const resources = [
  {
    eyebrow: 'Checklist',
    title: 'Office cleaning checklist',
    desc: 'Use for walkthroughs, vendor comparisons, and ongoing quality checks.',
    href: hrefNav('services/#checklist'),
    cta: 'View checklist',
  },
  {
    eyebrow: 'Scope',
    title: 'Scope & process',
    desc: 'How scope works: walkthrough, frequency, add-ons, and service levels.',
    href: hrefNav('services/#scope-process'),
    cta: 'See scope',
  },
  {
    eyebrow: 'Proof',
    title: 'What clean looks like',
    desc: 'Examples and standards—what we mean by “done”.',
    href: hrefNav('about/#proof'),
    cta: 'See proof',
  },
  {
    eyebrow: 'Contact',
    title: 'Request a quote',
    desc: 'Share basics and priorities. We’ll confirm scope + access and send a clear written quote.',
    href: hrefNav('contact/#quote'),
    cta: 'Request a quote',
  },
];

const allServices = await getCollection('services');
const specialtyServices = allServices
  .filter((s) => s.data.category === 'specialty')
  .map((s) => s.data);

const heroItems = pickGalleryItems('services-hero', 2);
const heroPrimary = heroItems[0];
const heroSecondary = heroItems[1] ?? heroPrimary;

const heroImage = heroPrimary
  ? getPublicResponsiveImage(heroPrimary.src, import.meta.env.BASE_URL, {
      sizes: '100vw',
    })
  : { src: '', srcSet: undefined, sizes: '100vw' };

const heroImageMobile = heroSecondary
  ? getPublicResponsiveImage(heroSecondary.src, import.meta.env.BASE_URL, {
      sizes: '100vw',
    })
  : heroImage;
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: 'Office Cleaning',
      provider: {
        '@type': 'LocalBusiness',
        name: 'Office Provisionz',
      },
      areaServed: {
        '@type': 'City',
        name: 'San Francisco',
      },
      description:
        'Professional office cleaning services including janitorial, deep cleaning, and supply restocking.',
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        priceCurrency: 'USD',
        price: 'Call for quote',
      },
    })}
  />

  <PageHero
    title="Services"
    description="Janitorial, detail cleaning, restocking, and light facilities support—delivered with clear scope, consistent checklists, and fast follow-up."
    imageSrc={heroPrimary?.src}
    imageSrcMobile={heroSecondary?.src}
    imageAlt={heroPrimary?.alt ?? ''}
    imageSrcSet={heroImage.srcSet}
    imageSizes={heroImage.sizes}
    imageSrcSetMobile={heroImageMobile.srcSet}
    imageSizesMobile={heroImageMobile.sizes}
    imagePosition="50% 45%"
  />

  <ServicesGrid />

  <!-- Industries page merged here (no information removed) -->
  <IndustriesGrid />
  <HowItWorks id="process" heading="A process built for operations" waveTone="surface-muted" />

  <section class="section section-muted section-creative scroll-mt-20" id="service-details">
    <div class="container-page">
      <SectionHeader
        align="center"
        eyebrow="What it looks like"
        heading="Details that keep the day running"
        description="This is the kind of support teams ask for most—clear scope, repeatable checklists, and the extras that remove friction."
      />

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:mt-12 lg:grid-cols-3">
        <article class="card card-hover p-6 sm:p-7">
          <p class="text-strong text-lg font-semibold">Routine clean</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Your workspace deserves to shine. Our routine commercial cleaning handles it all—from
            counters to floors. We remove trash, mop (wet and dry), wipe down counters, clean and
            polish appliances, reset chairs, and spot clean glass and entryways. Dependable service
            that keeps your office looking its best.
          </p>
        </article>

        <article class="card card-hover p-6 sm:p-7">
          <p class="text-strong text-lg font-semibold">Deep clean</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Ready for a deeper clean? Our thorough service tackles what routine cleaning misses—
            dusting baseboards and ceilings, carefully cleaning personal offices and monitors,
            disinfecting and sanitizing throughout, and polishing stainless steel appliances to
            perfection.
          </p>
        </article>

        <article class="card card-hover p-6 sm:p-7">
          <p class="text-strong text-lg font-semibold">Specialty care</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Beyond routine care—specialty cleaning that transforms your space. Whether you need
            post-construction cleanup, sparkling windows, deep carpet and furniture extraction, or
            glossy polished floors, we bring professional equipment and expertise to every unique
            challenge.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-creative scroll-mt-20" id="breakroom">
    <div class="container-page">
      <SectionHeader
        align="center"
        eyebrow="Breakroom & operations"
        heading="Your office partner (not just cleaning)"
        description="We can support pantry, coffee, and day-to-day office needs—so your team stays focused and the space stays ready."
      />

      <div class="mt-10 grid gap-6 lg:mt-12 lg:grid-cols-2">
        <article class="card card-hover relative overflow-hidden p-6 sm:p-7">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.14)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
          >
          </div>
          <div class="relative">
            <p class="text-strong text-lg font-semibold">Snacks, drinks, pantry essentials</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Your break room is our priority. We’re your office partner for snacks, drinks, coffee,
              and everything that keeps your day running efficiently—without the hassle.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Your team is unique, and your pantry should be too. We’ll work with you to create a
              customized selection that balances health-conscious choices with everyone’s
              favorites—because satisfaction matters.
            </p>
          </div>
        </article>

        <article class="card card-hover p-6 sm:p-7">
          <p class="text-strong text-lg font-semibold">Coffee program</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Fresh, locally roasted coffee meets the right machine for your space. We’re experts in
            everything from traditional espresso setups to fully automated systems and classic
            coffee machines—plus we source all the essentials: milk, non-dairy alternatives,
            creamers, sweeteners, and every finishing touch your team wants.
          </p>
        </article>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:mt-8 lg:grid-cols-4">
        <article class="card card-hover p-6">
          <p class="text-strong text-sm font-semibold">Furniture services</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Need furniture built or rearranged? We provide professional furniture assembly and
            moving services that transform your office space efficiently.
          </p>
        </article>
        <article class="card card-hover p-6">
          <p class="text-strong text-sm font-semibold">Office organization</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Is clutter holding your business back? We create order that lasts—from storage rooms to
            disorganized inventory.
          </p>
        </article>
        <article class="card card-hover p-6">
          <p class="text-strong text-sm font-semibold">Air filter replacement</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Scheduled filter changes to support healthier air quality—so you never have to think
            about it.
          </p>
        </article>
        <article class="card card-hover p-6">
          <p class="text-strong text-sm font-semibold">Event & assistant support</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            From company meetings to special celebrations, we help with the details so everything
            runs smoothly.
          </p>
        </article>
      </div>

      <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-muted">
        A well-maintained office doesn’t just look better—it performs better. Our dedicated
        maintenance team provides comprehensive solutions that keep your workplace organized,
        functional, and running at peak efficiency.
      </p>
    </div>
  </section>

  <!-- Resources page merged here (no information removed) -->
  <section class="section section-creative scroll-mt-20" id="tools">
    <div class="container-page">
      <SectionHeader
        align="center"
        eyebrow="Tools"
        heading="Make scope feel effortless"
        description="Short, printable tools for walkthroughs, vendor comparisons, and keeping expectations crystal clear."
      />

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          resources.map((r) => (
            <article class="card card-hover relative overflow-hidden p-6 sm:p-7">
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.14)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
              />
              <div class="relative">
                <Eyebrow>{r.eyebrow}</Eyebrow>
                <h2 class="text-strong mt-2 text-xl font-semibold tracking-tight">{r.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">{r.desc}</p>
                <div class="mt-5">
                  <a class="btn-secondary w-full sm:w-auto" href={r.href}>
                    {r.cta}
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Checklist page merged here (no information removed) -->
  <section class="section section-creative scroll-mt-20" id="checklist">
    <div class="container-narrow">
      <div class="card p-6 sm:p-8">
        <SectionHeader
          eyebrow="Resource"
          heading="Office cleaning checklist"
          description="Use this checklist to scope a walkthrough, compare vendors, and keep service consistent across visits."
        >
          <button slot="actions" type="button" class="btn-secondary w-full sm:w-auto" data-print>
            Print
          </button>
        </SectionHeader>

        <div class="mt-8 grid gap-8">
          <div>
            <h3 class="heading-3">Core items (standard visit)</h3>
            <ul class="check-list check-list--compact text-sm sm:grid-cols-2">
              {
                checklistCore.map((item) => (
                  <li>
                    <span class="check-icon check-icon--sm" aria-hidden="true">
                      ✓
                    </span>
                    <span class="text-muted">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="heading-3">Common add-ons (scope-dependent)</h3>
            <ul class="check-list check-list--compact text-sm sm:grid-cols-2">
              {
                checklistAddOns.map((item) => (
                  <li>
                    <span class="check-icon check-icon--sm" aria-hidden="true">
                      ✓
                    </span>
                    <span class="text-muted">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="panel panel-muted p-5">
            <p class="text-strong text-sm font-semibold">Pro tip</p>
            <p class="mt-2 text-sm text-muted">
              During a walkthrough, decide what “good” looks like for restrooms, breakrooms, and
              floors. A clear definition of done prevents missed expectations later.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing/Scope page merged here (no information removed) -->
  <section class="section section-creative scroll-mt-20 pb-0" id="scope-process">
    <div class="container-page">
      <div class="mb-12">
        <SectionHeader
          align="center"
          eyebrow="Scope"
          heading="How scope works"
          description="Scope depends on your space and service frequency. We confirm what’s included first—then send a clear, written quote."
        />
      </div>

      <PricingGrid />
    </div>
  </section>

  <ScopeSection id="scope" heading="Service levels" />

  <ServicesSection
    id="specialty"
    heading="Specialty & add-on services"
    description="Add these one-off or periodic services when you need them. We confirm access, timing, and building rules during scoping—so pricing and expectations stay clear."
    presentation="dropdown"
    items={specialtyServices}
  />

  <AreasServed />

  <FAQ showWave={false} />

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (() => {
    const init = () => {
      const btn = document.querySelector('[data-print]');
      if (!(btn instanceof HTMLButtonElement)) return;
      if (btn.dataset.printInit === 'true') return;
      btn.dataset.printInit = 'true';
      btn.addEventListener('click', () => window.print());
    };

    const doc = document.documentElement;
    if (doc.dataset.printListen !== 'true') {
      doc.dataset.printListen = 'true';
      document.addEventListener('astro:page-load', init);
    }

    init();
  })();
</script>
