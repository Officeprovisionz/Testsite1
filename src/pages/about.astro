---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
import ProcessTimeline from '@/components/ProcessTimeline.astro';
import AreasServed from '@/components/AreasServed.astro';
import Gallery from '@/components/Gallery.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { siteConfig } from '@/data/siteConfig';
import { getPublicResponsiveImage } from '@/lib/publicImages';
import { pickGalleryItems } from '@/data/gallery';

const title = `About | ${siteConfig.brand.name}`;
const description =
  'Commercial-grade cleaning focused on clear communication, consistent checklists, and respectful service.';

const heroItems = pickGalleryItems('about-hero', 2);
const heroPrimary = heroItems[0];
const heroSecondary = heroItems[1] ?? heroPrimary;
const galleryItems = pickGalleryItems('about-gallery', 5);

const heroImage = heroPrimary
  ? getPublicResponsiveImage(heroPrimary.src, import.meta.env.BASE_URL, {
      sizes: '100vw',
    })
  : { src: '', srcSet: undefined, sizes: '100vw' };

const heroImageMobile = heroSecondary
  ? getPublicResponsiveImage(heroSecondary.src, import.meta.env.BASE_URL, {
      sizes: '100vw',
    })
  : heroImage;
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <PageHero
    title="A cleaner workspace, a simpler workday"
    description="Built for reliability: clear communication, consistent checklists, and a team that respects your space and schedule."
    imageSrc={heroPrimary?.src}
    imageSrcMobile={heroSecondary?.src}
    imageAlt={heroPrimary?.alt ?? ''}
    imageSrcSet={heroImage.srcSet}
    imageSizes={heroImage.sizes}
    imageSrcSetMobile={heroImageMobile.srcSet}
    imageSizesMobile={heroImageMobile.sizes}
    imagePosition="50% 40%"
  />

  <Gallery
    id="proof"
    heading="Recent results"
    description="A quick look at the spaces we support. Real work, consistent checklists, and clean results."
    items={galleryItems}
    showTip={false}
    showItemText={false}
    showLightboxText={false}
  />

  <section class="section section-creative scroll-mt-20 pb-0" id="how-we-work">
    <div class="container-page">
      <div class="mb-12">
        <SectionHeader
          align="center"
          eyebrow="Process"
          heading="How we work"
          description="Great cleaning is a process. We confirm scope, follow a checklist, and keep you in the loop—so you always know what to expect."
        />
      </div>

      <ProcessTimeline />
    </div>
  </section>

  <section class="section section-muted section-creative scroll-mt-20" id="expect">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="heading-2">What to expect</h2>
          <p class="text-muted mt-4 text-lg">
            We don't just clean; we communicate. From the first walkthrough to the daily checklist,
            everything is designed to be clear and consistent.
          </p>
          <p class="text-muted mt-4 text-lg">
            And when it helps, we can support the space beyond cleaning—breakroom essentials, coffee
            setups, and practical office help that keeps the day running efficiently.
          </p>
          <ul class="check-list">
            <li>
              <span class="check-icon" aria-hidden="true">✓</span>
              <span class="text-strong">Consistent crews who know your space</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">✓</span>
              <span class="text-strong">Real-time reporting and issue flagging</span>
            </li>
            <li>
              <span class="check-icon" aria-hidden="true">✓</span>
              <span class="text-strong">Flexible scheduling to fit your operations</span>
            </li>
          </ul>
        </div>
        <div class="card card-hover relative overflow-hidden p-6 sm:p-8">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-linear-to-br from-[rgb(var(--color-accent)/0.14)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
          >
          </div>
          <div class="relative">
            <Eyebrow>Our commitments</Eyebrow>
            <h3 class="heading-3 mt-2">Consistency you can count on</h3>
            <p class="text-muted mt-3 text-sm">
              The details vary by space, but our process stays the same—clear scope, checklist
              delivery, and fast follow-up.
            </p>

            <div class="mt-6 grid gap-3 sm:grid-cols-2">
              <div class="panel panel-muted flex items-start gap-3 p-4">
                <span
                  class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-lg bg-[rgb(var(--color-accent)/0.18)] text-[rgb(var(--color-accent-600))]"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 14 14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-3 w-3"
                    ><path stroke-linecap="round" stroke-linejoin="round" d="M2 7l3.5 3.5L12 3"
                    ></path></svg
                  >
                </span>
                <div>
                  <p class="text-strong text-sm font-semibold">Clear scope</p>
                  <p class="text-muted mt-0.5 text-xs leading-relaxed">
                    Written checklist + agreed add-ons.
                  </p>
                </div>
              </div>
              <div class="panel panel-muted flex items-start gap-3 p-4">
                <span
                  class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-lg bg-[rgb(var(--color-accent)/0.18)] text-[rgb(var(--color-accent-600))]"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 14 14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-3 w-3"
                    ><path stroke-linecap="round" stroke-linejoin="round" d="M2 7l3.5 3.5L12 3"
                    ></path></svg
                  >
                </span>
                <div>
                  <p class="text-strong text-sm font-semibold">Follow-through</p>
                  <p class="text-muted mt-0.5 text-xs leading-relaxed">
                    Issues flagged + resolved promptly.
                  </p>
                </div>
              </div>
            </div>

            <p class="text-subtle mt-4 text-xs">
              Want more detail? Ask for a sample checklist during your walkthrough.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-creative scroll-mt-20" id="values">
    <div class="container-page">
      <SectionHeader
        eyebrow="Values"
        heading="Built for consistency (and a calmer workday)"
        description="We keep the experience simple: clear scope, predictable service, and communication that doesn’t disappear after the first visit."
      />

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-reveal-stagger="60">
        {/* Communication-first */}
        <div class="card card-hover relative overflow-hidden p-6 lg:p-8" data-reveal="up">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-px"
            style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.4) 50%, transparent);"
          >
          </div>
          <span
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border border-[rgb(var(--color-accent)/0.3)] bg-[rgb(var(--color-accent)/0.12)] text-[rgb(var(--color-accent-600))]"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-3 3v-3z"
              ></path>
            </svg>
          </span>
          <p class="text-strong text-sm font-semibold lg:text-base">Communication-first</p>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            You’ll know what’s happening—arrival, issues, and follow-ups—without chasing anyone
            down.
          </p>
        </div>

        {/* Respect for the space */}
        <div class="card card-hover relative overflow-hidden p-6 lg:p-8" data-reveal="up">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-px"
            style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.4) 50%, transparent);"
          >
          </div>
          <span
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border border-[rgb(var(--color-accent)/0.3)] bg-[rgb(var(--color-accent)/0.12)] text-[rgb(var(--color-accent-600))]"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </span>
          <p class="text-strong text-sm font-semibold lg:text-base">Respect for the space</p>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            We work around your operations and treat offices, medical suites, and shared areas with
            care.
          </p>
        </div>

        {/* Flexible scheduling */}
        <div class="card card-hover relative overflow-hidden p-6 lg:p-8" data-reveal="up">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-px"
            style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.4) 50%, transparent);"
          >
          </div>
          <span
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border border-[rgb(var(--color-accent)/0.3)] bg-[rgb(var(--color-accent)/0.12)] text-[rgb(var(--color-accent-600))]"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </span>
          <p class="text-strong text-sm font-semibold lg:text-base">Flexible scheduling</p>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            After-hours and weekend options where available—so cleaning fits your flow, not the
            other way around.
          </p>
        </div>
      </div>
    </div>
  </section>

  <AreasServed />

  <Footer slot="footer" />
</BaseLayout>
