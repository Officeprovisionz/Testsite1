---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { siteConfig } from '@/data/siteConfig';
import { makeHref } from '@/lib/nav';
import { makeMailtoHref } from '@/lib/links';

const href = makeHref(import.meta.env.BASE_URL);
const mailtoHref = makeMailtoHref(siteConfig.contact.email);
const vcardHref = href('office-provisionz.vcf');
---

<BaseLayout
  title={`Thanks – ${siteConfig.brand.name}`}
  description="Thanks for reaching out. We'll reply within 1 business day."
  noIndex
>
  <Header slot="header" />

  <section class="section section-creative">
    <div class="container-narrow">
      <div class="card relative overflow-hidden p-6 sm:p-8">
        <div
          aria-hidden="true"
          class="from-brand/10 to-brand/5 pointer-events-none absolute inset-0 bg-gradient-to-br via-transparent"
        >
        </div>

        <div class="relative">
          <Eyebrow>Request received</Eyebrow>
          <h1 class="heading-2 mt-2">Thanks — we’ve got it.</h1>
          <p class="lede">
            We’ll reply within <span class="text-strong font-semibold">1 business day</span> to confirm
            scope (often via a quick walkthrough) and send clear written pricing.
          </p>

          <div class="mt-6 hidden" data-lead-summary>
            <div class="panel panel-muted p-5">
              <p class="text-strong text-sm font-semibold">Your request summary</p>
              <dl class="mt-3 grid gap-2 text-sm">
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Reference</dt>
                  <dd class="text-strong font-semibold" data-lead-ref></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Company</dt>
                  <dd class="text-strong text-right" data-lead-company></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Location</dt>
                  <dd class="text-strong text-right" data-lead-location></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Industry</dt>
                  <dd class="text-strong text-right" data-lead-industry></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Frequency</dt>
                  <dd class="text-strong text-right" data-lead-frequency></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Services</dt>
                  <dd class="text-strong text-right" data-lead-services></dd>
                </div>
              </dl>
              <div class="mt-4 flex flex-col gap-2 sm:flex-row">
                <a class="btn-secondary w-full sm:w-auto" href={href('contact/')} data-edit-request>
                  Edit details
                </a>
                <button type="button" class="btn-secondary w-full sm:w-auto" data-copy-ref>
                  Copy reference
                </button>
              </div>
            </div>
          </div>

          <div class="mt-8 grid gap-4">
            <div class="panel panel-muted p-5">
              <p class="text-strong text-sm font-semibold">What happens next</p>
              <ol class="mt-2 grid gap-2 text-sm text-muted">
                <li>
                  <span class="text-strong font-semibold">1.</span> We confirm scope + schedule.
                </li>
                <li>
                  <span class="text-strong font-semibold">2.</span> You receive a written quote.
                </li>
                <li>
                  <span class="text-strong font-semibold">3.</span> We start service with a checklist.
                </li>
              </ol>
            </div>

            <div class="panel p-5">
              <p class="text-strong text-sm font-semibold">While you wait</p>
              <p class="mt-1 text-sm text-muted">
                Save our contact, add a quick follow-up reminder, or jump into our process
                checklist.
              </p>

              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <a class="btn-secondary w-full" href={vcardHref} data-haptic="true">
                  Save our contact (vCard)
                </a>
                <button
                  type="button"
                  class="btn-secondary w-full"
                  data-add-calendar
                  data-haptic="true"
                >
                  Add follow‑up reminder
                </button>
              </div>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <a class="btn-accent w-full sm:w-auto" href={href('checklist/')}>
                View our checklist
              </a>

              <div class="flex flex-col gap-2 sm:flex-row">
                <a class="btn-secondary w-full sm:w-auto" href={mailtoHref}>Email us</a>
              </div>
            </div>

            <p class="text-caption">
              If you don’t see our reply soon, check spam/junk and whitelist
              <span class="text-strong"> {siteConfig.contact.email}</span>.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a class="link link-muted" href={href('')}>Back to home</a>
      </div>
    </div>

    <script is:inline>
      (() => {
        const readLead = () => {
          try {
            const raw = window.sessionStorage?.getItem('damra_last_lead');
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            if (!parsed || typeof parsed !== 'object') return null;
            return parsed;
          } catch {
            return null;
          }
        };

        const setText = (sel, value) => {
          const el = document.querySelector(sel);
          if (!el) return;
          el.textContent = String(value || '');
        };

        const lead = readLead();
        const summary = document.querySelector('[data-lead-summary]');
        if (lead && summary instanceof HTMLElement) {
          summary.classList.remove('hidden');

          setText('[data-lead-ref]', lead.ref || '—');
          setText('[data-lead-company]', lead.companyName || '—');
          setText('[data-lead-location]', lead.location || '—');
          setText('[data-lead-industry]', lead.industry || '—');
          setText('[data-lead-frequency]', lead.frequency || '—');

          const services = Array.isArray(lead.servicesNeeded)
            ? lead.servicesNeeded.filter(Boolean).slice(0, 8)
            : [];
          setText('[data-lead-services]', services.length ? services.join(', ') : '—');

          // Build an edit link that reopens the contact form with key fields prefilled.
          const edit = document.querySelector('[data-edit-request]');
          if (edit instanceof HTMLAnchorElement) {
            try {
              const params = new URLSearchParams();
              if (lead.industry) params.set('industry', String(lead.industry));
              if (services.length) params.set('services', services.join(','));
              const url = new URL(edit.getAttribute('href') || '/contact/', window.location.origin);
              url.search = params.toString();
              url.hash = 'contact';
              edit.href = url.toString();
            } catch {
              // ignore
            }
          }

          const copy = document.querySelector('[data-copy-ref]');
          if (copy instanceof HTMLButtonElement) {
            copy.addEventListener('click', async () => {
              const ref = String(lead.ref || '').trim();
              if (!ref) return;
              try {
                await navigator.clipboard?.writeText(ref);
                copy.textContent = 'Copied!';
                window.setTimeout(() => (copy.textContent = 'Copy reference'), 1200);
              } catch {
                // ignore
              }
            });
          }
        }

        // Add a simple follow-up calendar reminder (ICS download) for 1 business day from now.
        const addCal = document.querySelector('[data-add-calendar]');
        if (addCal instanceof HTMLButtonElement) {
          addCal.addEventListener('click', () => {
            try {
              const now = new Date();
              const start = new Date(now.getTime());
              // Default to next day at 10:00 local.
              start.setDate(start.getDate() + 1);
              start.setHours(10, 0, 0, 0);
              const end = new Date(start.getTime() + 15 * 60 * 1000);

              const pad = (n) => String(n).padStart(2, '0');
              const fmt = (d) =>
                `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}T${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;

              const uid = `${Date.now()}@officeprovisionz`;
              const summary = 'Office Provisionz — quote follow-up';
              const desc = 'Reply / follow up on the quote request.';

              const ics =
                'BEGIN:VCALENDAR\r\n' +
                'VERSION:2.0\r\n' +
                'PRODID:-//Office Provisionz//DAMRA//EN\r\n' +
                'CALSCALE:GREGORIAN\r\n' +
                'METHOD:PUBLISH\r\n' +
                'BEGIN:VEVENT\r\n' +
                `UID:${uid}\r\n` +
                `DTSTAMP:${fmt(new Date())}\r\n` +
                `DTSTART:${fmt(start)}\r\n` +
                `DTEND:${fmt(end)}\r\n` +
                `SUMMARY:${summary}\r\n` +
                `DESCRIPTION:${desc}\r\n` +
                'END:VEVENT\r\n' +
                'END:VCALENDAR\r\n';

              const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url;
              a.download = 'office-provisionz-follow-up.ics';
              document.body.appendChild(a);
              a.click();
              a.remove();
              URL.revokeObjectURL(url);
            } catch {
              // ignore
            }
          });
        }

        try {
          window.damraTrack?.('lead_thanks_view', { path: window.location.pathname });
        } catch {
          // ignore
        }
      })();
    </script>
  </section>

  <Footer slot="footer" />
</BaseLayout>
