---
import { siteConfig } from '@/data/siteConfig';
import { makeMailtoHref, makeTelHref } from '@/lib/links';
import ContactForm from '@/components/ContactForm.astro';

type Props = {
  id?: string;
  heading?: string;
  description?: string;
  /**
   * `section` renders the full section with background + container.
   * `embed` renders a compact block (useful inside a page grid).
   */
  variant?: 'section' | 'embed';
  /** Hide the left-side info panel (phone/email/hours) and render only the form card. */
  showSidebar?: boolean;
};

const {
  id,
  heading = 'Talk to a local specialist',
  description = "Call for the fastest response, or send a quick request. We'll confirm scope (often via a walkthrough), then send a clear written quote.",
  variant = 'section',
  showSidebar = true,
} = Astro.props;

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const isDev = import.meta.env.DEV;
const telHref = makeTelHref(siteConfig.contact.phoneE164);
const mailtoTo = siteConfig.contact.email;
const mailtoHref = makeMailtoHref(siteConfig.contact.email);
const sourcePath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const successRedirect = `${base}thanks/`;

const industryOptions = [...siteConfig.industries.map((i) => i.title), 'Other / Not listed'];

const serviceOptions = [
  'Recurring Janitorial (Nightly/Weekly)',
  'Office Cleaning',
  'Deep / Detail Cleaning',
  'Day Porter / Daytime Upkeep',
  'Supplies & Restocking',
  'Facilities Support',
  'Move-In / Move-Out (Office Turnovers)',
  'Post-Construction Cleanup',
  'Other / Not sure',
];
---

<div class="contents">
  {
    variant === 'embed' ? (
      <div id={id} class="card relative overflow-hidden p-6 sm:p-7">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.12)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
        />
        <div class="relative">
          <h2 class="heading-3">{heading}</h2>
          {description ? <p class="mt-2 text-sm text-muted">{description}</p> : null}

          <ContactForm
            formEndpoint={formEndpoint}
            isDev={isDev}
            mailtoTo={mailtoTo}
            sourcePath={sourcePath}
            successRedirect={successRedirect}
            industryOptions={industryOptions}
            serviceOptions={serviceOptions}
          />
        </div>
      </div>
    ) : null
  }

  {
    variant !== 'embed' ? (
      <section id={id} class="section section-muted section-creative scroll-mt-20">
        <div class="container-page relative lg:max-w-6xl">
          <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-14 -z-10">
            <div class="mx-auto h-72 w-[min(74rem,96vw)] rounded-full bg-[rgb(var(--color-accent)/0.18)] blur-3xl" />
          </div>

          <div
            class:list={[
              'grid gap-10 lg:gap-16',
              showSidebar ? 'lg:grid-cols-2' : 'lg:grid-cols-1',
            ]}
          >
            {showSidebar ? (
              <div>
                <h2 class="heading-2 lg:text-4xl">{heading}</h2>
                <p class="lede lg:text-lg">{description}</p>

                <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                  <a
                    class="btn-primary w-full sm:w-auto"
                    href={telHref}
                    data-track="cta_click"
                    data-location="contact_sidebar"
                    data-action="call"
                    data-label="contact_call_primary"
                  >
                    Call now
                  </a>
                  <a
                    class="btn-secondary w-full sm:w-auto"
                    href={mailtoHref}
                    data-track="cta_click"
                    data-location="contact_sidebar"
                    data-action="email"
                    data-label="contact_email_secondary"
                  >
                    Email us
                  </a>
                </div>

                <div class="mt-6 space-y-3 text-sm text-muted">
                  <p>
                    <span class="text-strong font-semibold">Call/Text:</span>
                    <a class="decoration-brand/30 underline underline-offset-4" href={telHref}>
                      {siteConfig.contact.phoneDisplay}
                    </a>
                  </p>
                  <p>
                    <span class="text-strong font-semibold">Email:</span>
                    <a class="decoration-brand/30 underline underline-offset-4" href={mailtoHref}>
                      {siteConfig.contact.email}
                    </a>
                  </p>
                  <div>
                    <p class="text-strong font-semibold">Hours</p>
                    <ul class="mt-1 grid gap-1">
                      {siteConfig.hours.lines.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="card relative mt-8 overflow-hidden p-6">
                  <div
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.12)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
                  />
                  <div class="relative">
                    <p class="text-strong text-sm font-semibold">What happens next</p>
                    <ol class="mt-2 grid gap-2 text-sm text-muted">
                      <li>
                        <span class="text-strong font-semibold">1.</span> We reply within 1 business
                        day.
                      </li>
                      <li>
                        <span class="text-strong font-semibold">2.</span> We confirm scope, access,
                        and any special requirements.
                      </li>
                      <li>
                        <span class="text-strong font-semibold">3.</span> You get a clear, written
                        quote.
                      </li>
                    </ol>

                    <p class="text-subtle mt-3 text-xs">
                      This form includes a hidden anti-spam field. We only use your details to
                      respond to your request.
                    </p>
                  </div>
                </div>
              </div>
            ) : null}

            <div class="card relative overflow-hidden p-6 sm:p-7">
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.12)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
              />
              <div class="relative">
                <ContactForm
                  formEndpoint={formEndpoint}
                  isDev={isDev}
                  mailtoTo={mailtoTo}
                  sourcePath={sourcePath}
                  successRedirect={successRedirect}
                  industryOptions={industryOptions}
                  serviceOptions={serviceOptions}
                />
              </div>
            </div>
          </div>
        </div>
      </section>
    ) : null
  }
</div>

<script>
  // () => {
  const root = document.documentElement;

  const init = () => {
    const forms = Array.from(document.querySelectorAll<HTMLFormElement>('form[data-contact-form]'));
    if (!forms.length) return;

    const getParams = () => new URLSearchParams(window.location.search);

    const track = (event: string, props?: Record<string, unknown>) => {
      try {
        // Vendor-neutral hook (e.g. Plausible via window.plausible, GTM via dataLayer)
        // provided by the layout.
        window.damraTrack?.(event, props);
      } catch {
        // ignore
      }
    };

    const initForm = (form: HTMLFormElement) => {
      if (form.dataset.contactInit === 'true') return;
      form.dataset.contactInit = 'true';
      const endpoint = form.dataset.formEndpoint || '';

      // Lightweight spam mitigation (no CAPTCHA, no UI changes):
      // - record when the form became interactive
      // - enforce a minimal time-to-submit
      // - basic session-based rate limiting
      if (!form.dataset.contactStartedAt) {
        form.dataset.contactStartedAt = String(Date.now());
      }

      // Populate UTMs from sessionStorage or URL
      const utmKeys = [
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_term',
        'utm_content',
        'gclid',
        'fbclid',
        'msclkid',
      ];
      const params = getParams();
      utmKeys.forEach((key) => {
        const input = form.querySelector<HTMLInputElement>(`input[name="${key}"]`);
        if (input) {
          const val =
            params.get(key) ||
            (typeof sessionStorage !== 'undefined' ? sessionStorage.getItem(key) : '');
          if (val) input.value = val;
        }
      });

      const status = form.querySelector<HTMLElement>('[data-contact-status]');
      const submitBtn = form.querySelector<HTMLButtonElement>('[data-contact-submit]');
      const servicesBox = form.querySelector<HTMLElement>('[data-services-box]');
      const servicesError = form.querySelector<HTMLElement>('[data-services-error]');

      // Fast phone formatting
      const phoneInput = form.querySelector<HTMLInputElement>('input[name="phone"]');
      if (phoneInput) {
        phoneInput.addEventListener('input', (e) => {
          const input = e.target as HTMLInputElement;
          const raw = input.value.replace(/\D/g, '');
          if (raw.length <= 3) {
            input.value = raw;
          } else if (raw.length <= 6) {
            input.value = `(${raw.slice(0, 3)}) ${raw.slice(3)}`;
          } else {
            input.value = `(${raw.slice(0, 3)}) ${raw.slice(3, 6)}-${raw.slice(6, 10)}`;
          }
        });
      }

      type StatusKind = 'info' | 'success' | 'error';

      // Toast notification helper
      const showToast = (message: string, kind: StatusKind = 'info') => {
        if (
          typeof window !== 'undefined' &&
          (
            window as Window & {
              sonner?: {
                toast: {
                  success: (msg: string) => void;
                  error: (msg: string) => void;
                  (msg: string): void;
                };
              };
            }
          ).sonner
        ) {
          const toast = (
            window as Window & {
              sonner?: {
                toast: {
                  success: (msg: string) => void;
                  error: (msg: string) => void;
                  (msg: string): void;
                };
              };
            }
          ).sonner!.toast;
          if (kind === 'success') {
            toast.success(message);
          } else if (kind === 'error') {
            toast.error(message);
          } else {
            toast(message);
          }
        }
      };

      const escapeName = (value: string) => {
        try {
          if (window.CSS && typeof CSS.escape === 'function') return CSS.escape(String(value));
        } catch {
          // ignore
        }
        return String(value).replace(/["\\]/g, '\\$&');
      };

      const setStatus = (message: string, kind: StatusKind = 'info') => {
        if (!status) return;
        status.textContent = String(message);
        status.dataset.contactStatusKind = kind;
        status.classList.remove('hidden');

        // Visual styles via classes (kept simple and theme-safe).
        status.classList.remove(
          'text-muted',
          'border-app',
          'surface',
          'bg-brand/10',
          'border-brand/20',
          'text-strong',
          'bg-destructive/10',
          'border-destructive/20'
        );

        if (kind === 'success') {
          status.classList.add('bg-brand/10', 'border-brand/20', 'text-strong');
        } else if (kind === 'error') {
          status.classList.add('bg-destructive/10', 'border-destructive/20', 'text-strong');
        } else {
          status.classList.add('surface', 'border-app', 'text-muted');
        }

        // Also show toast notification for better visibility (especially on mobile)
        showToast(message, kind);
      };

      const setBusy = (busy: boolean) => {
        form.setAttribute('aria-busy', busy ? 'true' : 'false');
        if (submitBtn) {
          submitBtn.disabled = busy;
          submitBtn.classList.toggle('opacity-70', busy);
          submitBtn.classList.toggle('cursor-not-allowed', busy);
          submitBtn.textContent = busy ? 'Sending...' : 'Send request';
        }
      };

      // Save a small, non-sensitive summary for the Thanks page.
      // (We intentionally avoid storing the free-form message body.)
      const saveLeadSummary = (data: {
        companyName: string;
        name: string;
        email: string;
        phone: string;
        location: string;
        industry: string;
        frequency: string;
        servicesNeeded: string[];
        source: string;
      }) => {
        try {
          if (!window.sessionStorage) return;
          const ref = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}`;
          const payload = {
            ref,
            createdAt: Date.now(),
            companyName: data.companyName,
            name: data.name,
            email: data.email,
            phone: data.phone,
            location: data.location,
            industry: data.industry,
            frequency: data.frequency,
            servicesNeeded: data.servicesNeeded,
            source: data.source,
          };
          window.sessionStorage.setItem('damra_last_lead', JSON.stringify(payload));
        } catch {
          // ignore
        }
      };

      const focusFirstInvalid = () => {
        const el = form.querySelector<HTMLElement>(':invalid');
        el?.focus?.();
      };

      const setFieldInvalid = (name: string, invalid: boolean) => {
        const el = form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
          `[name="${escapeName(name)}"]`
        );
        if (!el) return;
        if (invalid) el.setAttribute('aria-invalid', 'true');
        else el.removeAttribute('aria-invalid');
      };

      const setServicesInvalid = (invalid: boolean) => {
        if (servicesBox) {
          if (invalid) {
            servicesBox.setAttribute('aria-invalid', 'true');
          } else {
            servicesBox.removeAttribute('aria-invalid');
          }
        }
        if (servicesError) {
          servicesError.classList.toggle('hidden', !invalid);
        }
      };

      const clearInvalidOnInput = () => {
        const watched = [
          'companyName',
          'name',
          'email',
          'location',
          'industry',
          'frequency',
          'message',
          'consent',
        ];
        watched.forEach((n) => {
          const el = form.querySelector(`[name="${escapeName(n)}"]`);
          if (!el) return;
          el.addEventListener('input', () => setFieldInvalid(n, false));
          el.addEventListener('change', () => setFieldInvalid(n, false));
        });

        // Checkbox group: clear group-level error as soon as the user checks anything.
        const boxes = Array.from(
          form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][name="servicesNeeded"]')
        );
        boxes.forEach((b) =>
          b.addEventListener('change', () => {
            if (boxes.some((x) => x.checked)) setServicesInvalid(false);
          })
        );
      };

      const prefillFromQuery = () => {
        const params = getParams();
        const industry = params.get('industry');
        if (industry) {
          const sel = form.querySelector<HTMLSelectElement>('select[name="industry"]');
          if (sel && Array.from(sel.options).some((o) => o.value === industry)) {
            sel.value = industry;
            sel.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }

        // Support both service=One and services=a,b,c
        const servicesRaw = params.get('services') || params.get('service') || '';
        if (servicesRaw) {
          servicesRaw
            .split(',')
            .map((v) => v.trim())
            .filter(Boolean)
            .forEach((value) => {
              const box = form.querySelector<HTMLInputElement>(
                `input[type="checkbox"][name="servicesNeeded"][value="${escapeName(value)}"]`
              );
              if (box) box.checked = true;
            });
        }
      };

      const applyAttributionToForm = () => {
        const keys = [
          'utm_source',
          'utm_medium',
          'utm_campaign',
          'utm_content',
          'utm_term',
          'gclid',
          'fbclid',
          'msclkid',
        ] as const;

        type Key = (typeof keys)[number];

        const readStored = (): Partial<Record<Key, string>> => {
          try {
            const raw = window.sessionStorage?.getItem('damra_campaign');
            if (!raw) return {};
            const parsed = JSON.parse(raw) as unknown;
            if (!parsed || typeof parsed !== 'object') return {};
            const out: Partial<Record<Key, string>> = {};
            keys.forEach((k) => {
              const v = (parsed as Record<string, unknown>)[k];
              if (typeof v === 'string' && v.trim()) out[k] = v;
            });
            return out;
          } catch {
            return {};
          }
        };

        const writeStored = (data: Partial<Record<Key, string>>) => {
          try {
            if (!window.sessionStorage) return;
            window.sessionStorage.setItem('damra_campaign', JSON.stringify(data));
          } catch {
            // ignore
          }
        };

        const params = getParams();
        const stored = readStored();
        const merged: Partial<Record<Key, string>> = { ...stored };

        keys.forEach((k) => {
          const v = params.get(k);
          if (v && v.trim()) merged[k] = v.trim();
        });

        if (Object.keys(merged).length) writeStored(merged);

        const setHidden = (name: string, value: string) => {
          const el = form.querySelector<HTMLInputElement>(
            `input[type="hidden"][name="${escapeName(name)}"]`
          );
          if (!el) return;
          el.value = value;
        };

        keys.forEach((k) => setHidden(k, merged[k] ?? ''));

        // Referrer / landing page (useful even without UTMs)
        const referrer = (() => {
          try {
            return document.referrer || '';
          } catch {
            return '';
          }
        })();
        const landing = (() => {
          try {
            return window.location.href.split('#')[0] || '';
          } catch {
            return '';
          }
        })();

        setHidden('referrer', referrer);
        setHidden('landing', landing);
      };

      applyAttributionToForm();
      prefillFromQuery();
      clearInvalidOnInput();

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const to = form.dataset.mailtoTo || '';
        if (!to) {
          setStatus('Email address not configured. Please call/text instead.');
          return;
        }

        const fd = new FormData(form);

        // Simple honeypot check
        if (fd.get('website_url') || fd.get('website')) {
          console.warn('Honeypot filled; likely bot.');
          setStatus('Thank you for your message.', 'success');
          return;
        }

        const source = String(fd.get('source') ?? '').trim();

        const startedAt = Number(form.dataset.contactStartedAt || '0') || 0;
        const timeToSubmitMs = startedAt ? Math.max(0, Date.now() - startedAt) : undefined;

        const enforceRateLimit = () => {
          try {
            if (!window.sessionStorage) return { blocked: false } as const;
            const key = 'damra_lead_submit_ts';
            const now = Date.now();
            const windowMs = 10 * 60 * 1000; // 10 minutes
            const maxInWindow = 3;

            const raw = window.sessionStorage.getItem(key);
            const parsed = raw ? (JSON.parse(raw) as unknown) : [];
            const arr = Array.isArray(parsed)
              ? parsed.map((v) => Number(v)).filter((n) => Number.isFinite(n))
              : [];

            const kept = arr.filter((t) => now - t < windowMs);
            if (kept.length >= maxInWindow) {
              window.sessionStorage.setItem(key, JSON.stringify(kept));
              return { blocked: true, reason: 'rate_limit' } as const;
            }

            kept.push(now);
            window.sessionStorage.setItem(key, JSON.stringify(kept));
            return { blocked: false } as const;
          } catch {
            return { blocked: false } as const;
          }
        };
        const companyName = String(fd.get('companyName') ?? '').trim();
        const name = String(fd.get('name') ?? '').trim();
        const email = String(fd.get('email') ?? '').trim();
        const phone = String(fd.get('phone') ?? '').trim();
        // const contactMethod = String(fd.get('contactMethod') ?? '').trim();
        const location = String(fd.get('location') ?? '').trim();
        const industry = String(fd.get('industry') ?? '').trim();
        const frequency = String(fd.get('frequency') ?? '').trim();
        // const startTiming = String(fd.get('startTiming') ?? '').trim();
        const servicesNeeded = fd
          .getAll('servicesNeeded')
          .map((v) => String(v).trim())
          .filter(Boolean);
        const consent = String(fd.get('consent') ?? '').trim();
        const message = String(fd.get('message') ?? '').trim();
        const honeypot = String(fd.get('website') ?? '').trim();

        const utmSource = String(fd.get('utm_source') ?? '').trim();
        const utmMedium = String(fd.get('utm_medium') ?? '').trim();
        const utmCampaign = String(fd.get('utm_campaign') ?? '').trim();

        track('lead_submit', {
          source,
          industry,
          frequency,
          hasPhone: Boolean(phone),
          servicesCount: servicesNeeded.length,
          via: endpoint ? 'endpoint' : 'mailto',
          utmSource: utmSource || undefined,
          utmMedium: utmMedium || undefined,
          utmCampaign: utmCampaign || undefined,
          timeToSubmitMs,
        });

        // Simple bot check: if honeypot is filled, do nothing.
        if (honeypot) {
          setStatus('Thanks!', 'success');
          return;
        }

        // Time-to-submit check: blocks ultra-fast submissions (typical of bots).
        // Keep threshold low to avoid impacting real users.
        if (typeof timeToSubmitMs === 'number' && timeToSubmitMs < 900) {
          setStatus('Please take a moment to review the form, then submit again.', 'error');
          track('lead_submit_blocked', { source, reason: 'fast_submit', timeToSubmitMs });
          return;
        }

        // Session rate limiting: prevents repeated rapid submissions.
        const rate = enforceRateLimit();
        if (rate.blocked) {
          setStatus(
            'Too many requests in a short time. Please wait a few minutes, or call/text for the fastest response.',
            'error'
          );
          track('lead_submit_blocked', { source, reason: 'rate_limit' });
          return;
        }

        if (
          !companyName ||
          !name ||
          !email ||
          !location ||
          !industry ||
          !frequency ||
          !message ||
          !consent ||
          !servicesNeeded.length
        ) {
          setFieldInvalid('companyName', !companyName);
          setFieldInvalid('name', !name);
          setFieldInvalid('email', !email);
          setFieldInvalid('location', !location);
          setFieldInvalid('industry', !industry);
          setFieldInvalid('frequency', !frequency);
          setFieldInvalid('message', !message);
          setFieldInvalid('consent', !consent);
          setServicesInvalid(!servicesNeeded.length);

          setStatus(
            'Please fill in the required fields (company, contact name, email, location, industry, frequency, services needed, consent, and notes).',
            'error'
          );
          focusFirstInvalid();

          if (!servicesNeeded.length) {
            const firstService = form.querySelector<HTMLInputElement>(
              'input[type="checkbox"][name="servicesNeeded"]'
            );
            firstService?.focus?.();
          }
          return;
        }

        // Clear any previous group-level error.
        setServicesInvalid(false);

        setBusy(true);
        setStatus('Sending...', 'info');

        try {
          if (endpoint && endpoint.startsWith('http')) {
            const payload: Record<string, unknown> = {};

            // Serialize non-array fields
            fd.forEach((value, key) => {
              // Keep honeypot fields out of the payload.
              if (key === 'website_url' || key === 'website') return;
              if (key === 'servicesNeeded') return;
              payload[key] = String(value);
            });

            // Preserve multi-select services
            payload.servicesNeeded = servicesNeeded;

            const res = await fetch(endpoint, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              body: JSON.stringify(payload),
            });

            if (!res.ok) {
              throw new Error('Could not send message. Please try again.');
            }

            setBusy(false);
            setStatus("Quote request received - we'll reply within 1 business day.", 'success');

            saveLeadSummary({
              companyName,
              name,
              email,
              phone,
              location,
              industry,
              frequency,
              servicesNeeded,
              source,
            });

            form.reset();
            applyAttributionToForm();
            track('lead_submit_success', { source, via: 'endpoint' });

            const redirect = form.dataset.successRedirect || '';
            if (redirect) {
              window.setTimeout(() => {
                try {
                  window.location.assign(redirect);
                } catch {
                  // ignore
                }
              }, 650);
            }
            return;
          }

          // No endpoint configured: fall back to mailto.
          const subject = `Quote request - ${companyName || 'Office Provisionz'}`;
          const bodyLines = [
            `Company: ${companyName}`,
            `Name: ${name}`,
            `Email: ${email}`,
            phone ? `Phone: ${phone}` : '',
            `Location: ${location}`,
            `Industry: ${industry}`,
            `Frequency: ${frequency}`,
            servicesNeeded.length ? `Services needed: ${servicesNeeded.join(', ')}` : '',
            '',
            'Notes:',
            message,
            '',
            source ? `Source: ${source}` : '',
          ].filter(Boolean);

          const mailto =
            `mailto:${encodeURIComponent(to)}` +
            `?subject=${encodeURIComponent(subject)}` +
            `&body=${encodeURIComponent(bodyLines.join('\n'))}`;

          try {
            window.location.assign(mailto);
          } catch {
            try {
              window.open(mailto, '_blank', 'noopener,noreferrer');
            } catch {
              // ignore
            }
          }

          setBusy(false);
          setStatus('Opening your email app...', 'success');
          track('lead_submit_success', { source, via: 'mailto' });
        } catch (err) {
          setBusy(false);
          const msg = err instanceof Error ? err.message : 'Something went wrong.';
          setStatus(msg, 'error');
          track('lead_submit_error', {
            source,
            via: endpoint ? 'endpoint' : 'mailto',
            message: msg,
          });
        }
      });
    };

    forms.forEach(initForm);
  };

  if (root.dataset.contactFormListen !== 'true') {
    root.dataset.contactFormListen = 'true';
    document.addEventListener('astro:page-load', init);
  }

  init();
  // })();
</script>
