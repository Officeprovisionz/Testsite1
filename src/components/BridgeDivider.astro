---
type Props = {
  class?: string;
};

const { class: className } = Astro.props;

// Stylized Golden Gate Bridge divider (lightweight SVG)
const internationalOrange = '#C0362C';
const viewWidth = 1000;
const deckY = 64;
// Anchorages sit higher than the deck; keep them fairly high so the side spans read correctly.
const anchorY = 18;
// Towers should feel tall within this short viewBox.
const towerTopY = 6;
// Wider separation makes the main span feel like the real Golden Gate.
const leftTowerX = 150;
const rightTowerX = 850;

const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
const lerp = (a: number, b: number, t: number) => a * (1 - t) + b * t;

const cableY = (x: number, offset = 0) => {
  // Piecewise curve: side spans (anchors -> towers) + main span (tower -> tower).
  const o = offset;
  const sideSag = 7;
  // Deep enough to read like the Golden Gate, but never touches the deck.
  const mainSag = 56;
  const catenaryK = 2.05;
  if (x <= leftTowerX) {
    const t = clamp01(x / leftTowerX);
    // Side span: mostly a line, with a small sag to avoid looking like a straight ramp.
    const line = lerp(anchorY + o, towerTopY + o, t);
    return line + sideSag * 4 * t * (1 - t);
  }

  if (x >= rightTowerX) {
    const t = clamp01((viewWidth - x) / (viewWidth - rightTowerX));
    const line = lerp(anchorY + o, towerTopY + o, t);
    return line + sideSag * 4 * t * (1 - t);
  }

  const mid = (leftTowerX + rightTowerX) / 2;
  const half = (rightTowerX - leftTowerX) / 2;
  const n = (x - mid) / half;
  // Catenary-style curve: flatter mid-span, steeper near towers.
  // n is normalized [-1..1]. We invert the catenary so max drop is at n=0.
  const denom = Math.cosh(catenaryK) - 1;
  const ratio = denom === 0 ? 0 : (Math.cosh(catenaryK * n) - 1) / denom;
  return towerTopY + o + mainSag * (1 - ratio);
};

type Pt = { x: number; y: number };

const cablePoints = (offset = 0): Pt[] => {
  const xs = new Set<number>();
  const step = 18;
  for (let x = 0; x <= viewWidth; x += step) xs.add(x);
  // Ensure key silhouette points are always included.
  xs.add(leftTowerX);
  xs.add(rightTowerX);
  xs.add((leftTowerX + rightTowerX) / 2);

  return Array.from(xs)
    .sort((a, b) => a - b)
    .map((x) => ({ x, y: cableY(x, offset) }));
};

const catmullRomToBezierPath = (pts: Pt[]) => {
  const first = pts[0];
  if (!first || pts.length < 2) return '';
  let d = `M ${first.x} ${first.y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p1 = pts[i]!;
    const p2 = pts[i + 1]!;
    const p0 = pts[i - 1] ?? p1;
    const p3 = pts[i + 2] ?? p2;

    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${c1x} ${c1y}, ${c2x} ${c2y}, ${p2.x} ${p2.y}`;
  }
  return d;
};

const cablePath = (offset = 0) => catmullRomToBezierPath(cablePoints(offset));
---

<div class:list={['pointer-events-none py-8 md:py-10 lg:py-12', className]} aria-hidden="true">
  <div class="container-page">
    <div style={`color: ${internationalOrange};`} class="opacity-90 dark:opacity-75">
      <svg
        width="100%"
        viewBox="0 0 1000 70"
        preserveAspectRatio="none"
        role="presentation"
        class="h-[78px] w-full opacity-95 sm:h-[86px] md:h-[102px] lg:h-[112px]"
      >
        <defs>
          <!-- Keep everything within International Orange, but add a touch of depth. -->
          <linearGradient
            id="gg-stroke"
            x1="0"
            y1="0"
            x2="1000"
            y2="0"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0%" stop-color="#B73227"></stop>
            <stop offset="50%" stop-color="#D34A3B"></stop>
            <stop offset="100%" stop-color="#B73227"></stop>
          </linearGradient>
          <linearGradient
            id="gg-stroke-soft"
            x1="0"
            y1="0"
            x2="0"
            y2="70"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0%" stop-color="#D95A49" stop-opacity="0.95"></stop>
            <stop offset="100%" stop-color="#A92A20" stop-opacity="0.95"></stop>
          </linearGradient>

          <!-- Neutral fog band (keeps the bridge orange but adds SF vibe). -->
          <linearGradient id="gg-fog" x1="0" y1="38" x2="0" y2="70" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0"></stop>
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.12"></stop>
          </linearGradient>
        </defs>

        <!-- Fog / atmosphere layer behind the structure -->
        <rect x="0" y="34" width={viewWidth} height="36" fill="url(#gg-fog)"></rect>

        <!-- Anchorages (hint of the massive concrete blocks) -->
        <g fill="currentColor" opacity="0.12">
          <path d={`M 0 ${anchorY + 9} L 76 ${anchorY + 6} L 98 ${deckY} L 0 ${deckY} Z`}></path>
          <path
            d={`M ${viewWidth} ${anchorY + 9} L ${viewWidth - 76} ${anchorY + 6} L ${viewWidth - 98} ${deckY} L ${viewWidth} ${deckY} Z`}
          ></path>
        </g>

        <!-- Main suspension cable -->
        <!-- Rear cable (subtle depth, close to main) -->
        <path
          d={cablePath(1.6)}
          fill="none"
          stroke="url(#gg-stroke-soft)"
          stroke-width="2.2"
          stroke-linecap="round"
          opacity="0.28"></path>

        <!-- Main suspension cable -->
        <path
          d={cablePath(0)}
          fill="none"
          stroke="url(#gg-stroke)"
          stroke-width="3"
          stroke-linecap="round"
          opacity="0.92"></path>

        <!-- Cable highlight (adds roundness without changing color family) -->
        <path
          d={cablePath(-0.9)}
          fill="none"
          stroke="#F07B69"
          stroke-width="1"
          stroke-linecap="round"
          opacity="0.14"></path>

        <!-- Cable saddles on tower tops -->
        <g stroke="currentColor" fill="none" opacity="0.55" stroke-linecap="round">
          <path
            d={`M ${leftTowerX - 26} ${towerTopY + 2} Q ${leftTowerX} ${towerTopY - 2} ${leftTowerX + 26} ${towerTopY + 2}`}
            stroke-width="1.1"></path>
          <path
            d={`M ${rightTowerX - 26} ${towerTopY + 2} Q ${rightTowerX} ${towerTopY - 2} ${rightTowerX + 26} ${towerTopY + 2}`}
            stroke-width="1.1"></path>
        </g>

        <!-- Towers (iconic silhouette) -->
        <g stroke="url(#gg-stroke-soft)" fill="none" stroke-linecap="round" opacity="0.75">
          <!-- Left tower -->
          <g stroke-width="2">
            <line x1={leftTowerX - 18} y1={towerTopY + 2} x2={leftTowerX - 18} y2={deckY}></line>
            <line x1={leftTowerX + 18} y1={towerTopY + 2} x2={leftTowerX + 18} y2={deckY}></line>
            <line x1={leftTowerX - 20} y1={towerTopY + 2} x2={leftTowerX + 20} y2={towerTopY + 2}
            ></line>
            <line x1={leftTowerX - 16} y1={towerTopY + 18} x2={leftTowerX + 16} y2={towerTopY + 18}
            ></line>
            <line x1={leftTowerX - 16} y1={towerTopY + 32} x2={leftTowerX + 16} y2={towerTopY + 32}
            ></line>
            <line x1={leftTowerX - 14} y1={towerTopY + 18} x2={leftTowerX - 14} y2={deckY}></line>
            <line x1={leftTowerX + 14} y1={towerTopY + 18} x2={leftTowerX + 14} y2={deckY}></line>
          </g>

          <!-- Left tower portals (openings) -->
          <g stroke="currentColor" opacity="0.28" stroke-width="1.2">
            <rect x={leftTowerX - 11} y={towerTopY + 22} width="22" height="10" rx="2"></rect>
            <rect x={leftTowerX - 11} y={towerTopY + 38} width="22" height="16" rx="2"></rect>
          </g>

          <!-- Left tower internal bracing -->
          <g stroke="currentColor" opacity="0.25" stroke-width="1">
            <line x1={leftTowerX - 14} y1={towerTopY + 18} x2={leftTowerX + 14} y2={towerTopY + 32}
            ></line>
            <line x1={leftTowerX + 14} y1={towerTopY + 18} x2={leftTowerX - 14} y2={towerTopY + 32}
            ></line>
            <line x1={leftTowerX - 14} y1={towerTopY + 34} x2={leftTowerX + 14} y2={deckY - 10}
            ></line>
            <line x1={leftTowerX + 14} y1={towerTopY + 34} x2={leftTowerX - 14} y2={deckY - 10}
            ></line>
          </g>

          <!-- Right tower -->
          <g stroke-width="2">
            <line x1={rightTowerX - 18} y1={towerTopY + 2} x2={rightTowerX - 18} y2={deckY}></line>
            <line x1={rightTowerX + 18} y1={towerTopY + 2} x2={rightTowerX + 18} y2={deckY}></line>
            <line x1={rightTowerX - 20} y1={towerTopY + 2} x2={rightTowerX + 20} y2={towerTopY + 2}
            ></line>
            <line
              x1={rightTowerX - 16}
              y1={towerTopY + 18}
              x2={rightTowerX + 16}
              y2={towerTopY + 18}></line>
            <line
              x1={rightTowerX - 16}
              y1={towerTopY + 32}
              x2={rightTowerX + 16}
              y2={towerTopY + 32}></line>
            <line x1={rightTowerX - 14} y1={towerTopY + 18} x2={rightTowerX - 14} y2={deckY}></line>
            <line x1={rightTowerX + 14} y1={towerTopY + 18} x2={rightTowerX + 14} y2={deckY}></line>
          </g>

          <!-- Right tower portals (openings) -->
          <g stroke="currentColor" opacity="0.28" stroke-width="1.2">
            <rect x={rightTowerX - 11} y={towerTopY + 22} width="22" height="10" rx="2"></rect>
            <rect x={rightTowerX - 11} y={towerTopY + 38} width="22" height="16" rx="2"></rect>
          </g>

          <!-- Right tower internal bracing -->
          <g stroke="currentColor" opacity="0.25" stroke-width="1">
            <line
              x1={rightTowerX - 14}
              y1={towerTopY + 18}
              x2={rightTowerX + 14}
              y2={towerTopY + 32}></line>
            <line
              x1={rightTowerX + 14}
              y1={towerTopY + 18}
              x2={rightTowerX - 14}
              y2={towerTopY + 32}></line>
            <line x1={rightTowerX - 14} y1={towerTopY + 34} x2={rightTowerX + 14} y2={deckY - 10}
            ></line>
            <line x1={rightTowerX + 14} y1={towerTopY + 34} x2={rightTowerX - 14} y2={deckY - 10}
            ></line>
          </g>
        </g>

        <!-- Vertical hangers (skip tower bays) -->
        <g stroke="currentColor" stroke-width="0.75" opacity="0.35">
          {
            Array.from({ length: 92 }).map((_, i) => {
              const start = 40;
              const end = viewWidth - 40;
              const step = (end - start) / 91;
              const x = start + i * step;
              // Avoid drawing hangers through the tower legs.
              const nearLeftTower = Math.abs(x - leftTowerX) < 36;
              const nearRightTower = Math.abs(x - rightTowerX) < 36;
              if (nearLeftTower || nearRightTower) return null;
              const y = cableY(x, 0);
              // Only draw if above deck (sanity guard).
              if (y >= deckY - 1) return null;
              // Slight variation helps it feel less "computer-perfect".
              const jitter = (i % 3) * 0.25;
              return (
                <g>
                  <line x1={x} y1={y + jitter} x2={x} y2={deckY - 1} />
                  {/* Small clamp dot at the deck connection */}
                  <circle cx={x} cy={deckY - 1} r="0.85" fill="currentColor" opacity="0.45" />
                </g>
              );
            })
          }
        </g>

        <!-- Road deck + subtle truss -->
        <g stroke="currentColor" fill="none" opacity="0.22">
          <line x1="0" y1={deckY} x2="1000" y2={deckY} stroke-width="2.6" opacity="0.95"></line>
          <line x1="0" y1={deckY + 3} x2="1000" y2={deckY + 3} stroke-width="1.2" opacity="0.85"
          ></line>
          <path
            d={`M 0 ${deckY + 3} L 60 ${deckY + 1} L 120 ${deckY + 3} L 180 ${deckY + 1} L 240 ${deckY + 3} L 300 ${deckY + 1} L 360 ${deckY + 3} L 420 ${deckY + 1} L 480 ${deckY + 3} L 540 ${deckY + 1} L 600 ${deckY + 3} L 660 ${deckY + 1} L 720 ${deckY + 3} L 780 ${deckY + 1} L 840 ${deckY + 3} L 900 ${deckY + 1} L 960 ${deckY + 3} L 1000 ${deckY + 1}`}
            stroke-width="0.9"
            opacity="0.55"></path>
        </g>
      </svg>
    </div>
  </div>
</div>
