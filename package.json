{
  "name": "cleaning-landing",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:pages": "node scripts/run-pages.mjs dev",
    "build": "astro build",
    "build:pages": "node scripts/run-pages.mjs build",
    "preview": "astro preview",
    "preview:pages": "node scripts/run-pages.mjs preview",
    "simulate:pages": "node scripts/simulate-pages.mjs",
    "gallery:fetch": "node scripts/fetch-gallery.mjs",
    "gallery:variants": "node scripts/generate-gallery-variants.mjs",
    "gallery:metadata": "node scripts/generate-image-metadata.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "check:copy": "node scripts/check-mojibake.mjs",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:a11y": "playwright test a11y.spec.ts",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "check": "bun run format && bun run lint && bun run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/astro": "^10.38.0",
    "@sentry/browser": "^10.38.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.17.1",
    "astro-icon": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.16",
    "lucide-react": "^0.563.0",
    "mini-svg-data-uri": "^1.4.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "9.39.2",
    "@iconify-json/lucide": "^1.2.87",
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.0.18",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "postcss": "8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "sharp": "^0.34.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix"
    ]
  },
  "volta": {
    "node": "24.13.0"
  }
}
