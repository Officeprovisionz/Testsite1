---
import { siteConfig } from '@/data/siteConfig';
import WaveDivider from '@/components/WaveDivider.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Eyebrow from './ui/Eyebrow.astro';

type Step = {
  title: string;
  description: string;
};

const {
  id,
  heading = 'How it works',
  description = 'A simple, repeatable process that keeps service consistent across visits.',
  showWave = true,
  waveTone = 'bg',
  steps = siteConfig.processSteps,
  qaEyebrow = 'Quality assurance',
  qaHeading = 'Checklist-based scope. Quick follow-through.',
  qaDescription = 'We keep scope clear and consistent with checklists—so you can delegate cleaning without babysitting it.',
  qaBullets = [
    'Clear inclusions + add-ons (no surprises)',
    'Single point of contact for requests',
    'Walkthrough notes + quick follow-up',
  ],
} = Astro.props as {
  id?: string;
  heading?: string;
  description?: string;
  showWave?: boolean;
  waveTone?: 'surface' | 'surface-muted' | 'bg';
  steps?: Step[];
  qaEyebrow?: string;
  qaHeading?: string;
  qaDescription?: string;
  qaBullets?: string[];
};

const safeWaveTone =
  waveTone === 'surface' || waveTone === 'surface-muted' || waveTone === 'bg' ? waveTone : 'bg';
---

<section id={id} class="section section-muted section-creative scroll-mt-20 pb-0">
  <div class="container-page relative lg:max-w-6xl">
    <SectionHeader heading={heading} description={description} />

    <ol class="mt-10 grid gap-4 lg:mt-12 lg:grid-cols-4 lg:gap-5" data-reveal-stagger="70">
      {
        (Array.isArray(steps) ? steps : []).map((s, idx) => (
          <li class="card card-hover relative overflow-hidden p-5 sm:p-6" data-reveal="up">
            {/* Subtle background glow */}
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 bg-linear-to-br from-[rgb(var(--color-accent)/0.1)] via-transparent to-[rgb(var(--color-brand)/0.07)]"
            />
            <div class="relative">
              {/* Step number */}
              <div class="mb-3.5 flex items-center gap-3">
                <span
                  class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-sm font-bold lg:h-10 lg:w-10 lg:text-base"
                  style="background: linear-gradient(135deg, rgb(var(--color-accent-300)), rgb(var(--color-accent-500))); color: rgb(14 10 4); box-shadow: 0 2px 8px -3px rgb(var(--color-accent-500)/0.4);"
                  aria-hidden="true"
                >
                  {idx + 1}
                </span>
                <p class="text-strong text-sm leading-tight font-semibold lg:text-[0.9375rem]">
                  {s.title}
                </p>
              </div>
              <p class="text-muted text-sm leading-relaxed">{s.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- QA panel -->
    <div class="card mt-8 overflow-hidden p-6 sm:p-8 lg:mt-10 lg:p-10" data-reveal="up">
      {/* Top accent line */}
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-px"
        style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.4) 40%, rgb(var(--color-brand-400)/0.3) 60%, transparent);"
      >
      </div>
      <div class="grid gap-6 md:grid-cols-2 md:items-center lg:gap-10">
        <div>
          <Eyebrow>{qaEyebrow}</Eyebrow>
          <p
            class="text-strong mt-1 text-lg leading-snug font-semibold lg:text-xl"
            style="letter-spacing: -0.015em;"
          >
            {qaHeading}
          </p>
          <p class="text-muted mt-2.5 text-sm leading-relaxed lg:text-[0.9375rem]">
            {qaDescription}
          </p>
        </div>
        <ul class="check-list check-list--compact text-muted text-sm lg:text-[0.9375rem]">
          {
            (Array.isArray(qaBullets) ? qaBullets : []).map((b) => (
              <li>
                <span class="check-icon check-icon--sm" aria-hidden="true">
                  ✓
                </span>
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  {
    showWave ? (
      <div class="relative mt-12 -mb-px">
        <WaveDivider tone={safeWaveTone} class="absolute right-0 bottom-0 left-0" />
      </div>
    ) : null
  }
</section>
