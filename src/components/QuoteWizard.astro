---
import type { SiteConfig } from '@/data/siteConfig';

type Props = {
  industryOptions: SiteConfig['industries'][number]['title'][];
  serviceOptions: string[];
};

const { industryOptions, serviceOptions } = Astro.props;
const frequencyOptions = [
  'One-time',
  'Weekly',
  '2-3x / week',
  'Daily',
  'Day porter',
  'Not sure',
  'Custom',
];
const startTimingOptions = ['ASAP', 'Within 2 weeks', 'Within a month', 'Just researching'];
---

<section class="section section-creative scroll-mt-20" id="quick-quote">
  <div class="container-page">
    <div class="card relative overflow-hidden p-6 sm:p-7">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.12)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
      >
      </div>

      <div class="relative flex flex-col gap-6">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-subtle text-xs font-semibold uppercase tracking-[0.08em]">
              3-step quote wizard
            </p>
            <h2 class="heading-3 mt-1">Get scoped fast</h2>
            <p class="text-sm text-muted">
              Capture the essentials in three steps. We'll prefill the full contact form so you can
              review, edit, and send - no duplicate typing.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3" role="list" aria-label="Progress">
          {
            ['Basics', 'Services', 'Contact'].map((label, idx) => (
              <div class="wizard-stepper" data-progress-step={idx + 1} role="listitem">
                <span class="wizard-stepper__dot" aria-hidden="true">
                  {idx + 1}
                </span>
                <span class="wizard-stepper__label text-xs font-semibold text-muted">{label}</span>
              </div>
            ))
          }
        </div>

        <form class="grid gap-6" data-quote-wizard novalidate>
          <div class="grid gap-4" data-step="1">
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1 text-sm">
                <span class="text-strong font-semibold">Company / Organization *</span>
                <input
                  class="input"
                  type="text"
                  name="wizard-company"
                  autocomplete="organization"
                  required
                  aria-required="true"
                />
              </label>
              <label class="grid gap-1 text-sm">
                <span class="text-strong font-semibold">Location (city / zip) *</span>
                <input
                  class="input"
                  type="text"
                  name="wizard-location"
                  autocomplete="address-level2"
                  required
                  aria-required="true"
                />
              </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
              <label class="grid gap-1 text-sm sm:col-span-1">
                <span class="text-strong font-semibold">Approx. size (sq ft)</span>
                <input
                  class="input"
                  type="number"
                  min="0"
                  step="100"
                  name="wizard-size"
                  inputmode="numeric"
                  placeholder="2500"
                />
              </label>

              <label class="grid gap-1 text-sm sm:col-span-1">
                <span class="text-strong font-semibold">Industry *</span>
                <select class="select" name="wizard-industry" required aria-required="true">
                  <option value="">Select an industry</option>
                  {industryOptions.map((opt) => <option value={opt}>{opt}</option>)}
                  <option value="Other / Not listed">Other / Not listed</option>
                </select>
              </label>

              <label class="grid gap-1 text-sm sm:col-span-1">
                <span class="text-strong font-semibold">Cleaning frequency *</span>
                <select class="select" name="wizard-frequency" required aria-required="true">
                  <option value="">Select a frequency</option>
                  {frequencyOptions.map((opt) => <option value={opt}>{opt}</option>)}
                </select>
              </label>
            </div>

            <div class="flex flex-wrap gap-3">
              <button class="btn-secondary w-full sm:w-auto" type="button" data-next-step>
                Next: services
              </button>
            </div>
          </div>

          <div class="grid gap-4" data-step="2">
            <fieldset class="grid gap-2 text-sm" aria-describedby="wizard-services-help">
              <legend class="text-strong font-semibold">Services needed *</legend>
              <p id="wizard-services-help" class="text-subtle text-xs">
                Pick all that apply. We'll confirm scope during quoting.
              </p>
              <div class="wizard-services-box border p-3" data-wizard-services>
                <div class="grid gap-2 sm:grid-cols-2">
                  {
                    serviceOptions.map((opt) => (
                      <label class="flex cursor-pointer items-start gap-2">
                        <input
                          class="checkbox mt-1"
                          type="checkbox"
                          name="wizard-services"
                          value={opt}
                        />
                        <span class="text-muted">{opt}</span>
                      </label>
                    ))
                  }
                </div>
              </div>
            </fieldset>

            <label class="grid gap-1 text-sm">
              <span class="text-strong font-semibold">Timing</span>
              <select class="select" name="wizard-timing">
                {startTimingOptions.map((opt) => <option value={opt}>{opt}</option>)}
              </select>
            </label>

            <div class="flex flex-wrap gap-3">
              <button class="btn-secondary w-full sm:w-auto" type="button" data-prev-step>
                Back
              </button>
              <button class="btn-secondary w-full sm:w-auto" type="button" data-next-step>
                Next: contact
              </button>
            </div>
          </div>

          <div class="grid gap-4" data-step="3">
            <div class="grid gap-4 sm:grid-cols-3">
              <label class="grid gap-1 text-sm">
                <span class="text-strong font-semibold">Contact name *</span>
                <input
                  class="input"
                  type="text"
                  name="wizard-name"
                  autocomplete="name"
                  required
                  aria-required="true"
                />
              </label>
              <label class="grid gap-1 text-sm">
                <span class="text-strong font-semibold">Email *</span>
                <input
                  class="input"
                  type="email"
                  name="wizard-email"
                  autocomplete="email"
                  required
                  aria-required="true"
                />
              </label>
              <label class="grid gap-1 text-sm">
                <span class="text-strong font-semibold">Phone</span>
                <input class="input" type="tel" name="wizard-phone" autocomplete="tel" />
              </label>
            </div>

            <label class="grid gap-1 text-sm">
              <span class="text-strong font-semibold">Notes / priorities</span>
              <textarea
                class="textarea min-h-24"
                name="wizard-notes"
                placeholder="Access details, scheduling constraints, priorities."></textarea>
            </label>

            <div class="flex flex-wrap gap-3">
              <button class="btn-secondary w-full sm:w-auto" type="button" data-prev-step>
                Back
              </button>
              <button
                class="btn-primary w-full sm:w-auto"
                type="button"
                data-prefill-contact
                data-haptic="true"
              >
                Prefill contact form
              </button>
            </div>

            <p class="text-subtle text-xs">
              We'll prefill the full form below so you can review, add consent, and submit.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  [data-quote-wizard][data-js-enabled='true'] [data-step] {
    display: none;
  }

  [data-quote-wizard][data-js-enabled='true'] [data-step][data-active='true'] {
    display: grid;
  }

  .wizard-stepper {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.42rem 0.6rem;
    border-radius: var(--radius-control);
    border: 1px solid rgb(var(--color-border) / 0.85);
    background-color: rgb(var(--color-surface) / 0.7);
  }

  .wizard-stepper[data-active='true'] {
    border-color: rgb(var(--color-brand) / 0.35);
    background-color: rgb(var(--color-brand-50) / 0.72);
  }

  .wizard-stepper__dot {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-weight: 700;
    color: rgb(var(--color-text));
    background-color: rgb(var(--color-surface));
    border: 1px solid rgb(var(--color-border) / 0.9);
  }
  .wizard-stepper[data-active='true'] .wizard-stepper__dot {
    border-color: rgb(var(--color-brand) / 0.55);
    background-color: rgb(var(--color-brand-50) / 0.9);
    box-shadow: 0 0 0 4px rgb(var(--color-brand) / 0.12);
  }
  .wizard-stepper[data-active='true'] .wizard-stepper__label {
    color: rgb(var(--color-text));
  }

  .wizard-services-box {
    border-radius: var(--radius-control);
    background-color: rgb(var(--color-surface) / 0.6);
  }
</style>

<script is:inline>
  (() => {
    const wizard = document.querySelector('[data-quote-wizard]');
    if (!(wizard instanceof HTMLElement)) return;
    if (wizard.dataset.jsEnabled === 'true') return;
    wizard.dataset.jsEnabled = 'true';

    const steps = Array.from(wizard.querySelectorAll('[data-step]')).filter(
      (el) => el instanceof HTMLElement
    );
    let current = 0;

    const section = wizard.closest('[id="quick-quote"]');
    const progress = Array.from(
      section ? section.querySelectorAll('[data-progress-step]') : []
    ).filter((el) => el instanceof HTMLElement);

    const setStep = (idx) => {
      current = Math.max(0, Math.min(idx, steps.length - 1));
      steps.forEach((step, i) => {
        step.dataset.active = i === current ? 'true' : 'false';
      });
      progress.forEach((p, i) => {
        p.dataset.active = i === current ? 'true' : 'false';
      });
    };

    const validateStep = (idx) => {
      const step = steps[idx];
      if (!step) return false;

      const required = Array.from(step.querySelectorAll('[required]')).filter(
        (el) =>
          el instanceof HTMLInputElement ||
          el instanceof HTMLSelectElement ||
          el instanceof HTMLTextAreaElement
      );

      for (const field of required) {
        if (!field.value || !field.checkValidity()) {
          field.reportValidity();
          field.focus();
          return false;
        }
      }

      // Custom check: at least one service
      if (step.dataset.step === '2') {
        const services = Array.from(step.querySelectorAll('input[name="wizard-services"]')).filter(
          (el) => el instanceof HTMLInputElement
        );
        if (!services.some((s) => s.checked)) {
          const box = step.querySelector('[data-wizard-services]');
          if (box instanceof HTMLElement) box.classList.add('border-destructive/40');
          if (services[0]) services[0].focus();
          return false;
        } else {
          const box = step.querySelector('[data-wizard-services]');
          if (box instanceof HTMLElement) box.classList.remove('border-destructive/40');
        }
      }

      return true;
    };

    wizard.addEventListener('click', (e) => {
      const target = e.target instanceof HTMLElement ? e.target : null;
      if (!target) return;

      if (target.closest('[data-next-step]')) {
        e.preventDefault();
        if (!validateStep(current)) return;
        setStep(current + 1);
        return;
      }

      if (target.closest('[data-prev-step]')) {
        e.preventDefault();
        setStep(current - 1);
        return;
      }

      if (target.closest('[data-prefill-contact]')) {
        e.preventDefault();
        // Validate all steps before prefill.
        for (let i = 0; i < steps.length; i += 1) {
          if (!validateStep(i)) {
            setStep(i);
            return;
          }
        }
        prefillContactForm();
      }
    });

    const readValue = (name) => {
      const input = wizard.querySelector(`[name="${name}"]`);
      if (
        input instanceof HTMLInputElement ||
        input instanceof HTMLSelectElement ||
        input instanceof HTMLTextAreaElement
      ) {
        return (input.value || '').trim();
      }
      return '';
    };

    const readServices = () => {
      return Array.from(wizard.querySelectorAll('input[name="wizard-services"]:checked'))
        .filter((el) => el instanceof HTMLInputElement)
        .map((i) => i.value);
    };

    const cssEscape =
      typeof CSS !== 'undefined' && CSS.escape
        ? CSS.escape
        : (v) => String(v).replace(/[^a-zA-Z0-9_-]/g, '_');

    const setFieldValue = (form, name, value) => {
      if (!value) return;
      if (!(form instanceof HTMLFormElement)) return;

      const field = form.querySelector(`[name="${name}"]`);
      if (
        !(
          field instanceof HTMLInputElement ||
          field instanceof HTMLSelectElement ||
          field instanceof HTMLTextAreaElement
        )
      ) {
        return;
      }

      if (field instanceof HTMLSelectElement) {
        const norm = (s) =>
          String(s)
            .toLowerCase()
            .replace(/[^a-z0-9]/g, '');
        const match = Array.from(field.options).find((o) => norm(o.value) === norm(value));
        field.value = match ? match.value : value;
      } else {
        field.value = value;
      }

      field.dispatchEvent(new Event('input', { bubbles: true }));
      field.dispatchEvent(new Event('change', { bubbles: true }));
    };

    const prefillContactForm = () => {
      const form = document.querySelector('form[data-contact-form]');
      if (!(form instanceof HTMLFormElement)) return;

      const map = {
        companyName: readValue('wizard-company'),
        location: readValue('wizard-location'),
        industry: readValue('wizard-industry'),
        frequency: readValue('wizard-frequency'),
        startTiming: readValue('wizard-timing'),
        name: readValue('wizard-name'),
        email: readValue('wizard-email'),
        phone: readValue('wizard-phone'),
      };

      Object.entries(map).forEach(([key, value]) => setFieldValue(form, key, value));

      const services = readServices();
      if (services.length) {
        services.forEach((value) => {
          const box = form.querySelector(
            `input[type="checkbox"][name="servicesNeeded"][value="${cssEscape(value)}"]`
          );
          if (box instanceof HTMLInputElement) {
            box.checked = true;
            box.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      }

      const size = readValue('wizard-size');
      const notes = readValue('wizard-notes');
      const summaryParts = [
        map.location ? `Location: ${map.location}` : '',
        size ? `Approx. size: ${size} sq ft` : '',
        map.industry ? `Industry: ${map.industry}` : '',
        map.frequency ? `Frequency: ${map.frequency}` : '',
        services.length ? `Services: ${services.join(', ')}` : '',
        map.startTiming ? `Timing: ${map.startTiming}` : '',
        notes ? `Notes: ${notes}` : '',
      ].filter(Boolean);

      const message = form.querySelector('textarea[name="message"]');
      if (message instanceof HTMLTextAreaElement && summaryParts.length) {
        const base = 'Quick quote summary:\n';
        message.value = base + summaryParts.join('\n');
        message.dispatchEvent(new Event('input', { bubbles: true }));
      }

      try {
        form.scrollIntoView({ block: 'start', behavior: 'smooth' });
      } catch {
        // ignore
      }

      const consent = form.querySelector('input[name="consent"]');
      if (consent instanceof HTMLInputElement) consent.focus();

      if (typeof window.damraTrack === 'function') {
        window.damraTrack('quote_wizard_prefill', {
          services: services.slice(0, 6),
          industry: map.industry || undefined,
          frequency: map.frequency || undefined,
        });
      }
    };

    setStep(0);
  })();
</script>
