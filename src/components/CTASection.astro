---
import { siteConfig } from '@/data/siteConfig';
import { makeHref } from '@/lib/nav';
import { makeMailtoHref, makeTelHref } from '@/lib/links';
import Eyebrow from './ui/Eyebrow.astro';

type Props = {
  /**
   * `centered` matches the old CTAStrip.
   * `split` matches the old ConversionStrip.
   */
  layout?: 'centered' | 'split' | undefined;

  id?: string | undefined;
  eyebrow?: string | undefined;
  heading?: string | undefined;
  description?: string | undefined;

  background?: 'default' | 'accent' | undefined;
  ctaText?: string | undefined;
  ctaHref?: string | undefined;

  tone?: 'muted' | 'surface' | undefined;
  showEmail?: boolean | undefined;
};

const href = makeHref(import.meta.env.BASE_URL);
const telHref = makeTelHref(siteConfig.contact.phoneE164);

const {
  layout = 'centered',
  id,
  eyebrow,
  heading,
  description,
  background = 'default',
  tone = 'muted',
  showEmail = true,
} = Astro.props;

const mailtoHref = makeMailtoHref(siteConfig.contact.email);
---

{
  layout === 'centered' ? (
    <section
      class:list={[
        'section section-creative border-y',
        background === 'accent'
          ? 'bg-brand border-white/10 text-white'
          : 'border-app section-muted',
      ]}
    >
      <div class="container-page">
        <div
          class:list={[
            'card relative mx-auto max-w-3xl overflow-hidden px-7 py-12 text-center sm:px-12 sm:py-14 lg:max-w-4xl lg:px-16 lg:py-16',
            background === 'accent' ? 'bg-brand/80 border-white/10' : '',
          ]}
        >
          {/* Decorative blobs */}
          <div
            aria-hidden="true"
            class="bg-brand/12 pointer-events-none absolute -top-20 -left-20 h-64 w-64 rounded-full blur-3xl"
          />
          <div
            aria-hidden="true"
            class="bg-accent/12 pointer-events-none absolute -right-20 -bottom-20 h-64 w-64 rounded-full blur-3xl"
          />
          {/* Top accent line */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-px"
            style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.5) 40%, rgb(var(--color-brand-400)/0.4) 60%, transparent);"
          />

          <div class="relative z-10">
            <h2
              class:list={[
                'font-serif font-semibold tracking-tight text-balance',
                'text-2xl sm:text-3xl lg:text-4xl',
                background === 'accent' ? 'text-white' : 'text-strong',
              ]}
              style="letter-spacing: -0.025em; line-height: 1.15;"
            >
              {heading ?? 'Ready to get started?'}
            </h2>
            <p
              class:list={[
                'mx-auto mt-4 max-w-md text-base leading-relaxed sm:mt-5 lg:mt-6',
                background === 'accent' ? 'text-white/75' : 'text-muted',
              ]}
            >
              {description ?? "Request a quote and we'll confirm scope, then send clear pricing."}
            </p>

            <div class="mt-8 flex flex-col items-center justify-center gap-2.5 sm:flex-row">
              <a
                href={telHref}
                class="btn-primary w-full sm:w-auto"
                data-track="cta_click"
                data-location="cta_section_centered"
                data-action="call"
                data-label="cta_centered_call"
              >
                Call now
              </a>
              <a
                href={href('contact/')}
                class="btn-secondary w-full sm:w-auto"
                data-track="cta_click"
                data-location="cta_section_centered"
                data-action="quote"
                data-label="cta_centered_quote"
              >
                Request a quote
              </a>
            </div>

            <p
              class:list={[
                'mt-5 text-xs tracking-wide',
                background === 'accent' ? 'text-white/55' : 'text-subtle',
              ]}
            >
              Clear scope · Checklist-driven · Fast follow-up
            </p>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section
      id={id}
      class:list={[
        'section section-creative scroll-mt-20',
        tone === 'muted' ? 'section-muted' : '',
      ]}
      aria-label="Get started"
    >
      <div class="container-page">
        <div class="card relative overflow-hidden p-7 sm:p-10 lg:p-14">
          {/* Top accent stripe */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-px"
            style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.45) 35%, rgb(var(--color-brand-400)/0.35) 65%, transparent);"
          />

          <div class="relative grid gap-8 md:grid-cols-2 md:items-center lg:gap-14">
            <div>
              <Eyebrow>{eyebrow ?? 'Next step'}</Eyebrow>
              <h2 class="heading-2 mt-2">{heading ?? 'Ready to scope your space?'}</h2>
              <p class="lede mt-3">
                {description ?? 'Use the phone number above or request a quote from the top menu.'}
              </p>

              <ul class="check-list check-list--compact text-subtle mt-5 text-sm sm:grid-cols-2">
                <li>
                  <span class="check-icon check-icon--sm" aria-hidden="true">
                    ✓
                  </span>
                  <span>Written scope + checklist</span>
                </li>
                <li>
                  <span class="check-icon check-icon--sm" aria-hidden="true">
                    ✓
                  </span>
                  <span>Fast replies during business hours</span>
                </li>
                <li>
                  <span class="check-icon check-icon--sm" aria-hidden="true">
                    ✓
                  </span>
                  <span>After-hours / weekend options</span>
                </li>
                <li>
                  <span class="check-icon check-icon--sm" aria-hidden="true">
                    ✓
                  </span>
                  <span>One point of contact</span>
                </li>
              </ul>
            </div>

            <div class="flex flex-col gap-2.5 md:items-end">
              <a
                class="btn-primary w-full md:w-auto"
                href={telHref}
                data-track="cta_click"
                data-location="cta_section_split"
                data-action="call"
                data-label="cta_split_call"
              >
                Call now
              </a>
              <a
                class="btn-secondary w-full md:w-auto"
                href={href('contact/')}
                data-track="cta_click"
                data-location="cta_section_split"
                data-action="quote"
                data-label="cta_split_quote"
              >
                Request a quote
              </a>
              {showEmail && (
                <div class="text-subtle mt-0.5 text-xs">
                  Or{' '}
                  <a
                    class="link link-muted"
                    href={mailtoHref}
                    data-track="cta_click"
                    data-location="cta_section_split"
                    data-action="email"
                  >
                    email us
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
