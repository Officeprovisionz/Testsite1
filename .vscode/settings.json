{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"],
  "prettier.requireConfig": true,
  "tailwindCSS.includeLanguages": {
    "astro": "html"
  },
  "files.associations": {
    "*.astro": "astro",
    "**/_headers": "plaintext"
  },

  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "**/playwright-report": true,
    "**/test-results": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "**/playwright-report": true,
    "**/test-results": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.astro/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true
  },

  // Only enable necessary extensions for this workspace
  "extensions.ignoreRecommendations": false,
  "extensions.autoUpdate": false,

  // Explicitly enable only required extensions
  "astro-build.astro-vscode.enabled": true,
  "esbenp.prettier-vscode.enabled": true,
  "dbaeumer.vscode-eslint.enabled": true,
  "bradlc.vscode-tailwindcss.enabled": true
}
