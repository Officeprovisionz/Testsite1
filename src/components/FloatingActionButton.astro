---
import { Icon } from 'astro-icon/components';
import { makeHref } from '@/lib/nav';

const base = import.meta.env.BASE_URL;
const contactHref = makeHref(base)('contact/');
---

<a
  id="fab-button"
  href={contactHref}
  class="ease-out-expo fixed right-4 bottom-24 z-30 flex h-14 w-14 translate-x-20 items-center justify-center rounded-full opacity-0 shadow-lg transition-[transform,opacity] duration-300 active:scale-[0.94] md:hidden"
  style="background: linear-gradient(158deg, rgb(var(--color-accent-200)) 0%, rgb(var(--color-accent-400)) 40%, rgb(var(--color-accent-500)) 100%); color: rgb(14 10 4); box-shadow: 0 4px 16px -4px rgb(var(--color-accent-500)/0.55), 0 0 0 1px rgb(var(--color-accent-300)/0.5) inset;"
  aria-label="Get a quote"
  data-haptic="true"
  data-astro-prefetch="tap"
>
  <Icon name="lucide:message-circle" class="h-6 w-6" aria-hidden="true" />
</a>

<script>
  const SHOW_THRESHOLD = 100;
  const HIDE_FOOTER_OFFSET = 200;

  function initFAB() {
    const fab = document.getElementById('fab-button');
    if (!fab) return;

    const handleScroll = () => {
      const scrollY = window.scrollY;
      const docHeight = document.body.scrollHeight - window.innerHeight;
      const shouldShow = scrollY > SHOW_THRESHOLD && scrollY < docHeight - HIDE_FOOTER_OFFSET;

      if (shouldShow) {
        fab.classList.remove('translate-x-20', 'opacity-0');
        fab.classList.add('translate-x-0', 'opacity-100');
      } else {
        fab.classList.add('translate-x-20', 'opacity-0');
        fab.classList.remove('translate-x-0', 'opacity-100');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Track clicks
    fab.addEventListener('click', () => {
      if (window.damraTrack) {
        window.damraTrack('fab_click', { action: 'contact' });
      }
    });
  }

  document.addEventListener('astro:page-load', initFAB);
  initFAB();
</script>
