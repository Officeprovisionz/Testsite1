---
const steps = [
  {
    title: 'Walkthrough',
    description: 'We review the space, confirm access, and map the scope.',
  },
  {
    title: 'Checklist',
    description: 'A written checklist keeps the scope consistent and trackable.',
  },
  {
    title: 'Service',
    description: 'Same crew, consistent results, and photo updates when needed.',
  },
  {
    title: 'Follow‑up',
    description: 'We resolve any issues quickly and adjust the scope if needed.',
  },
];
---

<section class="section" id="journey-map">
  <div class="container-page">
    <div class="text-center">
      <p class="label text-muted text-[0.75rem]">Journey map</p>
      <h2 class="heading-2 mt-3">What it feels like to work with us</h2>
      <p class="lede mx-auto mt-3 max-w-2xl">
        A swipeable, step‑by‑step view that makes the process feel simple on mobile.
      </p>
    </div>

    <div class="journey mt-8">
      {
        steps.map((step, idx) => (
          <article class="journey__card card card-hover">
            <p class="label text-muted text-[0.7rem]">Step {idx + 1}</p>
            <h3 class="heading-4 mt-2">{step.title}</h3>
            <p class="text-muted mt-2 text-sm leading-relaxed">{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .journey {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14rem, 1fr);
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scroll-snap-type: x mandatory;
  }

  .journey__card {
    scroll-snap-align: start;
    padding: 1.25rem;
  }

  @media (min-width: 768px) {
    .journey {
      grid-auto-flow: unset;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
    }
  }
</style>
