---
import SectionHeader from '@/components/ui/SectionHeader.astro';

const tiers = [
  {
    name: 'Core Clean',
    highlight: false,
    features: [
      'Checklist cleaning',
      'Restrooms + kitchen',
      'Trash + recycling',
      'Dusting + wipe-downs',
    ],
  },
  {
    name: 'Standard',
    highlight: true,
    features: [
      'Everything in Core',
      'High-touch disinfection',
      'Floor care (weekly)',
      'Reporting + follow-ups',
    ],
  },
  {
    name: 'Full Support',
    highlight: false,
    features: [
      'Everything in Standard',
      'Restocking + pantry',
      'Light facilities support',
      'Priority scheduling',
    ],
  },
];

const matrix = [
  { label: 'Checklist cleaning', values: [true, true, true] },
  { label: 'High-touch disinfection', values: [false, true, true] },
  { label: 'Floor care (weekly)', values: [false, true, true] },
  { label: 'Restocking + pantry', values: [false, false, true] },
  { label: 'Facilities support', values: [false, false, true] },
  { label: 'Reporting + follow-ups', values: [false, true, true] },
];
---

<section class="section section-creative">
  <div class="container-page">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Service tiers"
        heading="Compare cleaning coverage"
        description="Choose a baseline, then add the support you need. We'll confirm scope and access during the walkthrough."
        align="center"
        class="mx-auto max-w-3xl"
      />

      <div
        class="mt-10 overflow-hidden rounded-(--radius-card) border border-[rgb(var(--color-border)/0.6)] shadow-(--shadow-xs) lg:mt-14"
      >
        {/* Header row */}
        <div
          class="grid grid-cols-4 border-b border-[rgb(var(--color-border)/0.6)] bg-[rgb(var(--color-surface)/0.9)]"
        >
          <div
            class="px-4 py-3 text-left text-xs font-semibold tracking-widest text-[rgb(var(--color-text-muted)/0.7)] uppercase"
          >
            Feature
          </div>
          {
            tiers.map((tier) => (
              <div
                class:list={[
                  'relative px-4 py-3 text-center text-sm font-semibold',
                  tier.highlight ? 'bg-[rgb(var(--color-accent)/0.08)]' : '',
                ]}
              >
                {tier.highlight && (
                  <div
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-x-0 top-0 h-px"
                    style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.6) 50%, transparent);"
                  />
                )}
                <span class="text-strong">{tier.name}</span>
                {tier.highlight ? (
                  <span class="ml-2 rounded-full bg-[rgb(var(--color-accent-400)/0.25)] px-2 py-0.5 text-[0.65rem] font-semibold text-[rgb(var(--color-accent-700))]">
                    Best fit
                  </span>
                ) : null}
              </div>
            ))
          }
        </div>

        {/* Matrix rows */}
        <div class="divide-y divide-[rgb(var(--color-border)/0.45)]">
          {
            matrix.map((row) => (
              <div class="grid grid-cols-4 items-center">
                <div class="px-4 py-3 text-left text-sm text-[rgb(var(--color-text-muted))]">
                  {row.label}
                </div>
                {row.values.map((value, colIdx) => (
                  <div
                    class:list={[
                      'flex items-center justify-center px-4 py-3',
                      tiers[colIdx]?.highlight ? 'bg-[rgb(var(--color-accent)/0.05)]' : '',
                    ]}
                  >
                    {value ? (
                      <span
                        class="flex h-5 w-5 items-center justify-center rounded-full bg-[rgb(var(--color-accent)/0.2)] text-[rgb(var(--color-accent-600))]"
                        aria-label="Included"
                      >
                        <svg
                          viewBox="0 0 14 14"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          class="h-3 w-3"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M2 7l3.5 3.5L12 3"
                          />
                        </svg>
                      </span>
                    ) : (
                      <span class="text-subtle text-lg leading-none" aria-label="Not included">
                        —
                      </span>
                    )}
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      {/* Tier summary cards */}
      <div class="mt-6 grid gap-4 sm:grid-cols-3 lg:mt-8">
        {
          tiers.map((tier) => (
            <div class="card card-hover relative overflow-hidden p-5 sm:p-6">
              {tier.highlight && (
                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-x-0 top-0 h-px"
                  style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.5) 50%, transparent);"
                />
              )}
              <p class="label text-muted text-[0.72rem]">{tier.name}</p>
              <ul class="text-muted mt-3 space-y-2.5 text-sm">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2.5">
                    <span
                      class="mt-0.5 flex h-4.5 w-4.5 flex-none items-center justify-center rounded-full bg-[rgb(var(--color-accent)/0.15)] text-[rgb(var(--color-accent-600))]"
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 14 14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        class="h-2.5 w-2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M2 7l3.5 3.5L12 3"
                        />
                      </svg>
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
