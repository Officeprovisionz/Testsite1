---
import { Icon } from 'astro-icon/components';

const items = [
  {
    icon: 'lucide:shield-check',
    title: 'Insured + bonded',
    description: 'Professional coverage for commercial spaces.',
  },
  {
    icon: 'lucide:list-checks',
    title: 'Checklist-driven',
    description: 'Consistent scope and predictable results.',
  },
  {
    icon: 'lucide:zap',
    title: 'Fast response',
    description: 'Real person answers during business hours.',
  },
];
---

<section class="section section-muted">
  <div class="container-page">
    <div class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-3">
      {
        items.map((item) => (
          <div class="card card-hover relative flex h-full flex-col gap-2 overflow-hidden p-4 sm:p-5">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 bg-linear-to-br from-[rgb(var(--color-accent)/0.14)] via-transparent to-[rgb(var(--color-brand)/0.09)] opacity-70"
            />
            <div class="relative flex items-center gap-3">
              <span class="feature-icon">
                <Icon name={item.icon} class="feature-icon__glyph" />
              </span>
              <p class="text-strong text-base font-semibold">{item.title}</p>
            </div>
            <p class="text-muted relative text-sm">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
