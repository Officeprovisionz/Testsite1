# Local dev defaults work without this file.
# Copy to .env to override.

# Base path for deploying under a subpath (e.g., GitHub Pages).
# Local dev: /
# GitHub Pages: /<repo>/
PUBLIC_SITE_BASE=/

# Full canonical site URL INCLUDING the base.
# Example (GitHub Pages): https://<owner>.github.io/<repo>/
SITE_URL=

# Static form endpoint (Formspree/Basin/etc.).
# Example (Formspree): https://formspree.io/f/xxxxxxxx
# Required for static-only hosts such as GitHub Pages.
PUBLIC_FORM_ENDPOINT=

# Built-in email sender (Cloudflare Pages Functions)
# If PUBLIC_FORM_ENDPOINT is not set, Cloudflare Pages deployments can POST to /api/contact.
# Configure these in your Cloudflare Pages project environment variables.
# Example: MAIL_FROM=noreply@officeprovisionz.com
MAIL_FROM=
MAIL_FROM_NAME=Office Provisionz Website
# Optional override (defaults to officeprovisionz@gmail.com)
CONTACT_TO_EMAIL=officeprovisionz@gmail.com

# Used by the gallery fetch script (scripts/fetch-gallery.mjs)
# Get a key from https://www.pexels.com/api/
# IMPORTANT: never commit real keys here. Keep this file as placeholders only.
PEXELS_API_KEY=

# Optional: enable the homepage hero background video.
# Requires these files to exist:
# - public/media/hero-cleaning.webm
# - public/media/hero-cleaning.mp4
PUBLIC_ENABLE_HERO_VIDEO=false

# Analytics (Plausible)
# Explicitly enable only on the canonical production host.
PUBLIC_ENABLE_ANALYTICS=false
# Example: PUBLIC_PLAUSIBLE_DOMAIN=officeprovisionz.com
PUBLIC_PLAUSIBLE_DOMAIN=

# Plausible script URL
PUBLIC_PLAUSIBLE_SRC=

# Progressive Web App / service worker
# Enable only on the canonical production host after validating cache behavior.
PUBLIC_ENABLE_SERVICE_WORKER=false

# Optional: booking link (Cal.com/Calendly)
PUBLIC_BOOKING_URL=

# Error tracking (Sentry)
# Create a project at https://sentry.io and paste the DSN here.
PUBLIC_SENTRY_DSN=
