---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
import TrustBar from '@/components/TrustBar.astro';
import ServicesSection from '@/components/Services.astro';
import ServiceComparisonMatrix from '@/components/ServiceComparisonMatrix.astro';
import ServiceDeepDivePanels from '@/components/ServiceDeepDivePanels.astro';
import IndustriesGrid from '@/components/IndustriesGrid.astro';
import AreasServed from '@/components/AreasServed.astro';
import FAQ from '@/components/FAQ.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { siteConfig } from '@/data/siteConfig';
import { getCollection } from 'astro:content';
import { getPublicResponsiveImage } from '@/lib/publicImages';
import { pickGalleryItems } from '@/data/gallery';

const title = `Services | ${siteConfig.brand.name}`;
const description =
  'Office cleaning, janitorial services, supplies/restocking, and facilities support—built for busy teams in San Francisco.';

const allServices = await getCollection('services');
const specialtyServices = allServices
  .filter((s) => s.data.category === 'specialty')
  .map((s) => s.data);

const heroItems = pickGalleryItems('services-hero', 2);
const heroPrimary = heroItems[0];
const heroSecondary = heroItems[1] ?? heroPrimary;

const heroImage = heroPrimary
  ? getPublicResponsiveImage(heroPrimary.src, import.meta.env.BASE_URL, {
      sizes: '100vw',
    })
  : { src: '', srcSet: undefined, sizes: '100vw' };

const heroImageMobile = heroSecondary
  ? getPublicResponsiveImage(heroSecondary.src, import.meta.env.BASE_URL, {
      sizes: '100vw',
    })
  : heroImage;
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      serviceType: 'Office Cleaning',
      provider: {
        '@type': 'LocalBusiness',
        name: 'Office Provisionz',
      },
      areaServed: {
        '@type': 'City',
        name: 'San Francisco',
      },
      description:
        'Professional office cleaning services including janitorial, deep cleaning, and supply restocking.',
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        priceCurrency: 'USD',
        price: 'Call for quote',
      },
    })}
  />

  <PageHero
    title="Services"
    description="Janitorial, detail cleaning, restocking, and light facilities support—delivered with clear scope, consistent checklists, and fast follow-up."
    imageSrc={heroPrimary?.src}
    imageSrcMobile={heroSecondary?.src}
    imageAlt={heroPrimary?.alt ?? ''}
    imageSrcSet={heroImage.srcSet}
    imageSizes={heroImage.sizes}
    imageSrcSetMobile={heroImageMobile.srcSet}
    imageSizesMobile={heroImageMobile.sizes}
    imagePosition="50% 45%"
  />

  <TrustBar />

  <!-- Industries page merged here (no information removed) -->
  <IndustriesGrid
    showCta={false}
    extraItems={[
      {
        title: 'Furniture services',
        description:
          'Need furniture built or rearranged? We provide professional furniture assembly and moving services that transform your office space efficiently.',
      },
      {
        title: 'Office organization',
        description:
          'Is clutter holding your business back? We create order that lasts—from storage rooms to disorganized inventory.',
      },
      {
        title: 'Air filter replacement',
        description:
          'Scheduled filter changes to support healthier air quality—so you never have to think about it.',
      },
      {
        title: 'Event & assistant support',
        description:
          'From company meetings to special celebrations, we help with the details so everything runs smoothly.',
      },
    ]}
  />

  <section class="section section-creative scroll-mt-20" id="breakroom">
    <div class="container-page">
      <SectionHeader
        align="center"
        eyebrow="Breakroom & operations"
        heading="Your office partner (not just cleaning)"
        description="We can support pantry, coffee, and day-to-day office needs—so your team stays focused and the space stays ready."
      />

      <div class="mt-10 grid gap-6 lg:mt-12 lg:grid-cols-2">
        <article class="card card-hover relative overflow-hidden p-6 sm:p-7">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.14)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
          >
          </div>
          <div class="relative">
            <p class="text-strong text-lg font-semibold">Snacks, drinks, pantry essentials</p>
            <p class="text-muted mt-3 text-sm leading-relaxed">
              Your break room is our priority. We’re your office partner for snacks, drinks, coffee,
              and everything that keeps your day running efficiently—without the hassle.
            </p>
            <p class="text-muted mt-3 text-sm leading-relaxed">
              Your team is unique, and your pantry should be too. We’ll work with you to create a
              customized selection that balances health-conscious choices with everyone’s
              favorites—because satisfaction matters.
            </p>
          </div>
        </article>

        <article class="card card-hover p-6 sm:p-7">
          <p class="text-strong text-lg font-semibold">Coffee program</p>
          <p class="text-muted mt-3 text-sm leading-relaxed">
            Fresh, locally roasted coffee meets the right machine for your space. We’re experts in
            everything from traditional espresso setups to fully automated systems and classic
            coffee machines—plus we source all the essentials: milk, non-dairy alternatives,
            creamers, sweeteners, and every finishing touch your team wants.
          </p>
        </article>
      </div>

      <p class="text-muted mx-auto mt-6 max-w-3xl text-center text-sm">
        A well-maintained office doesn’t just look better—it performs better. Our dedicated
        maintenance team provides comprehensive solutions that keep your workplace organized,
        functional, and running at peak efficiency.
      </p>
    </div>
  </section>

  <ServicesSection
    id="specialty"
    heading="Specialty & add-on services"
    description="Add these one-off or periodic services when you need them. We confirm access, timing, and building rules during scoping—so pricing and expectations stay clear."
    presentation="dropdown"
    items={specialtyServices}
  />

  <ServiceDeepDivePanels />

  <ServiceComparisonMatrix />

  <AreasServed />

  <FAQ showWave={false} />

  <Footer slot="footer" />
</BaseLayout>
