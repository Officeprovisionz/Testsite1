---
const steps = [
  {
    title: 'Walkthrough + scope',
    description:
      'Tell us your space and goals. We confirm details, lock the scope, and send a clear written quote.',
  },
  {
    title: 'Checklist cleaning',
    description: "We use a consistent checklist so the important details don't get missed.",
  },
  {
    title: 'Communication',
    description: 'We let you know when we arrive and leave, and flag any issues immediately.',
  },
];
---

<div class="timeline">
  {
    steps.map((step, idx) => (
      <div class:list={['timeline__item', idx % 2 === 1 ? 'is-right' : 'is-left']}>
        <div class="timeline__marker" aria-hidden="true">
          {idx + 1}
        </div>
        <div class="timeline__content card card-hover relative overflow-hidden">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-px"
            style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.38) 50%, transparent);"
          />
          <p class="label text-muted text-[0.7rem]">Step {idx + 1}</p>
          <h3 class="heading-4 mt-1.5">{step.title}</h3>
          <p class="text-muted mt-2 text-sm leading-relaxed">{step.description}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 1.25rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      rgb(var(--color-accent-300) / 0.7) 0%,
      rgb(var(--color-accent-400) / 0.5) 50%,
      rgb(var(--color-brand-400) / 0.35) 100%
    );
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }

  .timeline__marker {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, rgb(var(--color-accent-300)), rgb(var(--color-accent-500)));
    color: rgb(14 10 4);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    box-shadow:
      0 2px 8px -3px rgb(var(--color-accent-500) / 0.5),
      0 0 0 1px rgb(var(--color-accent-400) / 0.35);
    z-index: 1;
    flex-shrink: 0;
  }

  .timeline__content {
    padding: 1rem 1.25rem;
  }

  @media (min-width: 768px) {
    .timeline {
      gap: 2rem;
    }

    .timeline::before {
      left: 50%;
      transform: translateX(-50%);
    }

    .timeline__item {
      grid-template-columns: 1fr auto 1fr;
    }

    .timeline__item.is-left .timeline__content {
      grid-column: 1 / 2;
      text-align: right;
      justify-self: end;
    }

    .timeline__item.is-right .timeline__content {
      grid-column: 3 / 4;
      text-align: left;
      justify-self: start;
    }

    .timeline__item.is-left .timeline__marker,
    .timeline__item.is-right .timeline__marker {
      grid-column: 2 / 3;
      justify-self: center;
    }
  }
</style>
