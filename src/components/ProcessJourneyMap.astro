---
import SectionHeader from '@/components/ui/SectionHeader.astro';

const steps = [
  {
    title: 'Walkthrough',
    description: 'We review the space, confirm access, and map the scope.',
  },
  {
    title: 'Checklist',
    description: 'A written checklist keeps the scope consistent and trackable.',
  },
  {
    title: 'Service',
    description: 'Same crew, consistent results, and photo updates when needed.',
  },
  {
    title: 'Follow‑up',
    description: 'We resolve any issues quickly and adjust the scope if needed.',
  },
];
---

<section class="section" id="journey-map">
  <div class="container-page">
    <SectionHeader
      eyebrow="Journey map"
      heading="What it feels like to work with us"
      description="A clear, step-by-step view that makes the process simple to understand."
      align="center"
      class="mx-auto max-w-3xl"
    />

    <div class="journey mt-10 lg:mt-14">
      {
        steps.map((step, idx) => (
          <article class="journey__card card card-hover relative overflow-hidden">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-x-0 top-0 h-px"
              style="background: linear-gradient(90deg, transparent, rgb(var(--color-accent-400)/0.38) 50%, transparent);"
            />
            <span
              class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold"
              style="background: linear-gradient(135deg, rgb(var(--color-accent-300)), rgb(var(--color-accent-500))); color: rgb(14 10 4); box-shadow: 0 2px 6px -2px rgb(var(--color-accent-500)/0.45);"
              aria-hidden="true"
            >
              {idx + 1}
            </span>
            <h3 class="heading-4">{step.title}</h3>
            <p class="text-muted mt-2 text-sm leading-relaxed">{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .journey {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(13.5rem, 1fr);
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.75rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .journey::-webkit-scrollbar {
    display: none;
  }

  .journey__card {
    scroll-snap-align: start;
    padding: 1.25rem 1.375rem;
  }

  @media (min-width: 768px) {
    .journey {
      grid-auto-flow: unset;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      padding-bottom: 0;
    }
  }
</style>
