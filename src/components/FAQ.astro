---
import { getCollection } from 'astro:content';
import WaveDivider from '@/components/WaveDivider.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { siteConfig } from '@/data/siteConfig';
import { makeHref } from '@/lib/nav';

type Props = {
  id?: string;
  heading?: string;
  description?: string;
  showWave?: boolean;
};

const {
  id = 'faq',
  heading = 'FAQ',
  description = 'Quick answers to common questions.',
  showWave = true,
} = Astro.props;

const faqs = await getCollection('faqs');
const items = faqs.map((f) => f.data);

const searchId = `${id}-search`;
const href = makeHref(import.meta.env.BASE_URL);

const faqJsonLd = (() => {
  const data = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((it) => ({
      '@type': 'Question',
      name: it.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: it.answer,
      },
    })),
  };

  // Prevent accidental "</script>" injection via safe escaping.
  return JSON.stringify(data).replace(/</g, '\\u003c');
})();
---

<section id={id} class="section scroll-mt-20">
  <script type="application/ld+json" is:inline set:html={faqJsonLd} />
  <div class="container-page relative">
    <SectionHeader eyebrow="FAQ" heading={heading} description={description} />

    <div class="mx-auto mt-10 max-w-3xl lg:mt-14 lg:max-w-4xl" data-faq>
      <div class="mb-4 lg:mb-6">
        <label class="sr-only" for={searchId}>Search FAQs</label>
        <div class="relative">
          <input
            id={searchId}
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="Search questions…"
            class="border-app/60 text-strong focus:border-brand/50 w-full rounded-2xl border bg-surface/80 px-4 py-3 pr-10 shadow-sm backdrop-blur-sm transition placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-[rgb(var(--color-brand)/0.35)]"
            data-faq-search
          />
          <svg
            aria-hidden="true"
            class="pointer-events-none absolute right-3 top-1/2 h-5 w-5 -translate-y-1/2 text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <p class="mt-2 text-xs text-muted" aria-live="polite" data-faq-status></p>
      </div>

      <div class="space-y-3" data-faq-list>
        {
          items.map((it) => (
            <details
              class="bg-surface/92 open:shadow-brand/8 border-brand/20 open:border-brand/40 hover:border-brand/30 hover:shadow-brand/5 dark:border-brand/20 dark:open:border-brand/40 dark:open:shadow-brand/10 dark:hover:border-brand/30 group overflow-hidden rounded-2xl border shadow-sm backdrop-blur-sm transition-all duration-300 ease-out open:shadow-lg hover:shadow-md"
              data-faq-item
            >
              <summary class="text-strong hover:bg-brand/5 active:bg-brand/10 flex w-full cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 text-left font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(var(--color-brand)/0.5)] focus-visible:ring-offset-2 lg:px-7 lg:py-5 lg:text-lg">
                <span data-faq-q>{it.question}</span>
                <svg
                  class="text-brand group-open:text-brand h-5 w-5 shrink-0 transition-all duration-300 [transition-timing-function:cubic-bezier(0.34,1.56,0.64,1)] group-open:rotate-180"
                  aria-hidden="true"
                  data-faq-icon
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div
                class="border-brand/10 border-t bg-surface-muted/30 px-5 py-5 text-sm leading-relaxed text-muted lg:px-7 lg:py-5 lg:text-base lg:leading-relaxed"
                data-faq-a
              >
                <p>{it.answer}</p>
              </div>
            </details>
          ))
        }
      </div>

      <div
        class="border-app/40 mt-4 hidden rounded-2xl border bg-surface/70 px-5 py-4 text-sm text-muted backdrop-blur-sm"
        data-faq-empty
      >
        No matches. Try a different keyword (e.g. “pricing”, “supplies”, “after-hours”).
      </div>

      <div
        class="border-app/40 mt-6 rounded-2xl border bg-surface/70 px-5 py-5 backdrop-blur-sm lg:px-7"
      >
        <p class="text-strong font-medium">Still have a question?</p>
        <p class="mt-1 text-sm text-muted">Tell us what you need and we’ll reply quickly.</p>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            class="btn-primary w-full sm:w-auto"
            href={`tel:${siteConfig.contact.phoneE164}`}
            data-haptic="true"
          >
            Call now
          </a>
          <a class="btn-secondary w-full sm:w-auto" href={href('contact/')} data-haptic="true">
            Request a quote
          </a>
          <a
            class="btn-secondary w-full sm:w-auto"
            href={`sms:${siteConfig.contact.phoneE164}`}
            data-haptic="true"
          >
            Text us
          </a>
        </div>
      </div>
    </div>
  </div>

  {
    showWave ? (
      <div class="relative -mb-px mt-12">
        <WaveDivider tone="surface-muted" class="absolute bottom-0 left-0 right-0" />
      </div>
    ) : null
  }

  <script>
    (() => {
      const init = () => {
        const root = document.querySelector('[data-faq]') as HTMLElement | null;
        if (!root) return;
        if (root.dataset.faqInit === 'true') return;
        root.dataset.faqInit = 'true';

        const input = root.querySelector('[data-faq-search]') as HTMLInputElement | null;
        const status = root.querySelector('[data-faq-status]') as HTMLElement | null;
        const empty = root.querySelector('[data-faq-empty]') as HTMLElement | null;
        const items = Array.from(root.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'));

        const norm = (value: string) => value.trim().toLowerCase();
        const setStatus = (text: string) => {
          if (!status) return;
          status.textContent = text;
        };

        items.forEach((el) => {
          const q = el.querySelector('[data-faq-q]')?.textContent ?? '';
          const a = el.querySelector('[data-faq-a]')?.textContent ?? '';
          el.dataset.searchText = norm(`${q} ${a}`);
        });

        const applyFilter = (queryRaw: string, opts: { openFirst?: boolean } = {}) => {
          const query = norm(queryRaw);
          let visible = 0;

          items.forEach((el) => {
            const hay = el.dataset.searchText ?? '';
            const match = !query || hay.includes(query);
            el.hidden = !match;
            if (!match && el.open) el.open = false;
            if (match) {
              visible += 1;
            }
          });

          // Determine the first visible match after filtering.
          const first = items.find((el) => !el.hidden);

          if (empty) empty.classList.toggle('hidden', visible !== 0);

          if (!query) {
            setStatus('');
            return;
          }

          setStatus(`${visible} result${visible === 1 ? '' : 's'} for “${queryRaw.trim()}”`);

          if (opts.openFirst && first) {
            first.open = true;
            first.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          }
        };

        items.forEach((el) => {
          el.addEventListener('toggle', () => {
            // Keep it "dropdown" style: only one open at a time.
            if (el.open) {
              items.forEach((other) => other !== el && (other.open = false));

              // Track FAQ interaction
              const question = el.querySelector('[data-faq-q]')?.textContent || 'unknown';
              try {
                window.damraTrack?.('faq_open', { question });
              } catch {
                // ignore
              }
            }
          });
        });

        if (input) {
          input.addEventListener('input', () => applyFilter(input.value));
          input.addEventListener('keydown', (ev) => {
            if ((ev as KeyboardEvent).key === 'Enter') {
              applyFilter(input.value, { openFirst: true });
            }
          });
        }

        // Initial state
        applyFilter(input?.value ?? '');
      };

      const doc = document.documentElement;
      if (doc.dataset.faqListen !== 'true') {
        doc.dataset.faqListen = 'true';
        document.addEventListener('astro:page-load', init);
      }

      init();
    })();
  </script>
</section>

<style>
  /* Remove the default disclosure triangle marker for a cleaner dropdown look. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
