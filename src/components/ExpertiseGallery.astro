---
/**
 * ExpertiseGallery - Combined expertise + gallery section
 * Shows 4 large image cards with titles and descriptions
 * Mobile-first responsive grid layout
 */
import { getPublicResponsiveImage } from '@/lib/publicImages';
import { getShuffledGalleryItems } from '@/data/gallery';
import Eyebrow from './ui/Eyebrow.astro';
import galleryMetadataRaw from '@/data/gallery-metadata.json';

const galleryMetadata = galleryMetadataRaw as Record<
  string,
  { dominant: string; lqip: string; width?: number; height?: number } | undefined
>;

type ExpertiseItem = {
  src: string;
  title: string;
  description: string;
  alt: string;
};

type Props = {
  id?: string;
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  items?: ExpertiseItem[];
};

const {
  id = 'expertise',
  eyebrow = 'Signature services',
  heading = 'Precision, not volume',
  subheading = 'Tailored cleaning and facilities support built around clear scope, quiet execution, and repeatable results.',
  items = [
    {
      src: 'gallery/01.jpg',
      title: 'Office Cleaning',
      description:
        'Routine cleaning to keep your workspace client-ready and team-friendly. Work areas, restrooms, and shared spaces handled the same way every visit.',
      alt: 'Modern clean office interior with organized workspace',
    },
    {
      src: 'gallery/02.jpg',
      title: 'Professional Janitorial',
      description:
        'Scheduled service for consistent upkeep-ideal for busy offices. High-touch sanitizing, trash removal, and checklist verification.',
      alt: 'Professional office cleaning service in action',
    },
    {
      src: 'gallery/03.jpg',
      title: 'Coffee, Snacks & Restocking',
      description:
        'Your break room stays stocked-coffee, snacks, and the essentials that keep the day running smoothly. Paper goods and supplies are restocked so your team stays fueled.',
      alt: 'Office coffee, snacks, and supplies fully stocked',
    },
    {
      src: 'gallery/05.jpg',
      title: 'Facilities Support',
      description:
        'Light maintenance and coordination for common areas. Day porter services, vendor coordination, and on-site quick response.',
      alt: 'Corporate lobby clean and ready for clients',
    },
  ],
} = Astro.props as Props;

const base = import.meta.env.BASE_URL;
const imagePool = getShuffledGalleryItems('expertise');
const resolvedItems = items.map((item, idx) => {
  if (!imagePool.length) return item;
  const photo = imagePool[idx % imagePool.length];
  return {
    ...item,
    src: photo?.src ?? item.src,
    alt: photo?.alt ?? item.alt,
  };
});

const getImgAttrs = (src: string) => {
  const fileName = src.split('/').pop() || '';
  const meta = galleryMetadata[fileName];

  if (/^https?:\/\//i.test(src))
    return {
      src,
      srcSet: undefined,
      avifSrcSet: undefined,
      webpSrcSet: undefined,
      sizes: undefined,
      lqip: undefined,
      dominant: undefined,
      width: undefined,
      height: undefined,
    };

  const cleaned = src.replace(/^\/+/, '');
  const baseAttrs = /\.jpe?g$/i.test(cleaned)
    ? getPublicResponsiveImage(cleaned, base, {
        sizes: '(min-width: 1024px) 50vw, 100vw',
      })
    : {
        src: `${base}${cleaned}`,
        srcSet: undefined,
        avifSrcSet: undefined,
        webpSrcSet: undefined,
        sizes: undefined,
      };

  return {
    ...baseAttrs,
    lqip: meta?.lqip,
    dominant: meta?.dominant,
    width: meta?.width,
    height: meta?.height,
  };
};
---

<section id={id} class="section section-creative relative overflow-hidden">
  <div class="container-page">
    <!-- Header -->
    <div class="mb-12 text-center md:mb-16 lg:mb-20">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h2 class="heading-2">{heading}</h2>
      {subheading && <p class="lede mx-auto mt-5 max-w-2xl lg:text-lg">{subheading}</p>}
    </div>

    <!-- Grid: 2x2 on desktop, stacked on mobile -->
    <div class="grid gap-5 sm:grid-cols-2 lg:gap-8 xl:gap-10">
      {
        resolvedItems.map((item, index) => {
          const attrs = getImgAttrs(item.src);
          return (
            <article
              class="expertise-card card card-hover group relative overflow-hidden"
              style={`--i: ${index}; animation-delay: ${index * 120}ms`}
            >
              <div
                class="relative aspect-[16/10] overflow-hidden sm:aspect-[16/9] lg:aspect-[16/10]"
                style={
                  attrs.lqip
                    ? `background-image: url(${attrs.lqip}); background-size: cover; background-position: center;`
                    : attrs.dominant
                      ? `background-color: ${attrs.dominant};`
                      : undefined
                }
              >
                <picture>
                  {attrs.avifSrcSet && (
                    <source type="image/avif" srcset={attrs.avifSrcSet} sizes={attrs.sizes} />
                  )}
                  {attrs.webpSrcSet && (
                    <source type="image/webp" srcset={attrs.webpSrcSet} sizes={attrs.sizes} />
                  )}
                  <img
                    src={attrs.src}
                    srcset={attrs.srcSet}
                    width={attrs.width}
                    height={attrs.height}
                    sizes={attrs.sizes ?? '(min-width: 1024px) 50vw, 100vw'}
                    alt={item.alt}
                    loading="eager"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.05]"
                  />
                </picture>
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 via-60% to-transparent transition-opacity duration-500 group-hover:from-black/95"
                  aria-hidden="true"
                />
              </div>

              <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6 lg:p-8">
                <h3
                  class="text-lg font-bold tracking-tight text-white sm:text-xl lg:text-2xl"
                  style="text-shadow: 0 2px 12px rgba(0,0,0,0.5)"
                >
                  {item.title}
                </h3>
                <p
                  class="mt-2 line-clamp-2 text-sm leading-relaxed text-white/90 sm:text-base lg:mt-3 lg:line-clamp-3"
                  style="text-shadow: 0 1px 8px rgba(0,0,0,0.4)"
                >
                  {item.description}
                </p>
              </div>

              <div
                class="pointer-events-none absolute inset-0 opacity-0 transition-all duration-500 group-hover:opacity-100"
                aria-hidden="true"
              >
                <div class="absolute inset-x-0 bottom-0 h-1.5 bg-[rgb(var(--color-accent))]" />
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .expertise-card {
    /* Baseline entrance (kept intentionally simple for mobile stability) */
    animation: fadeSlideUp 0.6s ease-out both;
    position: relative;
    z-index: 1;
  }

  /* 2026 Polish: Sheer refractive overlay that reacts to movement/hover */
  .expertise-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.03) 40%,
      rgba(255, 255, 255, 0.12) 50%,
      rgba(255, 255, 255, 0.03) 60%,
      rgba(255, 255, 255, 0) 100%
    );
    background-size: 300% 300%;
    background-position: 100% 100%;
    transition: background-position 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 10;
  }

  .expertise-card:hover::after,
  .expertise-card:active::after {
    background-position: 0% 0%;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Smooth hover lift - only on hover-capable devices */
  @media (hover: hover) and (pointer: fine) {
    .expertise-card:hover {
      transform: translateY(-10px) rotateX(2deg) rotateY(-3deg);
    }
  }

  /* Touch device optimization */
  @media (hover: none) {
    .expertise-card {
      transform: none !important;
    }
    .expertise-card img {
      transform: none !important;
    }
  }

  /* Visual regression + automation stability: disable scroll-driven motion under WebDriver. */
  :global(html[data-webdriver='true']) .expertise-card {
    animation: none !important;
    transform: none !important;
    filter: none !important;
    opacity: 1 !important;
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .expertise-card {
      animation: none;
      filter: none;
    }
    .expertise-card,
    .expertise-card img {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
