---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { siteConfig } from '@/data/siteConfig';
import { makeHref } from '@/lib/nav';

const href = makeHref(import.meta.env.BASE_URL);
const testimonials = siteConfig.testimonials;
---

<section class="section relative overflow-hidden">
  <div class="container-page relative z-10 lg:max-w-6xl">
    <SectionHeader
      align="center"
      eyebrow="Trust"
      heading="Teams choose us for consistency"
      description="Real feedback from local offices—clear communication, reliable results, and checklist-driven scope."
    >
      <a slot="actions" class="btn-secondary w-full sm:w-auto" href={href('about/#proof')}>
        See proof
      </a>
    </SectionHeader>

    <div
      class="testimonials-grid mt-10 grid gap-5 md:grid-cols-3 lg:mt-12 lg:gap-6"
      data-reveal-stagger="90"
    >
      {
        testimonials.map((t, idx) => (
          <figure
            class:list={[
              'card card-hover group relative overflow-hidden p-6 sm:p-7',
              idx === 0 ? 'md:col-span-2' : '',
            ]}
            data-reveal="up"
          >
            {/* Subtle top-left glow */}
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -top-8 -left-8 h-32 w-32 rounded-full bg-[rgb(var(--color-brand)/0.07)] blur-2xl transition-opacity duration-500 group-hover:opacity-150"
            />

            {/* Large decorative quote mark */}
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-4 right-5 font-serif text-7xl leading-none text-[rgb(var(--color-accent-300)/0.18)] select-none"
              style="font-style: italic; line-height: 1;"
            >
              "
            </div>

            <div class="relative">
              <blockquote
                class:list={[
                  'text-sm leading-relaxed lg:text-[0.9375rem] lg:leading-relaxed',
                  idx === 0 ? 'pull-quote' : 'text-muted',
                ]}
              >
                {t.quote}
              </blockquote>

              <figcaption class="mt-5 flex items-center justify-between gap-3 border-t border-[rgb(var(--color-border)/0.4)] pt-4">
                <div class="min-w-0">
                  <p class="text-strong text-sm leading-tight font-semibold">{t.name}</p>
                  <p class="text-subtle mt-0.5 text-xs leading-snug">
                    {t.role && t.company
                      ? `${t.role} · ${t.company}`
                      : (t.role ?? t.company ?? t.location)}
                  </p>
                  {(t.role || t.company) && t.location && (
                    <p class="text-subtle mt-0.5 text-xs opacity-55">{t.location}</p>
                  )}
                </div>
                <span
                  class="inline-flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-[rgb(var(--color-brand)/0.1)] text-xs font-bold text-[rgb(var(--color-brand-700))] ring-1 ring-[rgb(var(--color-brand)/0.18)] transition-colors group-hover:bg-[rgb(var(--color-brand)/0.15)]"
                  aria-label="Verified review"
                  title="Verified"
                >
                  ✓
                </span>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>

    <!-- Marquee strip -->
    <div class="mt-10 overflow-hidden" aria-hidden="true">
      <div class="marquee-track">
        {
          testimonials.concat(testimonials).map((t) => (
            <div class="marquee-item">
              "{t.quote}" — {t.name}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 767px) {
    .testimonials-grid {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(15rem, 80vw);
      overflow-x: auto;
      padding-bottom: 0.75rem;
      margin-inline: -1rem;
      padding-inline: 1rem;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1rem;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .testimonials-grid::-webkit-scrollbar {
      display: none;
    }

    .testimonials-grid::after {
      content: '';
      width: 0.5rem;
      flex-shrink: 0;
    }

    .testimonials-grid > * {
      scroll-snap-align: start;
    }
  }
</style>
