---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/data/siteConfig';
import { makeMailtoHref, makeTelHref } from '@/lib/links';
import { makeHref } from '@/lib/nav';

const base = import.meta.env.BASE_URL;
const contactHref = makeHref(base)('contact/');
const telHref = makeTelHref(siteConfig.contact.phoneE164);
const mailtoHref = makeMailtoHref(siteConfig.contact.email);
---

<div
  id="fab-container"
  class="pointer-events-none fixed bottom-24 right-4 z-30 translate-x-20 opacity-0 transition-all duration-300 md:hidden"
>
  {/* Speed Dial Actions */}
  <div
    id="fab-actions"
    class="pointer-events-none absolute bottom-16 right-0 flex origin-bottom-right scale-75 flex-col gap-3 opacity-0 transition-all duration-300"
  >
    {/* Call Action */}
    <a
      href={telHref}
      data-fab-action="call"
      class="border-app flex touch-manipulation items-center gap-3 whitespace-nowrap rounded-full border bg-surface py-3 pl-4 pr-5 text-sm font-medium shadow-lg transition-all hover:scale-105 hover:shadow-xl active:scale-95"
      aria-label="Call now"
    >
      <Icon name="lucide:phone" class="text-brand h-4 w-4" aria-hidden="true" />
      <span>Call Now</span>
    </a>

    {/* Email Action */}
    <a
      href={mailtoHref}
      data-fab-action="email"
      class="border-app flex touch-manipulation items-center gap-3 whitespace-nowrap rounded-full border bg-surface py-3 pl-4 pr-5 text-sm font-medium shadow-lg transition-all hover:scale-105 hover:shadow-xl active:scale-95"
      aria-label="Email us"
    >
      <Icon name="lucide:mail" class="text-brand h-4 w-4" aria-hidden="true" />
      <span>Email Us</span>
    </a>

    {/* Quote Action */}
    <a
      href={contactHref}
      data-fab-action="quote"
      class="border-app bg-brand flex touch-manipulation items-center gap-3 whitespace-nowrap rounded-full border py-3 pl-4 pr-5 text-sm font-medium text-white shadow-lg transition-all hover:scale-105 hover:shadow-xl active:scale-95"
      aria-label="Get a quote"
    >
      <Icon name="lucide:file-text" class="h-4 w-4" aria-hidden="true" />
      <span>Get a Quote</span>
    </a>
  </div>

  {/* Main Toggle Button */}
  <button
    id="fab-toggle"
    type="button"
    class="bg-brand border-app flex h-14 w-14 items-center justify-center rounded-full border text-white shadow-xl transition-all hover:scale-105 active:scale-95 sm:h-16 sm:w-16"
    aria-label="Contact options"
    aria-expanded="false"
  >
    <div id="fab-icon-default" class="absolute scale-100 opacity-100 transition-all duration-300">
      <Icon name="lucide:message-circle" class="h-6 w-6 sm:h-7 sm:w-7" />
    </div>
    <div id="fab-icon-expanded" class="absolute scale-0 opacity-0 transition-all duration-300">
      <Icon name="lucide:x" class="h-6 w-6 sm:h-7 sm:w-7" />
    </div>
  </button>
</div>

<script>
  const SHOW_THRESHOLD = 100;
  const HIDE_FOOTER_OFFSET = 200;
  const COLLAPSE_TIMEOUT = 3000;

  function initFAB() {
    const container = document.getElementById('fab-container');
    const toggle = document.getElementById('fab-toggle');
    const actions = document.getElementById('fab-actions');
    const iconDefault = document.getElementById('fab-icon-default');
    const iconExpanded = document.getElementById('fab-icon-expanded');
    const actionButtons = document.querySelectorAll('[data-fab-action]');

    if (!container || !toggle || !actions || !iconDefault || !iconExpanded) return;

    let isExpanded = false;
    let collapseTimer: ReturnType<typeof setTimeout> | undefined;

    const setExpanded = (expanded: boolean) => {
      isExpanded = expanded;
      toggle.setAttribute('aria-expanded', String(expanded));

      if (expanded) {
        actions.classList.remove('scale-75', 'opacity-0', 'pointer-events-none');
        actions.classList.add('scale-100', 'opacity-100');
        iconDefault.classList.remove('scale-100', 'opacity-100');
        iconDefault.classList.add('scale-0', 'opacity-0');
        iconExpanded.classList.remove('scale-0', 'opacity-0');
        iconExpanded.classList.add('scale-100', 'opacity-100');

        clearTimeout(collapseTimer);
        collapseTimer = setTimeout(() => setExpanded(false), COLLAPSE_TIMEOUT);
      } else {
        actions.classList.add('scale-75', 'opacity-0', 'pointer-events-none');
        actions.classList.remove('scale-100', 'opacity-100');
        iconDefault.classList.add('scale-100', 'opacity-100');
        iconDefault.classList.remove('scale-0', 'opacity-0');
        iconExpanded.classList.add('scale-0', 'opacity-0');
        iconExpanded.classList.remove('scale-100', 'opacity-100');
        clearTimeout(collapseTimer);
      }
    };

    toggle.addEventListener('click', () => {
      setExpanded(!isExpanded);
      if (window.damraTrack) {
        window.damraTrack('fab_toggle', { action: isExpanded ? 'expand' : 'collapse' });
      }
    });

    actionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = (btn as HTMLElement).dataset.fabAction;
        if (window.damraTrack) {
          window.damraTrack('fab_action', { action });
          // Note: cta_click tracking handled globally or via specific listeners
        }
        setExpanded(false);
      });
    });

    const handleScroll = () => {
      const scrollY = window.scrollY;
      const docHeight = document.body.scrollHeight - window.innerHeight;
      const shouldShow = scrollY > SHOW_THRESHOLD && scrollY < docHeight - HIDE_FOOTER_OFFSET;

      if (shouldShow) {
        container.classList.remove('pointer-events-none', 'translate-x-20', 'opacity-0');
        container.classList.add('translate-x-0', 'opacity-100');
      } else {
        container.classList.add('pointer-events-none', 'translate-x-20', 'opacity-0');
        container.classList.remove('translate-x-0', 'opacity-100');
      }

      if (isExpanded) setExpanded(false);
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  // Initialize on load and on page navigation
  document.addEventListener('astro:page-load', initFAB);
  initFAB();
</script>
