---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
import ContactSection from '@/components/Contact.astro';
import QuoteWizard from '@/components/QuoteWizard.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { siteConfig } from '@/data/siteConfig';
import { makeHref } from '@/lib/nav';
import { makeMailtoHref, makeTelHref } from '@/lib/links';
import { getPublicResponsiveImage } from '@/lib/publicImages';
import { pickGalleryItems } from '@/data/gallery';

const title = `Contact | ${siteConfig.brand.name}`;
const description =
  'Request a quote for cleaning, supplies/restocking, or facilities support. We respond quickly during business hours.';

const href = makeHref(import.meta.env.BASE_URL);
const telHref = makeTelHref(siteConfig.contact.phoneE164);
const mailtoHref = makeMailtoHref(siteConfig.contact.email);
const vcardHref = href('office-provisionz.vcf');

const industryOptions = [...siteConfig.industries.map((i) => i.title), 'Other / Not listed'];

const serviceOptions = [
  'Recurring Janitorial (Nightly/Weekly)',
  'Office Cleaning',
  'Deep / Detail Cleaning',
  'Day Porter / Daytime Upkeep',
  'Supplies & Restocking',
  'Facilities Support',
  'Move-In / Move-Out (Office Turnovers)',
  'Post-Construction Cleanup',
  'Other / Not sure',
];

const heroItems = pickGalleryItems('contact-hero', 2);
const heroPrimary = heroItems[0];
const heroSecondary = heroItems[1] ?? heroPrimary;

const heroImage = heroPrimary
  ? getPublicResponsiveImage(heroPrimary.src, import.meta.env.BASE_URL, {
      sizes: '100vw',
    })
  : { src: '', srcSet: undefined, sizes: '100vw' };

const heroImageMobile = heroSecondary
  ? getPublicResponsiveImage(heroSecondary.src, import.meta.env.BASE_URL, {
      sizes: '100vw',
    })
  : heroImage;
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <PageHero
    title="Contact"
    description="Request a quote or ask a question. We’ll confirm scope + access details and send a clear written quote before service."
    imageSrc={heroPrimary?.src}
    imageSrcMobile={heroSecondary?.src}
    imageAlt={heroPrimary?.alt ?? ''}
    imageSrcSet={heroImage.srcSet}
    imageSizes={heroImage.sizes}
    imageSrcSetMobile={heroImageMobile.srcSet}
    imageSizesMobile={heroImageMobile.sizes}
    imagePosition="50% 40%"
  />

  <QuoteWizard industryOptions={industryOptions} serviceOptions={serviceOptions} />

  <section class="section section-creative hidden scroll-mt-20" id="thanks" data-thanks-panel>
    <div class="container-narrow">
      <div class="card relative overflow-hidden p-6 sm:p-8">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.14)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
        >
        </div>

        <div class="relative">
          <Eyebrow>Request received</Eyebrow>
          <h2 class="heading-2 mt-2">Thanks — we’ve got it.</h2>
          <p class="lede">
            We’ll reply within <span class="text-strong font-semibold">1 business day</span> to confirm
            scope (often via a quick walkthrough) and send clear written pricing.
          </p>

          <div class="mt-6 hidden" data-lead-summary>
            <div class="panel panel-muted p-5">
              <p class="text-strong text-sm font-semibold">Your request summary</p>
              <dl class="mt-3 grid gap-2 text-sm">
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Reference</dt>
                  <dd class="text-strong font-semibold" data-lead-ref></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Company</dt>
                  <dd class="text-strong text-right" data-lead-company></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Location</dt>
                  <dd class="text-strong text-right" data-lead-location></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Industry</dt>
                  <dd class="text-strong text-right" data-lead-industry></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Frequency</dt>
                  <dd class="text-strong text-right" data-lead-frequency></dd>
                </div>
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-muted">Services</dt>
                  <dd class="text-strong text-right" data-lead-services></dd>
                </div>
              </dl>
              <div class="mt-4 flex flex-col gap-2 sm:flex-row">
                <a
                  class="btn-secondary w-full sm:w-auto"
                  href={href('contact/#quote')}
                  data-edit-request
                >
                  Edit details
                </a>
                <button type="button" class="btn-secondary w-full sm:w-auto" data-copy-ref>
                  Copy reference
                </button>
              </div>
            </div>
          </div>

          <div class="mt-8 grid gap-4">
            <div class="panel panel-muted p-5">
              <p class="text-strong text-sm font-semibold">What happens next</p>
              <ol class="mt-2 grid gap-2 text-sm text-muted">
                <li>
                  <span class="text-strong font-semibold">1.</span> We confirm scope + schedule.
                </li>
                <li>
                  <span class="text-strong font-semibold">2.</span> You receive a written quote.
                </li>
                <li>
                  <span class="text-strong font-semibold">3.</span> We start service on schedule.
                </li>
              </ol>
            </div>

            <div class="panel p-5">
              <p class="text-strong text-sm font-semibold">While you wait</p>
              <p class="mt-1 text-sm text-muted">
                Save our contact so it's easy to follow up if needed.
              </p>

              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <a class="btn-secondary w-full" href={vcardHref} data-haptic="true">
                  Save our contact (vCard)
                </a>
              </div>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex flex-col gap-2 sm:flex-row">
                <a class="btn-primary w-full sm:w-auto" href={telHref}>Call now</a>
              </div>

              <div class="flex flex-col gap-2 sm:flex-row">
                <a class="btn-secondary w-full sm:w-auto" href={mailtoHref}>Email us</a>
              </div>
            </div>

            <p class="text-caption">
              If you don’t see our reply soon, check spam/junk and whitelist
              <span class="text-strong"> {siteConfig.contact.email}</span>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-creative scroll-mt-20 pb-0">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <h2 class="heading-2">Tell us your space. We’ll handle the rest.</h2>
          <p class="mt-4 text-lg text-muted">
            We confirm scope, access, and schedule—then send a clear, written quote before any
            service begins.
          </p>

          <div class="card card-hover relative mt-7 overflow-hidden p-6">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(var(--color-accent)/0.14)] via-transparent to-[rgb(var(--color-brand)/0.12)]"
            >
            </div>
            <p class="text-strong text-sm font-semibold">Want to come prepared?</p>
            <p class="mt-2 text-sm text-muted">
              Share your square footage, access window, and priorities—we’ll confirm scope before
              quoting.
            </p>
          </div>

          <div class="mt-8 space-y-6">
            <div class="flex items-start gap-4">
              <div
                class="grid h-10 w-10 flex-none place-items-center rounded-[var(--radius-control)] bg-brand-900 text-white shadow-sm shadow-brand-900/15"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="h-6 w-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-strong text-lg font-semibold">Phone</h3>
                <p class="mt-1 text-muted">
                  <a href={telHref} class="link link-muted">
                    {siteConfig.contact.phoneDisplay}
                  </a>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="grid h-10 w-10 flex-none place-items-center rounded-[var(--radius-control)] bg-brand-900 text-white shadow-sm shadow-brand-900/15"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="h-6 w-6"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-strong text-lg font-semibold">Email</h3>
                <p class="mt-1 text-muted">
                  <a href={mailtoHref} class="link link-muted">
                    {siteConfig.contact.email}
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>

        <ContactSection id="quote" heading="Request a quote" description="" variant="embed" />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  (() => {
    const init = () => {
      const params = new URLSearchParams(window.location.search);
      const showThanks = params.get('thanks') === '1' || params.get('submitted') === '1';
      const panel = document.querySelector('[data-thanks-panel]');
      if (!(panel instanceof HTMLElement)) return;

      if (showThanks) {
        panel.classList.remove('hidden');
      }

      const readLead = () => {
        try {
          const raw = window.sessionStorage?.getItem('damra_last_lead');
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (!parsed || typeof parsed !== 'object') return null;
          return parsed;
        } catch {
          return null;
        }
      };

      const setText = (sel, value) => {
        const el = document.querySelector(sel);
        if (!el) return;
        el.textContent = String(value || '');
      };

      const lead = readLead();
      const summary = panel.querySelector('[data-lead-summary]');
      if (lead && summary instanceof HTMLElement) {
        summary.classList.remove('hidden');
        setText('[data-lead-ref]', lead.ref || '—');
        setText('[data-lead-company]', lead.companyName || '—');
        setText('[data-lead-location]', lead.location || '—');
        setText('[data-lead-industry]', lead.industry || '—');
        setText('[data-lead-frequency]', lead.frequency || '—');

        const services = Array.isArray(lead.servicesNeeded)
          ? lead.servicesNeeded.filter(Boolean).slice(0, 8)
          : [];
        setText('[data-lead-services]', services.length ? services.join(', ') : '—');

        const edit = panel.querySelector('[data-edit-request]');
        if (edit instanceof HTMLAnchorElement) {
          try {
            const p = new URLSearchParams();
            if (lead.industry) p.set('industry', String(lead.industry));
            if (services.length) p.set('services', services.join(','));
            const url = new URL(
              edit.getAttribute('href') || '/contact/#quote',
              window.location.origin
            );
            url.search = p.toString();
            url.hash = 'quote';
            edit.href = url.toString();
          } catch {
            // ignore
          }
        }

        const copy = panel.querySelector('[data-copy-ref]');
        if (copy instanceof HTMLButtonElement) {
          copy.addEventListener('click', async () => {
            const ref = String(lead.ref || '').trim();
            if (!ref) return;
            try {
              await navigator.clipboard?.writeText(ref);
              copy.textContent = 'Copied!';
              window.setTimeout(() => (copy.textContent = 'Copy reference'), 1200);
            } catch {
              // ignore
            }
          });
        }
      }
    };

    const doc = document.documentElement;
    if (doc.dataset.thanksListen !== 'true') {
      doc.dataset.thanksListen = 'true';
      document.addEventListener('astro:page-load', init);
    }
    init();
  })();
</script>
