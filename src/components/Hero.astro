---
import { siteConfig } from '@/data/siteConfig';
import { getImagePositionClass } from '@/lib/utils';

type Props = {
  /** Optional fully-qualified (BASE_URL-prefixed) hero image URL. */
  imageSrc?: string;
  /** Optional srcset string for the hero image (URLs should already include BASE_URL). */
  imageSrcSet?: string | undefined;
  /** Optional sizes attribute when using srcset. */
  imageSizes?: string | undefined;

  /** Optional mobile-only hero image URL (BASE_URL-prefixed). Enables art-direction via <picture>. */
  imageSrcMobile?: string;
  /** Optional mobile-only srcset string (URLs should already include BASE_URL). */
  imageSrcSetMobile?: string | undefined;
  /** Optional mobile-only sizes attribute when using the mobile srcset. */
  imageSizesMobile?: string | undefined;

  /** CSS `object-position` value for the hero image, e.g. "50% 30%". */
  imagePosition?: string;
};

const {
  imageSrc,
  imageSrcSet,
  imageSizes,
  imageSrcMobile,
  imageSrcSetMobile,
  imageSizesMobile,
  imagePosition = '50% 50%',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const heroVideoOptIn =
  String(import.meta.env.PUBLIC_ENABLE_HERO_VIDEO ?? '').toLowerCase() === 'true';
const heroFallback = imageSrc ?? imageSrcMobile ?? '';
const heroImg = imageSrc ?? imageSrcMobile ?? heroFallback;

const imagePositionClass = getImagePositionClass(imagePosition);

const heroVideoWebm = `${base}media/hero-cleaning.webm`;
const heroVideoMp4 = `${base}media/hero-cleaning.mp4`;
---

<section
  class="hero-splash hero-photo hero-split relative w-full overflow-hidden antialiased"
  data-hero-section
>
  {/* Background image layer */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    {
      imageSrcMobile || imageSrcSetMobile ? (
        <picture>
          <source
            media="(max-width: 639px)"
            srcset={imageSrcSetMobile ?? imageSrcMobile}
            sizes={imageSrcSetMobile ? imageSizesMobile : undefined}
          />
          <img
            src={heroImg}
            alt="Office cleaning team sanitizing commercial workspace in San Francisco"
            srcset={imageSrcSet}
            sizes={imageSrcSet ? imageSizes : undefined}
            class:list={['h-full w-full object-cover', imagePositionClass]}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            onerror={`if (this.src !== '${heroFallback}') this.src = '${heroFallback}'`}
          />
        </picture>
      ) : (
        <img
          src={heroImg}
          alt="Office cleaning team sanitizing commercial workspace in San Francisco"
          srcset={imageSrcSet}
          sizes={imageSrcSet ? imageSizes : undefined}
          class:list={['h-full w-full object-cover', imagePositionClass]}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          onerror={`if (this.src !== '${heroFallback}') this.src = '${heroFallback}'`}
        />
      )
    }

    {/* Optional background video */}
    {
      heroVideoOptIn && (
        <video
          class="absolute inset-0 hidden h-full w-full object-cover opacity-[0.12]"
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroImg}
          disablepictureinpicture
          data-hero-video
        >
          <source src={heroVideoWebm} type="video/webm" />
          <source src={heroVideoMp4} type="video/mp4" />
        </video>
      )
    }

    {/* Multi-layer cinematic overlay */}
    {/* 1. Base dark veil for text readability */}
    <div
      class="absolute inset-0"
      style="background: linear-gradient(168deg, rgba(4,6,10,0.62) 0%, rgba(4,6,10,0.38) 45%, rgba(4,6,10,0.18) 75%, rgba(4,6,10,0.08) 100%);"
    >
    </div>
    {/* 2. Bottom fade to keep section transition smooth */}
    <div
      class="absolute inset-x-0 bottom-0 h-48 sm:h-56"
      style="background: linear-gradient(to top, rgba(4,6,10,0.55) 0%, transparent 100%);"
    >
    </div>
    {/* 3. Soft vignette for edge depth */}
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse 90% 80% at 50% 40%, transparent 40%, rgba(2,4,8,0.32) 100%);"
    >
    </div>
    {/* 4. Subtle brand-tinted warmth in lower-left */}
    <div
      class="absolute inset-0 opacity-40"
      style="background: radial-gradient(ellipse 55% 50% at 0% 100%, rgba(82,176,200,0.15) 0%, transparent 70%);"
    >
    </div>
  </div>

  {/* Top gradient for header readability */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 z-10 h-28"
    style="background: linear-gradient(to bottom, rgba(2,4,8,0.35) 0%, transparent 100%);"
  >
  </div>

  {/* Content */}
  <div
    class="container-page relative z-10 pt-24 pb-20 sm:pt-28 sm:pb-24 md:pt-32 md:pb-28 lg:pt-48 lg:pb-40 xl:pt-52 xl:pb-44"
  >
    <div class="hero-split__content mx-auto max-w-4xl text-center lg:max-w-5xl lg:text-left">
      <h1 class="display-hero text-hero-shadow animate-slide-up text-white" data-hero-headline>
        <span class="block">For spaces shaped by</span>
        <span class="block text-white">ambition and expectation.</span>
      </h1>
      <p
        class="text-hero-shadow animate-slide-up mx-auto mt-5 max-w-xl text-base leading-relaxed font-normal text-white/80 [animation-delay:180ms] sm:mt-6 sm:max-w-2xl sm:text-[1.0625rem] md:text-lg lg:mt-8 lg:max-w-2xl lg:text-xl"
        data-hero-subhead
      >
        Local, owner-led cleaning in <span class="font-semibold text-white"
          >{siteConfig.brand.city}</span
        >. Same crew, photo updates, and a real person answering when you call.
      </p>

      {/* Trust pill row */}
      <div
        class="animate-slide-up mt-7 flex flex-wrap items-center justify-center gap-2 [animation-delay:340ms] sm:gap-2.5 lg:justify-start"
        aria-label="Quick facts"
      >
        <div class="hero-stat">
          <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
            class="shrink-0 opacity-75"
          >
            <circle cx="6" cy="6" r="5.25" stroke="currentColor" stroke-opacity="0.5"></circle>
            <path
              d="M3.5 6l1.75 1.75L8.5 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>Owner-operated · SF locals</span>
        </div>

        <div class="hero-stat">
          <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
            class="shrink-0"
          >
            <path
              d="M6 .75L7.32 4.26H11.1L8.04 6.48l1.15 3.54L6 7.8l-3.19 2.22 1.15-3.54-3.06-2.22h3.78L6 .75z"
              fill="currentColor"
              opacity="0.9"></path>
          </svg>
          <span>4.9 avg. rating</span>
        </div>

        <div class="hero-stat">
          <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
            class="shrink-0 opacity-75"
          >
            <circle
              cx="6"
              cy="6"
              r="5"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-opacity="0.55"></circle>
            <path
              d="M6 3.5v2.75l1.75 1"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>Same-day response</span>
        </div>
      </div>
    </div>

    <div class="hero-split__spacer" aria-hidden="true"></div>
  </div>
</section>

<script>
  const initVideo = () => {
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!video) return;

    const shouldEnable = () => {
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (motion.matches) return false;

      const nav = navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      };
      if (nav.connection?.saveData) return false;

      const type = (nav.connection?.effectiveType ?? '').toLowerCase();
      if (type.includes('2g')) return false;

      return true;
    };

    if (shouldEnable()) {
      video.classList.remove('hidden');
      video.play().catch(() => {
        video.classList.add('hidden');
      });

      const onPlay = () => {
        if (window.damraTrack) {
          window.damraTrack('video_play', { video: 'hero' });
        }
        video.removeEventListener('play', onPlay);
      };
      video.addEventListener('play', onPlay);
      video.addEventListener('error', () => {
        video.classList.add('hidden');
      });
    }
  };

  const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));

  const initHeroMotion = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero-section]');
    if (!hero) return;
    if (hero.dataset.heroMotionInit === 'true') return;
    hero.dataset.heroMotionInit = 'true';

    const isWebDriver = (navigator as Navigator & { webdriver?: boolean }).webdriver === true;
    const isTouchLike = (() => {
      try {
        return (
          window.matchMedia('(pointer: coarse)').matches ||
          window.matchMedia('(hover: none)').matches
        );
      } catch {
        return false;
      }
    })();

    const isSaveData = (() => {
      try {
        const nav = navigator as Navigator & { connection?: { saveData?: boolean } };
        return nav.connection?.saveData === true;
      } catch {
        return false;
      }
    })();

    const reduceMotion =
      (window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? false) ||
      isWebDriver ||
      isTouchLike ||
      isSaveData;
    const headline = hero.querySelector<HTMLElement>('[data-hero-headline]');
    const subhead = hero.querySelector<HTMLElement>('[data-hero-subhead]');

    if (reduceMotion || !headline || !subhead) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = hero.getBoundingClientRect();
      const progress = clamp(-rect.top / Math.max(1, rect.height), 0, 1);
      const hY = progress * -16;
      const pY = progress * -10;
      headline.style.transform = `translate3d(0, ${hY}px, 0)`;
      subhead.style.transform = `translate3d(0, ${pY}px, 0)`;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    let listening = false;
    const start = () => {
      if (listening) return;
      listening = true;
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    };
    const stop = () => {
      if (!listening) return;
      listening = false;
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };

    const io = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;
        if (entry.isIntersecting) start();
        else stop();
      },
      { root: null, threshold: 0, rootMargin: '150px 0px 150px 0px' }
    );
    io.observe(hero);

    const cleanup = () => {
      stop();
      try {
        io.disconnect();
      } catch {
        // ignore
      }
    };

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  };

  initVideo();
  initHeroMotion();
  document.addEventListener('astro:page-load', initVideo);
  document.addEventListener('astro:page-load', initHeroMotion);
</script>
