---
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/ui/SectionHeader.astro';

const allServices = await getCollection('services');
const standardServices = allServices
  .filter((s) => s.data.category === 'standard')
  .map((s) => s.data);
---

<section class="section section-creative" id="service-deep-dive">
  <div class="container-page">
    <SectionHeader
      eyebrow="Deep dives"
      heading="Explore what's included"
      description="Expand a service to see the checklist, what's included, and how we schedule it with your building rules."
      align="center"
      class="mx-auto max-w-3xl"
    />

    <div class="mt-10 grid gap-3 lg:mt-14">
      {
        standardServices.map((service, idx) => (
          <details class="card group overflow-hidden" open={idx === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 focus-visible:ring-2 focus-visible:ring-[rgb(var(--color-brand)/0.4)] focus-visible:outline-none focus-visible:ring-inset sm:px-6 sm:py-5">
              <div class="min-w-0">
                <p class="text-strong text-base font-semibold">{service.title}</p>
                <p class="text-muted mt-1 text-sm">{service.description}</p>
              </div>
              <span
                class="inline-flex h-9 w-9 flex-none items-center justify-center rounded-lg border border-[rgb(var(--color-accent)/0.35)] bg-[rgb(var(--color-accent)/0.18)] text-[rgb(var(--color-accent-600))] shadow-sm transition-transform duration-250 group-open:rotate-180"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="h-4 w-4"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="border-t border-[rgb(var(--color-border)/0.45)] bg-[rgb(var(--color-surface-muted)/0.4)] px-5 py-4 sm:px-6 sm:py-5">
              <ul class="check-list check-list--compact text-muted text-sm sm:grid-cols-2">
                {service.bullets.map((bullet) => (
                  <li>
                    <span class="check-icon check-icon--sm" aria-hidden="true">
                      ✓
                    </span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <p class="text-subtle mt-4 text-xs">
                We confirm access windows, security procedures, and building rules before
                scheduling.
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
