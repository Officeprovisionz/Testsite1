---
import { siteConfig } from '@/data/siteConfig';
import { makeHref } from '@/lib/nav';
import { makeMailtoHref, makeTelHref } from '@/lib/links';

const href = makeHref(import.meta.env.BASE_URL);
const telHref = makeTelHref(siteConfig.contact.phoneE164);
const mailtoHref = makeMailtoHref(siteConfig.contact.email);

const base = import.meta.env.BASE_URL;
const logoOrbSrc = `${base}brand/logo-orb.svg`;
---

<footer class="footer-surface">
  <div class="container-page safe-bottom-pad pt-12 pb-16 md:pt-14 md:pb-16 lg:pt-16 lg:pb-20">
    <!-- Top grid -->
    <div class="grid gap-10 md:grid-cols-4 md:gap-8 lg:gap-14">
      <!-- Brand Column -->
      <div class="md:col-span-1">
        <a
          href={href('')}
          class="inline-flex items-center gap-2.5 focus-visible:outline-none"
          aria-label={`${siteConfig.brand.name} home`}
        >
          <img
            src={logoOrbSrc}
            alt=""
            width="26"
            height="26"
            loading="lazy"
            decoding="async"
            class="h-6.5 w-6.5 opacity-90"
          />
          <span class="text-strong text-[0.9375rem] font-bold tracking-[-0.02em]"
            >{siteConfig.brand.name}</span
          >
        </a>

        <p class="text-muted mt-3 max-w-[22ch] text-sm leading-relaxed">
          {siteConfig.brand.tagline}
        </p>

        <div class="mt-5 flex flex-col gap-1.5">
          <a
            class="group text-muted hover:text-strong -mx-2 flex items-center gap-2.5 rounded-lg px-2 py-2 text-sm transition-colors duration-200"
            href={telHref}
            data-track="cta_click"
            data-location="footer"
            data-action="call"
            data-label="footer_call"
          >
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[rgb(var(--color-surface-muted))] text-[rgb(var(--color-brand-600))] transition-colors group-hover:bg-[rgb(var(--color-brand-50))]"
            >
              <svg
                class="h-3.5 w-3.5"
                aria-hidden="true"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </span>
            {siteConfig.contact.phoneDisplay}
          </a>

          <a
            class="group text-muted hover:text-strong -mx-2 flex items-center gap-2.5 rounded-lg px-2 py-2 text-sm transition-colors duration-200"
            href={mailtoHref}
            data-track="cta_click"
            data-location="footer"
            data-action="email"
            data-label="footer_email"
          >
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[rgb(var(--color-surface-muted))] text-[rgb(var(--color-brand-600))] transition-colors group-hover:bg-[rgb(var(--color-brand-50))]"
            >
              <svg
                class="h-3.5 w-3.5"
                aria-hidden="true"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </span>
            {siteConfig.contact.email}
          </a>
        </div>

        <div class="mt-5 flex gap-2">
          <a
            class="btn-primary flex-1 justify-center px-0 text-xs sm:flex-none sm:px-4 sm:text-sm"
            href={telHref}
            data-track="cta_click"
            data-location="footer"
            data-action="call"
          >
            Call now
          </a>
          <a
            class="btn-secondary flex-1 justify-center px-0 text-xs sm:flex-none sm:px-4 sm:text-sm"
            href={mailtoHref}
            data-track="cta_click"
            data-location="footer"
            data-action="email"
          >
            Email us
          </a>
        </div>
      </div>

      <!-- Mobile: collapsible link groups -->
      <div class="md:hidden">
        <div class="grid gap-2">
          {
            [
              {
                label: 'Services',
                links: [
                  { text: 'Overview', href: href('services/') },
                  { text: 'Industries served', href: href('services/#industries') },
                  { text: 'Specialty + add-ons', href: href('services/#specialty') },
                ],
              },
              {
                label: 'Company',
                links: [
                  { text: 'About', href: href('about/') },
                  { text: 'Results', href: href('about/#proof') },
                  { text: 'Contact', href: href('contact/') },
                ],
              },
            ].map((group) => (
              <details class="group rounded-(--radius-card) border border-[rgb(var(--color-border)/0.55)] bg-[rgb(var(--color-surface)/0.7)] p-4 transition-all duration-200 open:border-[rgb(var(--color-border)/0.8)] open:bg-[rgb(var(--color-surface))]">
                <summary class="text-strong flex min-h-10 cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold transition-colors focus-visible:outline-none">
                  {group.label}
                  <svg
                    class="text-subtle h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>
                <nav class="mt-2 grid gap-0.5" aria-label={`Footer ${group.label}`}>
                  {group.links.map((link) => (
                    <a
                      class="tap-target text-muted hover:text-brand -mx-1 rounded-lg px-3 py-2 text-sm transition-colors duration-200"
                      href={link.href}
                    >
                      {link.text}
                    </a>
                  ))}
                </nav>
              </details>
            ))
          }

          <!-- Hours collapsible -->
          <details
            class="group rounded-(--radius-card) border border-[rgb(var(--color-border)/0.55)] bg-[rgb(var(--color-surface)/0.7)] p-4 transition-all duration-200 open:border-[rgb(var(--color-border)/0.8)] open:bg-[rgb(var(--color-surface))]"
          >
            <summary
              class="text-strong flex min-h-10 cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold transition-colors focus-visible:outline-none"
            >
              Hours
              <svg
                class="text-subtle h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </summary>
            <ul class="text-muted mt-2 space-y-1 text-sm">
              {siteConfig.hours.lines.map((h) => <li>{h}</li>)}
            </ul>
            <a
              href="#top"
              class="tap-target text-brand border-brand/20 hover:border-brand/40 mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl border py-2.5 text-sm font-medium transition-colors duration-200"
            >
              <svg
                class="h-3.5 w-3.5"
                aria-hidden="true"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"
                ></path>
              </svg>
              Back to top
            </a>
          </details>
        </div>
      </div>

      <!-- Services Column (desktop) -->
      <nav class="hidden md:block" aria-label="Footer Services">
        <p
          class="mb-4 text-[0.7rem] font-bold tracking-[0.12em] text-[rgb(var(--color-brand-600))] uppercase"
        >
          Services
        </p>
        <ul class="space-y-2.5">
          <li>
            <a
              class="text-muted hover:text-strong text-sm transition-colors duration-200"
              href={href('services/')}>Overview</a>
          </li>
          <li>
            <a
              class="text-muted hover:text-strong text-sm transition-colors duration-200"
              href={href('services/#industries')}>Industries served</a>
          </li>
          <li>
            <a
              class="text-muted hover:text-strong text-sm transition-colors duration-200"
              href={href('services/#specialty')}>Specialty + add-ons</a>
          </li>
        </ul>
      </nav>

      <!-- Company Column (desktop) -->
      <nav class="hidden md:block" aria-label="Footer Company">
        <p
          class="mb-4 text-[0.7rem] font-bold tracking-[0.12em] text-[rgb(var(--color-brand-600))] uppercase"
        >
          Company
        </p>
        <ul class="space-y-2.5">
          <li>
            <a
              class="text-muted hover:text-strong text-sm transition-colors duration-200"
              href={href('about/')}>About</a>
          </li>
          <li>
            <a
              class="text-muted hover:text-strong text-sm transition-colors duration-200"
              href={href('about/#proof')}>Results</a>
          </li>
          <li>
            <a
              class="text-muted hover:text-strong text-sm transition-colors duration-200"
              href={href('contact/')}>Contact</a>
          </li>
        </ul>
      </nav>

      <!-- Hours Column (desktop) -->
      <div class="hidden md:block">
        <p
          class="mb-4 text-[0.7rem] font-bold tracking-[0.12em] text-[rgb(var(--color-brand-600))] uppercase"
        >
          Hours
        </p>
        <ul class="text-muted space-y-1.5 text-sm">
          {siteConfig.hours.lines.map((h) => <li>{h}</li>)}
        </ul>
        <a
          href="#top"
          class="text-brand border-brand/20 hover:border-brand/40 mt-6 inline-flex items-center gap-2 rounded-xl border px-4 py-2 text-sm font-medium transition-colors duration-200"
        >
          <svg
            class="h-3.5 w-3.5"
            aria-hidden="true"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"
            ></path>
          </svg>
          Back to top
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-10 flex flex-col gap-3 border-t border-[rgb(var(--color-border)/0.4)] pt-6 sm:flex-row sm:items-center sm:justify-between sm:gap-4 md:mt-12"
    >
      <p class="text-subtle text-xs">
        © {new Date().getFullYear()}
        {siteConfig.brand.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <p class="text-subtle text-xs">Bay Area · 37.77°N · 122.42°W</p>
        <span class="text-subtle text-xs opacity-40" aria-hidden="true">·</span>
        <p class="text-subtle text-xs">Clear scope. Consistent results.</p>
      </div>
    </div>
  </div>
</footer>
